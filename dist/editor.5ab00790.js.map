    "upgrades.addiction.name": "瘾",
    "upgrades.addiction.tooltip": "不停地打碎砖块，获得更多硬币",
    "upgrades.addiction.verbose_description": "每个打碎的砖块 +{{lvl}} 连击，打碎砖块后 {{delay}} 秒重置连击。仅在每一个关卡打碎第一个砖块后开始倒计时。倒计时在所有砖块摧毁后停止。",
    "upgrades.asceticism.name": "苦修主义",
    "upgrades.asceticism.tooltip": "每个打碎的砖块 +{{combo}} 连击。每个抓到的硬币 -{{loss}} 连击。",
    "upgrades.asceticism.verbose_description": "在你的连击攀升时，你需要存放硬币在某个地方。",
    "upgrades.ball_attract_ball.name": "小组项目",
    "upgrades.ball_attract_ball.tooltip": "球吸引球",
    "upgrades.ball_attract_ball.verbose_description": "距离超过“游戏区域宽度的 3/4”的球会开始相互吸引。\n\n当它们彼此远离时，吸引力会更强。\n\n彩虹粒子会飞起，象征着吸引力。只在你已经拥有一个以上的球时提供这个被动技能。",
    "upgrades.ball_attracts_coins.name": "球吸引硬币",
    "upgrades.ball_attracts_coins.tooltip": "硬币跟随最近的球",
    "upgrades.ball_attracts_coins.verbose_description": "如果把它与“蜕变”和“幽灵硬币”结合，可以用硬币给球周围的砖块染色。它还可以代替硬币磁铁。",
    "upgrades.ball_repulse_ball.name": "个人空间",
    "upgrades.ball_repulse_ball.tooltip": "球排斥球",
    "upgrades.ball_repulse_ball.verbose_description": "距离小于屏幕宽度四分之一的球会开始相互排斥。如果它们彼此靠近，排斥力会更强。粒子会喷射而出，象征着这种力量的作用。只在你已经拥有一个以上的小球时提供这个被动技能。",
    "upgrades.base_combo.name": "坚实的基础",
    "upgrades.base_combo.tooltip": "每一个打碎的砖块多给三个硬币",
    "upgrades.base_combo.verbose_description": "在关卡开始时，你的连击通常从 1 开始，当球四处弹跳没有击中任何东西时，连击数会重置为 1。有了这个被动技能，连击高出 3 点开始，所以总是每个砖块至少得到 4 个硬币。每当你的连击重置，它会回到 4 而不是 1。你的小球会闪烁一点，表示连击数高于一。在等级 2，它添加 4 硬币，然后 5、6……",
    "upgrades.bigger_balls.name": "更大的球",
    "upgrades.bigger_balls.tooltip": "增加球的直径",
    "upgrades.bigger_balls.verbose_description": "这使它更容易抓住砖块。",
    "upgrades.bigger_explosions.name": "轰隆爆炸",
    "upgrades.bigger_explosions.tooltip": "更大的爆炸",
    "upgrades.bigger_explosions.verbose_description": "默认爆炸清除 3x3 的正方形，有了这个被动技能它变成了 5x5 的正方形，吹走硬币也明显更强。每次爆炸后屏幕会闪烁（基本模式除外）",
    "upgrades.bigger_puck.name": "更大的球拍",
    "upgrades.bigger_puck.tooltip": "轻松捕捉更多硬币",
    "upgrades.bigger_puck.verbose_description": "更大的球拍容易不丢失球和抓到更多的硬币，还能精确地调整反弹的角度（球的角度只取决于它击中球拍的位置）。",
    "upgrades.bricks_attract_ball.name": "砖块吸引球",
    "upgrades.bricks_attract_ball.tooltip": "球冲向附近的砖块",
    "upgrades.bricks_attract_ball.verbose_description": "球飞向它会击中的前 {{count}} 个砖块。等级越高，效果越强。效果停止前能击中的砖块的数字也更高。球击中球拍时重新获得效果。",
    "upgrades.bricks_attract_coins.name": "砖块吸引硬币",
    "upgrades.bricks_attract_coins.tooltip": "帮助它们留在那里",
    "upgrades.bricks_attract_coins.verbose_description": "硬币会被附近的砖块吸引。等级越高，吸引力越强。",
    "upgrades.buoy.name": "浮标",
    "upgrades.buoy.tooltip": "硬币在底线上漂浮 {{duration}} 秒。",
    "upgrades.buoy.verbose_description": "在手机模式中，效果最为明显",
    "upgrades.chill.name": "放松",
    "upgrades.chill.tooltip": "没有更多升级，无限制的关卡。",
    "upgrades.chill.verbose_description": "球的加速也会慢得多。",
    "upgrades.clairvoyant.name": "千里眼",
    "upgrades.clairvoyant.tooltip": "看即将到来的关卡、砖块生命值和球的方向",
    "upgrades.clairvoyant.verbose_description": "帮助你挑选正确的升级，了解坚固砖块发生什么事。等级 2 和 3 带来额外的可疑效用的知识（可于无限达到）",
    "upgrades.coin_magnet.name": "硬币磁铁",
    "upgrades.coin_magnet.tooltip": "球拍吸引硬币",
    "upgrades.coin_magnet.verbose_description": "把硬币导向球拍。如果硬币已经靠近球拍，效果更强。",
    "upgrades.compound_interest.name": "复利",
    "upgrades.compound_interest.tooltip": "如果你捕捉所有硬币，获得更多硬币",
    "upgrades.compound_interest.verbose_description": "每次打碎一个砖块，你的连击加一，产生越来越多的硬币。\n确保用球拍捕捉每一枚硬币，丢失硬币会重置连击。\n一旦你的连击超过最低值，游玩区域的底部会有一条红线提醒你，硬币不能掉下去。",
    "upgrades.concave_puck.name": "凹面球拍",
    "upgrades.concave_puck.tooltip": "提高垂直瞄准精度",
    "upgrades.concave_puck.verbose_description": "关卡开始时球直线上升，弹跳角度较小。",
    "upgrades.corner_shot.name": "角落射击",
    "upgrades.corner_shot.tooltip": "让你的球拍与屏幕边界重叠",
    "upgrades.corner_shot.verbose_description": "有助于在角落瞄准。更高的等级让你移动更远。",
    "upgrades.disco_ball.name": "迪斯科球",
    "upgrades.disco_ball.tooltip": "每一次墙壁弹跳更改球的颜色",
    "upgrades.disco_ball.verbose_description": "球的颜色会循环变为彩虹色。",
    "upgrades.double_or_nothing.name": "加倍或归零",
    "upgrades.double_or_nothing.tooltip": "连击爬升两倍之快，但任何连击重置会游戏结束。",
    "upgrades.double_or_nothing.verbose_description": "连击重置仅当连击大于最小值时计算。这个会加倍“更小的球拍”、“透明”、“坚固的砖块”的增益。",
    "upgrades.etherealcoins.name": "太空硬币",
    "upgrades.etherealcoins.tooltip": "硬币不再受重力影响",
    "upgrades.etherealcoins.verbose_description": "硬币会保持它们的速度，即使在几次弹跳之后，并且不再受重力影响。",
    "upgrades.extra_levels.name": "多 5 分钟",
    "upgrades.extra_levels.tooltip": "玩 {{count}} 关卡而不是 7",
    "upgrades.extra_levels.verbose_description": "默认游戏最多可持续 7 个关卡，之后游戏结束。\n\n这个被动技能的每一个等级让你前往一个更高的关卡。最后一关通常是你得分最多的关卡，因此差异可能非常大。",
    "upgrades.extra_life.name": "额外生命",
    "upgrades.extra_life.tooltip": "如果即将失去最后一个球，救你的球",
    "upgrades.extra_life.verbose_description": "生命会在过程中被消耗。额外的生命在球拍后显示为白线。",
    "upgrades.flyswatter.name": "苍蝇拍",
    "upgrades.flyswatter.tooltip": "触碰左边来应用重力到所有球。",
    "upgrades.flyswatter.verbose_description": "",
    "upgrades.forgiving.name": "宽容",
    "upgrades.forgiving.tooltip": "球第一次未命中被忽略。",
    "upgrades.forgiving.verbose_description": "忽略一次未命中，符合标准时你仍有资格获得金牌。",
    "upgrades.fountain_toss.name": "喷泉投掷",
    "upgrades.fountain_toss.tooltip": "当你错过硬币时获得连击。",
    "upgrades.fountain_toss.verbose_description": "当你错过一枚硬币且你的连击低于关卡*30 时，你的连击有关卡/连击的概率加一。",
    "upgrades.fumes.name": "烟雾",
    "upgrades.fumes.tooltip": "一个砖块打碎时，它上方所有砖块得到它的颜色。",
    "upgrades.fumes.verbose_description": "染色会跨越空隙。",
    "upgrades.ghost_coins.name": "幽灵硬币",
    "upgrades.ghost_coins.tooltip": "硬币慢慢穿过砖块",
    "upgrades.ghost_coins.verbose_description": "这不是一个错误，是一个功能！硬币穿过砖块的速度很慢。等级越高，速度越快。",
    "upgrades.golden_goose.name": "金鹅",
    "upgrades.golden_goose.tooltip": "击中砖块后，硬币会传送到球上",
    "upgrades.golden_goose.verbose_description": "每当一个硬币击中一个砖块，传送那个硬币到最近的球。在等级二，硬币击中一条边后也会传送。",
    "upgrades.gravity_falls.name": "重力球",
    "upgrades.gravity_falls.tooltip": "触碰顶部的球获得重力",
    "upgrades.gravity_falls.verbose_description": "",
    "upgrades.happy_family.name": "幸福家庭",
    "upgrades.happy_family.tooltip": "在游戏中保留所有球，获得更多硬币。",
    "upgrades.happy_family.verbose_description": "每一次球拍弹跳，每一个额外的球 +1 连击。失去球时重置连击。仅多于一的球给连击。",
    "upgrades.hardhat.name": "硬帽子",
    "upgrades.hardhat.tooltip": "砖块更难从顶部打碎",
    "upgrades.hardhat.verbose_description": "球击中砖块顶部时造成一半伤害",
    "upgrades.helium.name": "氦气",
    "upgrades.helium.tooltip": "球拍左右两边重力受限",
    "upgrades.helium.verbose_description": "等级 1，减小重力。等级 2，硬币慢慢飘起。等级 3，硬币飞行。",
    "upgrades.hot_start.name": "热启动",
    "upgrades.hot_start.tooltip": "30 秒内清理关卡，获得更多硬币",
    "upgrades.hot_start.verbose_description": "在每个关卡的开始，你的连击会从 +{{start}} 点开始，但之后每秒会减少 {{loss}}。此效果可与其他被动技能叠加。",
    "upgrades.implosions.name": "内爆",
    "upgrades.implosions.tooltip": "爆炸吸入硬币而不是吹走它们",
    "upgrades.implosions.verbose_description": "爆炸力以其他方式施加。更高等级如同“更大的爆炸”",
    "upgrades.instant_explosion.name": "瞬间爆炸",
    "upgrades.instant_explosion.tooltip": "爆炸立即打碎附近的砖块和炸弹",
    "upgrades.instant_explosion.verbose_description": "如果你依赖爆炸打碎砖块，在它们重置连击之前，这会有帮助。",
    "upgrades.left_is_lava.name": "避免左侧",
    "upgrades.left_is_lava.tooltip": "不触碰左侧，获得更多硬币",
    "upgrades.left_is_lava.verbose_description": "每当你打碎一个砖块，你的连击会加一，这样你会从下一个打碎的砖块获得更多硬币。\n\n然而，你的球击中左侧，连击会重置。\n\n连击提升时，左侧变红以提醒你应该避免击中它们。\n\n在等级 2，边界完全移除，你可能失去球和硬币。\n\n这个升级影响球的开始方向。",
    "upgrades.limitless.name": "无限",
    "upgrades.limitless.tooltip": "把所有升级的最高等级提高 {{lvl}}",
    "upgrades.limitless.verbose_description": "选择这个被动技能也提高它自己的限制，让你再次挑选它。",
    "upgrades.metamorphosis.name": "变形",
    "upgrades.metamorphosis.tooltip": "每枚硬币可以用它的颜色给 {{lvl}} 个砖块染色",
    "upgrades.metamorphosis.verbose_description": "硬币的颜色会变成它们所来自的砖块的颜色，并会给它们接触到的第一个砖块染上相同的颜色。硬币生成时的速度（方向）与打碎它们的球的速度（方向）相同，这意味着你可以稍微瞄准你想要“染色 ”的砖块的方向。在等级一，每个硬币可以染色一个砖块，然后硬币变为空心。",
    "upgrades.minefield.name": "雷区",
    "upgrades.minefield.tooltip": "屏幕上每个炸弹砖 +{{percent}}% 硬币",
    "upgrades.minefield.verbose_description": "炸弹在它们爆炸时也会计数。",
    "upgrades.multiball.name": "多个球",
    "upgrades.multiball.tooltip": "每个关卡开始时有 {{count}} 个球。",
    "upgrades.multiball.verbose_description": "在 Breakout 71 中，你掉了球就输了。\n\n有了这个被动技能，你得到两个球，因此你可以承受失去一个球。\n\n失去的球在下一关卡回来。\n\n拥有一个以上的球使更多被动技能可用，当然清理关卡更快。",
    "upgrades.nbricks.name": "婴儿步",
    "upgrades.nbricks.tooltip": "缓慢地清理关卡，获得更多硬币。",
    "upgrades.nbricks.verbose_description": "每个打碎的砖块 +{{gain}} 连击。如果在两个球拍或墙壁弹跳之间，球打碎超过 {{max}} 个砖块，连击重置。小心点，爆炸也算数。",
    "upgrades.one_more_choice.name": "额外选择",
    "upgrades.one_more_choice.tooltip": "更多升级选择",
    "upgrades.one_more_choice.verbose_description": "每个升级菜单会多一个选项。不增加你可以挑选升级的次数。",
    "upgrades.ottawa_treaty.name": "渥太华条约",
    "upgrades.ottawa_treaty.tooltip": "打碎一个炸弹附近的砖块会拆除炸弹",
    "upgrades.ottawa_treaty.verbose_description": "附近的炸弹会被替换为一个有色的砖块。如果你有工兵，球会失去工兵效果，直到下次弹跳。一次只能替换一个炸弹。",
    "upgrades.paddle_up_combo.name": "气场",
    "upgrades.paddle_up_combo.tooltip": "在球拍之上打碎砖块，每个砖 +1，否则重置",
    "upgrades.paddle_up_combo.verbose_description": "",
    "upgrades.palette.name": "调色板",
    "upgrades.palette.tooltip": "屏幕上的每一个其他砖块颜色 +1 连击，如果只有一个颜色，连击重置",
    "upgrades.palette.verbose_description": "小心，某些关卡只有一种颜色。第一个和最后一个砖块击中不算数。",
    "upgrades.passive_income.name": "被动收入",
    "upgrades.passive_income.tooltip": "更多硬币，但移动球拍抓不到硬币。",
    "upgrades.passive_income.verbose_description": "每一个打碎的砖块 +{{lvl}} 连击，球拍移动后 {{time}} 秒是非物质的。某些被动技能可以帮助球做你想做的事，无需做任何事情。\n\n在等级1，硬币会穿透球拍，并且在等级2+，球也会穿透非物质球拍。",
    "upgrades.picky_eater.name": "挑食者",
    "upgrades.picky_eater.tooltip": "逐个清理颜色，获得更多硬币",
    "upgrades.picky_eater.verbose_description": "每当你击碎一个与球的颜色相同的砖块，你的连击增加颜色之数减一的差。\n如果是不同颜色，球会变成那个新颜色，但连击会重置，除非没有剩余与球颜色相同的砖块。\n一旦你的连击高于最低值，错误颜色的砖块会有红色边框。\n如果你有多个球，每当其中一个球击中砖块，它们都会切换颜色。",
    "upgrades.pierce.name": "穿刺",
    "upgrades.pierce.tooltip": "球在一次球拍弹跳后穿刺 {{count}} 个砖块",
    "upgrades.pierce.verbose_description": "球通常碰到某个东西就会弹跳。有了这个被动技能，它会继续它的弹道来打碎多达 3 个砖块。\n\n之后，它会在第 4 个砖块上弹跳，球需要触碰球拍来重置计数器。",
    "upgrades.pierce_above_paddle.name": "机会窗口",
    "upgrades.pierce_above_paddle.tooltip": "当砖块在球拍之上时更容易打碎它们。",
    "upgrades.pierce_above_paddle.verbose_description": "",
    "upgrades.pierce_color.name": "颜色穿刺",
    "upgrades.pierce_color.tooltip": "球穿透相同颜色的砖块",
    "upgrades.pierce_color.verbose_description": "球穿透相同颜色的砖块，畅通无阻直到它的“充能”筋疲力尽。然后它需要在球拍在上弹跳来重新充能。",
    "upgrades.pierce_left.name": "穿刺左边",
    "upgrades.pierce_left.tooltip": "从左边击中时更容易打碎砖块",
    "upgrades.pierce_left.verbose_description": "这个升级影响球的开始方向。触发效果时，球会加速。",
    "upgrades.pierce_right.name": "穿刺右边",
    "upgrades.pierce_right.tooltip": "从右边击中时更容易打碎砖块",
    "upgrades.pierce_right.verbose_description": "这个升级影响球的开始方向。触发效果时，球会加速。",
    "upgrades.pierce_top.name": "穿刺顶部",
    "upgrades.pierce_top.tooltip": "从顶部击中时更容易打碎砖块",
    "upgrades.pierce_top.verbose_description": "触发效果时，球会加速。",
    "upgrades.puck_repulse_ball.name": "软着陆",
    "upgrades.puck_repulse_ball.tooltip": "球拍排斥球",
    "upgrades.puck_repulse_ball.verbose_description": "当球靠近球拍时，球会开始减慢速度，甚至可能在不接触球拍的情况下弹跳。",
    "upgrades.rainbow.name": "彩虹",
    "upgrades.rainbow.tooltip": "硬币以彩虹色生成。",
    "upgrades.rainbow.verbose_description": "每个等级增加有色硬币的比例。颜色取决于时间。",
    "upgrades.reach.name": "自上而下",
    "upgrades.reach.tooltip": "避开最低一行的砖块，获得更多硬币",
    "upgrades.reach.verbose_description": "触碰最低一行的 N 个砖块重置连击，否则 +N 连击。\n\n如果只有一行砖块，或者最低一行砖块覆盖了游戏的整个宽度，那么这个被动技能不起作用。否则，打碎最低一行砖块重置连击，打碎其他任何东西增加连击的数值为最低一行砖块的数量。\n\n最低一行会以红色高亮。",
    "upgrades.refill.name": "重新充满",
    "upgrades.refill.tooltip": "击中任何一边，或者传送球，重置球的穿刺计数器",
    "upgrades.refill.verbose_description": "也给 +1 穿刺。",
    "upgrades.respawn.name": "重生",
    "upgrades.respawn.tooltip": "{{percent}}% 的砖块在 {{delay}} 秒后重新生成。",
    "upgrades.respawn.verbose_description": "一些粒子效果会让你知道砖块会出现在哪里。",
    "upgrades.right_is_lava.name": "避免右侧",
    "upgrades.right_is_lava.tooltip": "不触碰右侧，获得更多硬币",
    "upgrades.right_is_lava.verbose_description": "每当你打碎一个砖块，你的连击会加一，这样你会从下一个打碎的砖块获得更多硬币。\n\n然而，你的球击中右侧，连击会重置。\n\n连击提升时，右侧变红以提醒你应该避免击中它们。\n\n在等级 2，边界完全移除，你可能失去球和硬币。\n\n这个升级影响球的开始方向。",
    "upgrades.round_bricks.name": "圆砖",
    "upgrades.round_bricks.tooltip": "现在砖是圆的",
    "upgrades.round_bricks.verbose_description": "",
    "upgrades.sacrifice.name": "牺牲",
    "upgrades.sacrifice.tooltip": "失去生命，增加 {{gain}} 连击。",
    "upgrades.sacrifice.verbose_description": "",
    "upgrades.sapper.name": "工兵",
    "upgrades.sapper.tooltip": "第一个打碎的砖块变成炸弹。",
    "upgrades.sapper.verbose_description": "打碎的第一个砖块会被替换为炸弹砖块，而不是仅仅消失而已。球在球拍上弹跳重新获得效果。提升被动技能等级会允许你放置更多的炸弹。",
    "upgrades.shocks.name": "冲击",
    "upgrades.shocks.tooltip": "球爆炸性碰撞",
    "upgrades.shocks.verbose_description": "每当两个球相撞，它们交换它们的速度，产生爆炸，并获得添加的速度以分开它们。",
    "upgrades.shunt.name": "分流",
    "upgrades.shunt.tooltip": "在关卡之间保留 {{percent}}% 的连击",
    "upgrades.shunt.verbose_description": "如果你也有热启动，热启动添加到当前连击",
    "upgrades.side_flip.name": "右撇子",
    "upgrades.side_flip.tooltip": "每个打碎的砖块 +1 连击。如果你从左边打碎砖块，连击重置。",
    "upgrades.side_flip.verbose_description": "没打碎砖块的爆炸和弹跳不算作触发连击重置。这个升级影响球的开始方向。",
    "upgrades.side_kick.name": "左撇子",
    "upgrades.side_kick.tooltip": "每个打碎的砖块 +1 连击。如果你从右边打碎砖块，连击重置。",
    "upgrades.side_kick.verbose_description": "没打碎砖块的爆炸和弹跳不算作触发连击重置。这个升级影响球的开始方向。",
    "upgrades.skip_last.name": "轻松清理",
    "upgrades.skip_last.tooltip": "最后一个砖块会自我毁灭",
    "upgrades.skip_last.verbose_description": "你需要打碎所有砖块才能进入下一关。不过，很难打掉最后一块砖。\n这个被动技能的每一个等级增加自我毁灭的砖块的数量。\n早一些清理一个关卡在升级时带来额外的选择。绝不未命中砖块也非常有益。\n\n因此，如果你觉得很难打碎最后的砖，多选几次这个被动技能会有帮助。",
    "upgrades.slow_down.name": "慢球",
    "upgrades.slow_down.tooltip": "球移动更慢",
    "upgrades.slow_down.verbose_description": "游戏开始时球的速度相对较慢，每一个关卡，球会快一点。\n\n如果你在一个关卡中花费大量时间，球也会加速。\n\n这个被动技能使球更加可控。\n\n你可以在菜单中启用儿童模式，每一次新游戏获得这个被动技能。",
    "upgrades.smaller_puck.name": "更小的球拍",
    "upgrades.smaller_puck.tooltip": "{{percent}}% 更快的连击上升",
    "upgrades.smaller_puck.verbose_description": "这使球拍更小，理论上使角落射击更容易，但实际上只是提高难度。\n\n这就是为什么你还能获得硬币生成 +50% 的奖励。",
    "upgrades.soft_brush.name": "软刷",
    "upgrades.soft_brush.tooltip": "当球击中不同颜色的砖块，球给砖染色而不是打碎它。",
    "upgrades.soft_brush.verbose_description": "如果爆炸摧毁砖块，它不做任何事。被动技能的每个等级，每次弹跳，效果只发生一次。",
    "upgrades.soft_reset.name": "软重置",
    "upgrades.soft_reset.tooltip": "连击重置时保留它的 {{percent}}%",
    "upgrades.soft_reset.verbose_description": "限制连击重置的影响。",
    "upgrades.soft_touch.name": "软触碰",
    "upgrades.soft_touch.tooltip": "球不在球拍之上时无害地在砖块上弹跳。",
    "upgrades.soft_touch.verbose_description": "",
    "upgrades.steering.name": "转向",
    "upgrades.steering.tooltip": "球拍移动时球转弯",
    "upgrades.steering.verbose_description": "球拍位置的改变直接影响球运动的方向。在等级2+，球有一条显示方向的线。",
    "upgrades.sticky_coins.name": "黏性硬币",
    "upgrades.sticky_coins.tooltip": "硬币黏在相同颜色的砖块",
    "upgrades.sticky_coins.verbose_description": "在等级2，它们黏在任何颜色的砖块",
    "upgrades.streak_shots.name": "击中一连串",
    "upgrades.streak_shots.tooltip": "一次打碎很多砖块，获得更多硬币",
    "upgrades.streak_shots.verbose_description": "每次打碎一个砖块，连击加一。\n\n然而，球碰到球拍，连击就会重置。\n\n一旦你的连击超过基础值，球拍会有红色边框提醒你，球触碰球拍会破坏你的连击。",
    "upgrades.sturdy_bricks.name": "坚固的砖块",
    "upgrades.sturdy_bricks.tooltip": "+{{lvl}} 砖块生命值，{{percent}}% 更快的连击上升",
    "upgrades.sturdy_bricks.verbose_description": "这个被动技能的每个等级给所有砖块加一生命值。你可以用“千里眼”被动技能看生命值。获得“穿刺”被动技能可以增加球的伤害。这个被动技能的每一个等级使连击上升 50%。",
    "upgrades.superhot.name": "SUPER HOT",
    "upgrades.superhot.tooltip": "当球拍移动时时间流动。",
    "upgrades.superhot.verbose_description": "SUPER HOT SUPER HOT SUPER HOT SUPER HOT",
    "upgrades.telekinesis.name": "意念操控",
    "upgrades.telekinesis.tooltip": "球拍位置影响球",
    "upgrades.telekinesis.verbose_description": "当球上升时你可以控制它。球在屏幕下半部分时效果更强。",
    "upgrades.thomas.name": "使徒托马斯",
    "upgrades.thomas.tooltip": "失去一个球时复活一半的砖。",
    "upgrades.thomas.verbose_description": "",
    "upgrades.three_cushion.name": "三边克朗球",
    "upgrades.three_cushion.tooltip": "间接击中砖块，获得更多硬币",
    "upgrades.three_cushion.verbose_description": "在击中砖块前，球在每个砖块侧面每次弹跳 +1 连击。每个砖块限制为 +{{max}} 连击。如果你不先在侧面弹跳就打碎砖块，连击重置。",
    "upgrades.top_is_lava.name": "天空是限制",
    "upgrades.top_is_lava.tooltip": "避免击中顶部，获得更多硬币",
    "upgrades.top_is_lava.verbose_description": "每当你打碎一个砖块，连击加一。然而，球击中屏幕顶部，连击重置。\n\n你的连击超过最低值时，顶部会出现一个红条提醒你应该避免击中它。\n\n在等级 2，边界完全移除，你可能失去球和硬币。",
    "upgrades.trampoline.name": "蹦床",
    "upgrades.trampoline.tooltip": "仅在砖块和球拍上弹跳，获得更多硬币",
    "upgrades.trampoline.verbose_description": "每次球拍弹跳 +{{lvl}} 连击，每次在边界上弹跳 -{{lvl}} 连击。少有的不添加重置条件的一个连击升级",
    "upgrades.transparency.name": "透明度",
    "upgrades.transparency.tooltip": "球在屏幕顶部是不可见的。{{percent}}% 更快的连击上升",
    "upgrades.transparency.verbose_description": "球在屏幕顶部变透明。\n+{{percent}} % 硬币。\n更高的等级使球更快透明，并且增加奖励。",
    "upgrades.trickledown.name": "涓滴效应",
    "upgrades.trickledown.tooltip": "硬币出现在屏幕顶部。",
    "upgrades.trickledown.verbose_description": "如果顶部有一行砖块，硬币可能停在上面，在这种情况，打碎砖块后硬币会掉下来。",
    "upgrades.unbounded.name": "填充",
    "upgrades.unbounded.tooltip": "在关卡的左右两边添加空间，但你的球拍不能去那么远。",
    "upgrades.unbounded.verbose_description": "另一个升级可能帮助你延伸球拍的触及范围。",
    "upgrades.varied_diet.name": "多样化饮食",
    "upgrades.varied_diet.tooltip": "如果砖块的颜色不同于球，每个打碎的砖块 + {{plus}} 连击，否则 - {{minus}}",
    "upgrades.varied_diet.verbose_description": "这个被动技能不添加重置条件。",
    "upgrades.vibrant_neighborhood.name": "充满活力的社区",
    "upgrades.vibrant_neighborhood.tooltip": "当砖块靠近不同颜色的砖块时，获得更多金币。",
    "upgrades.vibrant_neighborhood.verbose_description": "砖块碎掉时，连击爬升的数量是碎掉的砖块周围 3x3 格子内、与碎掉的砖块的颜色不同的砖块的总数。如果附近只有相同颜色的砖块，并且关卡有多于一种颜色，连击重置。没有邻居的砖块碎掉时不影响连击。",
    "upgrades.viscosity.name": "粘度",
    "upgrades.viscosity.tooltip": "硬币下落速度减慢",
    "upgrades.viscosity.verbose_description": "硬币通常因重力和爆炸加速到很高的速度。\n\n这个被动技能使硬币不停地减速，如同它们在某种粘性液体中。\n\n这使捕捉硬币更容易，并与影响硬币移动的被动技能结合得很好。",
    "upgrades.wind.name": "风",
    "upgrades.wind.tooltip": "球拍的位置产生风",
    "upgrades.wind.verbose_description": "风取决于球拍位置：左边向左吹，右边向右吹。影响球和硬币。",
    "upgrades.wrap_left.name": "裹左边",
    "upgrades.wrap_left.tooltip": "击中左边传送球到右边",
    "upgrades.wrap_left.verbose_description": "更高等级也传送硬币。",
    "upgrades.wrap_right.name": "裹右边",
    "upgrades.wrap_right.tooltip": "击中右边传送球到左边",
    "upgrades.wrap_right.verbose_description": "更高等级也传送硬币。",
    "upgrades.wrap_up.name": "裹上边",
    "upgrades.wrap_up.tooltip": "触碰屏幕的顶部会传送球到球拍之上。",
    "upgrades.wrap_up.verbose_description": "这不算作击中球拍。在等级 2，也传送硬币。",
    "upgrades.yoyo.name": "溜溜球",
    "upgrades.yoyo.tooltip": "球落向球拍",
    "upgrades.yoyo.verbose_description": "这是意念操控的反面，在球掉下来时控制它。当球在屏幕顶部并且远离球拍的水平轴时，这个效果更强。",
    "upgrades.zen.name": "禅",
    "upgrades.zen.tooltip": "不触发炸弹，获得更多硬币",
    "upgrades.zen.verbose_description": "每三秒 +{{lvl}} 连击，爆炸时重置连击"
}
