    "upgrades.pierce_right.tooltip": "",
    "upgrades.pierce_right.verbose_description": "",
    "upgrades.pierce_top.name": "",
    "upgrades.pierce_top.tooltip": "",
    "upgrades.pierce_top.verbose_description": "",
    "upgrades.puck_repulse_ball.name": "軟著陸",
    "upgrades.puck_repulse_ball.tooltip": "槳板排斥球",
    "upgrades.puck_repulse_ball.verbose_description": "當球靠近槳板時，它會開始減速，甚至可能在不碰到槳板的情況下彈起。",
    "upgrades.rainbow.name": "彩虹",
    "upgrades.rainbow.tooltip": "硬幣呈現彩虹色。",
    "upgrades.rainbow.verbose_description": "每個關卡都會增加彩色硬幣的比例。顏色取決於關卡時間。",
    "upgrades.reach.name": "自上而下",
    "upgrades.reach.tooltip": "如果你避開最下面一排的磚塊，將獲得更多硬幣",
    "upgrades.reach.verbose_description": "碰到最底排的 N 塊磚塊會重置連擊數。否則，+N 連擊。\n\n如果只有一排磚塊，或最底排的磚塊覆蓋了整個遊戲寬度，則此技能無效。否則，擊破最底排的磚塊會重置連擊數，而擊破其他任何磚塊都會使連擊數增加，增加的連擊數等於最底排的磚塊數量。\n\n最底排的磚塊會以紅色突出顯示。",
    "upgrades.refill.name": "",
    "upgrades.refill.tooltip": "",
    "upgrades.refill.verbose_description": "",
    "upgrades.respawn.name": "重生",
    "upgrades.respawn.tooltip": "{{percent}}% 的磚塊在 {{delay}} 秒後重新產生。",
    "upgrades.respawn.verbose_description": "一些粒子效果會讓你知道磚塊會出現在哪裡。",
    "upgrades.right_is_lava.name": "避免右側",
    "upgrades.right_is_lava.tooltip": "如果你不觸碰右側，將獲得更多硬幣",
    "upgrades.right_is_lava.verbose_description": "每當你擊破一塊磚塊，你的連擊數就會增加一，之後每擊破一塊磚塊，你就能多獲得一枚硬幣。\n\n但是，一旦你的球擊中右側邊緣，連擊數就會重置。\n\n隨著連擊數的增加，右側邊緣會變成紅色，提醒你避免擊中它們。\n\n在等級 2，邊框會完全消失，你的球和硬幣可能會遺失。",
    "upgrades.round_bricks.name": "圓磚",
    "upgrades.round_bricks.tooltip": "磚磈變成圓的",
    "upgrades.round_bricks.verbose_description": "",
    "upgrades.sacrifice.name": "犧牲",
    "upgrades.sacrifice.tooltip": "",
    "upgrades.sacrifice.verbose_description": "",
    "upgrades.sapper.name": "工兵",
    "upgrades.sapper.tooltip": "第一塊擊破的磚塊變成炸彈。",
    "upgrades.sapper.verbose_description": "你擊破的第一塊磚塊不會直接消失，而是會被替換成一塊炸彈磚塊。將球彈到槳板上即可重新啟動此效果。升級此技能後，你可以放置更多炸彈。",
    "upgrades.shocks.name": "衝擊",
    "upgrades.shocks.tooltip": "球爆炸性碰撞",
    "upgrades.shocks.verbose_description": "每當兩球相撞時，它們就會交換速度，產生爆炸，並且獲得額外的速度以將它們分開。",
    "upgrades.shunt.name": "分流",
    "upgrades.shunt.tooltip": "在關卡之間保持 {{percent}}% 的連擊",
    "upgrades.shunt.verbose_description": "如果你還有熱啟動，熱啟動就會加入至目前連擊中",
    "upgrades.side_flip.name": "右撇子",
    "upgrades.side_flip.tooltip": "",
    "upgrades.side_flip.verbose_description": "",
    "upgrades.side_kick.name": "左撇子",
    "upgrades.side_kick.tooltip": "",
    "upgrades.side_kick.verbose_description": "",
    "upgrades.skip_last.name": "輕鬆清理",
    "upgrades.skip_last.tooltip": "最後一塊磚塊將會自毀",
    "upgrades.skip_last.verbose_description": "你需要擊破所有磚塊才能進入下一關。然而，擊破最後幾塊磚塊可能並不容易。\n此技能每提升一級，自爆磚塊的數量就會增加。\n提前通關可以帶來更多升級選擇。從不錯過任何一塊磚塊也大有裨益。\n\n因此，如果你覺得擊破最後幾塊磚塊很困難，不妨多獲得幾次此技能以獲得幫助。",
    "upgrades.slow_down.name": "慢速球",
    "upgrades.slow_down.tooltip": "球移動得更慢",
    "upgrades.slow_down.verbose_description": "遊戲開始時，球的速度相對較慢，但是隨著遊戲進程的推進，球的速度會逐漸加快。\n\n如果在一個關卡停留的時間太長，球的速度也會進逐漸加快。\n\n此技能讓遊戲更容易上手。\n\n你可以在選單中啟用兒童模式，每次遊戲開始時都會獲得此技能。",
    "upgrades.smaller_puck.name": "小型槳板",
    "upgrades.smaller_puck.tooltip": "{{percent}}% 更多硬幣",
    "upgrades.smaller_puck.verbose_description": "這會使槳板變小，理論上會讓一些角落擊球更容易，但是實際上只會增加難度。\n\n所以你還能獲得硬幣產生率提升 50% 的額外獎勵。",
    "upgrades.soft_brush.name": "",
    "upgrades.soft_brush.tooltip": "",
    "upgrades.soft_brush.verbose_description": "",
    "upgrades.soft_reset.name": "軟重置",
    "upgrades.soft_reset.tooltip": "連擊重置時保留 {{percent}}%",
    "upgrades.soft_reset.verbose_description": "限制連擊重置的影響。",
    "upgrades.soft_touch.name": "",
    "upgrades.soft_touch.tooltip": "",
    "upgrades.soft_touch.verbose_description": "",
    "upgrades.steering.name": "轉向",
    "upgrades.steering.tooltip": "槳板移動時球也會轉向",
    "upgrades.steering.verbose_description": "槳板位置的改變會直接影響球的移動方向。在第 2 級或以上，螢幕上會出現一條線顯示球的移動方向。",
    "upgrades.sticky_coins.name": "黏性硬幣",
    "upgrades.sticky_coins.tooltip": "硬幣黏在相同顏色的磚塊上",
    "upgrades.sticky_coins.verbose_description": "在等級 2，它們會黏在任何顏色的磚塊",
    "upgrades.streak_shots.name": "連續擊中",
    "upgrades.streak_shots.tooltip": "如果你一次擊破很多磚塊，將獲得更多硬幣",
    "upgrades.streak_shots.verbose_description": "每次擊破磚塊，連擊數都會增加 1。\n\n但是，一旦球碰到槳板，連擊數就會重置為預設值。\n\n當連擊數超過基礎值時，槳板會出現紅色邊框，提醒你球碰到槳板會重置連擊數。",
    "upgrades.sturdy_bricks.name": "堅固的磚塊",
    "upgrades.sturdy_bricks.tooltip": "+{{lvl}} 磚塊生命值，+{{percent}}% 硬幣",
    "upgrades.sturdy_bricks.verbose_description": "此技能每提升一級都會為所有磚塊增加 1 點生命值。你可以使用「透視」技能來查看磚塊生命值。 「穿透」技能可以提升球的傷害。此技能每提升一級也會增加 50% 的硬幣產生量。",
    "upgrades.superhot.name": "超級熱",
    "upgrades.superhot.tooltip": "當槳板移動時時間才會流動。",
    "upgrades.superhot.verbose_description": "超級熱 超級熱 超級熱 超級熱",
    "upgrades.telekinesis.name": "念力",
    "upgrades.telekinesis.tooltip": "槳板的位置會影響球",
    "upgrades.telekinesis.verbose_description": "在球上升的過程中，你可以控制它。當球位於螢幕下半部時，效果更明顯。",
    "upgrades.thomas.name": "",
    "upgrades.thomas.tooltip": "",
    "upgrades.thomas.verbose_description": "",
    "upgrades.three_cushion.name": "三邊不要碰",
    "upgrades.three_cushion.tooltip": "如果你只是間接地擊中磚塊，將獲得更多硬幣",
    "upgrades.three_cushion.verbose_description": "",
    "upgrades.top_is_lava.name": "天空是限制",
    "upgrades.top_is_lava.tooltip": "如果你避免擊中頂部，將獲得更多硬幣",
    "upgrades.top_is_lava.verbose_description": "每次擊破磚塊，連擊數都會增加 1。但是，一旦球碰到螢幕頂部，連擊數就會重置。\n\n當連擊數超過最低值時，螢幕頂部會出現一個紅色條，提醒你避免碰到它。\n\n在第 2 級，邊框會完全消失，你的球和硬幣可能會丟失。",
    "upgrades.trampoline.name": "彈跳床",
    "upgrades.trampoline.tooltip": "如果你只在磚塊和槳板上彈跳，將獲得更多硬幣",
    "upgrades.trampoline.verbose_description": "每次彈跳球拍 +{{lvl}} 連擊，每次彈跳任意邊界球拍 -{{lvl}} 連擊。罕見的連擊升級之一，無需重置條件",
    "upgrades.transparency.name": "透明度",
    "upgrades.transparency.tooltip": "+50% 硬幣。球在螢幕上方是隱形的。",
    "upgrades.transparency.verbose_description": "螢幕頂部的球會變得透明。\n+{{percent}} % 金幣。\n等級越高，球越快變得透明，積分獎勵也越高。",
    "upgrades.trickledown.name": "涓流而下",
    "upgrades.trickledown.tooltip": "硬幣出現在螢幕頂部。",
    "upgrades.trickledown.verbose_description": "如果頂排有磚塊，硬幣可能會落在頂排磚塊上，當你擊破頂排磚塊時，硬幣就會掉下來。",
    "upgrades.unbounded.name": "特殊空間",
    "upgrades.unbounded.tooltip": "在關卡增加了左右兩側的空間，但是你的槳板無法到達那麼遠的地方。",
    "upgrades.unbounded.verbose_description": "另一次升級或許可以幫助你延長槳板的擊球距離。",
    "upgrades.varied_diet.name": "",
    "upgrades.varied_diet.tooltip": "",
    "upgrades.varied_diet.verbose_description": "",
    "upgrades.vibrant_neighborhood.name": "",
    "upgrades.vibrant_neighborhood.tooltip": "",
    "upgrades.vibrant_neighborhood.verbose_description": "",
    "upgrades.viscosity.name": "黏度",
    "upgrades.viscosity.tooltip": "更慢的硬幣墜落",
    "upgrades.viscosity.verbose_description": "硬幣通常會在重力和爆炸的作用下加速到相當高的速度。\n\n此技能會讓硬幣持續減速，就像它們置身於某種黏稠液體中一樣。\n\n這使得接住硬幣變得更容易，並且能與影響硬幣移動的技能完美配合。",
    "upgrades.wind.name": "風",
    "upgrades.wind.tooltip": "槳板的位置產生風",
    "upgrades.wind.verbose_description": "風向取決於槳板的位置：槳板在左方吹左風，槳板在右方吹右風。對球和硬幣都有影響。",
    "upgrades.wrap_left.name": "左出右入",
    "upgrades.wrap_left.tooltip": "擊中左側會使球瞬間移動到右側",
    "upgrades.wrap_left.verbose_description": "更高的等級也傳送硬幣。",
    "upgrades.wrap_right.name": "右出左入",
    "upgrades.wrap_right.tooltip": "擊中右側會使球瞬間移動到左側",
    "upgrades.wrap_right.verbose_description": "更高的等級也傳送硬幣。",
    "upgrades.wrap_up.name": "無上邊際",
    "upgrades.wrap_up.tooltip": "觸碰螢幕頂部會將球傳送至槳板上方。",
    "upgrades.wrap_up.verbose_description": "這不算是擊中槳板。到了第 2 級，硬幣也會傳送。",
    "upgrades.yoyo.name": "溜溜球",
    "upgrades.yoyo.tooltip": "球會落向槳板",
    "upgrades.yoyo.verbose_description": "它與念力相反，在球落下時控制它。",
    "upgrades.zen.name": "禪",
    "upgrades.zen.tooltip": "如果你不觸發炸彈，將獲得更多硬幣",
    "upgrades.zen.verbose_description": "每 3 秒 +{{lvl}} 次連擊，爆炸時重置"
}
