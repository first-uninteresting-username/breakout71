    "upgrades.ball_attract_ball.name": "Gravity",
    "upgrades.ball_attract_ball.tooltip": "Lopty priťahujú gule",
    "upgrades.ball_attract_ball.verbose_description": "Lopty, ktoré sú viac ako \"3/4 šírky hernej plochy\" sa začínajú navzájom priťahovať.\n\nAtrakcia sila je silnejšia, keď sú od seba kožušiny.\n\nDúhové častice budú lietať symbolizovať lákavú silu. Tento perk sa ponúka len vtedy, ak máte viac ako jednu loptu už.",
    "upgrades.ball_attracts_coins.name": "Lopty priťahujú mince",
    "upgrades.ball_attracts_coins.tooltip": "Mince nasledovať najbližšie loptu",
    "upgrades.ball_attracts_coins.verbose_description": "To by mohlo byť použité na \"paint okolo\" guľôčky s mince, ak ste spojili s \"stain\" a \"host mince\". Funguje tiež ako náhrada mince magnet.",
    "upgrades.ball_repulse_ball.name": "Osobný priestor",
    "upgrades.ball_repulse_ball.tooltip": "Lopty repulzné gule",
    "upgrades.ball_repulse_ball.verbose_description": "Lopty, ktoré sú menej ako štvrtinu šírku obrazovky, sa začínajú navzájom odpudzovať. Repulzačná sila je silnejšia, ak sú navzájom blízko. Časti budú vyčerpať symbolizovať túto silu. Tento perk sa ponúka len vtedy, ak máte viac ako jednu loptu už.",
    "upgrades.base_combo.name": "Silné základy",
    "upgrades.base_combo.tooltip": "3 viac mincí za tehlu rozbité",
    "upgrades.base_combo.verbose_description": "Váš hrebeň zvyčajne začína na 1 na začiatku úrovne, a resetuje na 1, keď odrazíte bez biť nič. S týmto perk, combo začína 3 body vyššie, takže budete vždy získať aspoň 4 mince na tehlu. Vždy, keď sa váš hrebeň reset, vráti sa späť na 4 a nie 1. Vaša lopta bude trblietať trochu naznačovať, že jeho česano je vyšší ako jeden. Na úrovni 2, dodáva 4 mince, potom 5, potom 6 ..",
    "upgrades.bigger_balls.name": "",
    "upgrades.bigger_balls.tooltip": "",
    "upgrades.bigger_balls.verbose_description": "",
    "upgrades.bigger_explosions.name": "Všeobecný",
    "upgrades.bigger_explosions.tooltip": "Veľké výbuchy",
    "upgrades.bigger_explosions.verbose_description": "Predvolené výbuch vyčnieva štvorcové námestie 3x3, s tým sa stáva 5x5 štvorec a rana na mince je tiež výrazne silnejší. Obraz bude blesk po každom výbuchu (okrem základného režimu)",
    "upgrades.bigger_puck.name": "Veľký paddleboard",
    "upgrades.bigger_puck.tooltip": "Ľahko chytiť viac mincí",
    "upgrades.bigger_puck.verbose_description": "Väčší paddleboard uľahčuje nikdy ujsť loptu a chytiť viac mincí, a tiež presne uhol odrazy ( uhol lopty závisí len na tom, kde zasiahne pád).",
    "upgrades.bricks_attract_ball.name": "Bricks priťahuje gule",
    "upgrades.bricks_attract_ball.tooltip": "Lopta ide smerom k blízkosti tehál",
    "upgrades.bricks_attract_ball.verbose_description": "Lopta ide smerom k prvému {{count}} tehly to bude hit. Účinok je silnejší na vyššej úrovni. Počet tehál, ktoré môžu zasiahnuť pred zastavením účinku je tiež vyššia. Účinok zamračené, keď lopta zasiahne paddleboard.",
    "upgrades.bricks_attract_coins.name": "Bricks priťahuje mince",
    "upgrades.bricks_attract_coins.tooltip": "Pomáha im zostať tam",
    "upgrades.bricks_attract_coins.verbose_description": "Mince budú priťahované do blízkych tehál. Na vyšších úrovniach je príťažlivosť silnejší.",
    "upgrades.buoy.name": "Buoy",
    "upgrades.buoy.tooltip": "Mince plávajú na {{duration}} sekúnd na spodnom riadku.",
    "upgrades.buoy.verbose_description": "Účinok je najviac viditeľný v mobilnom režime",
    "upgrades.chill.name": "Chill",
    "upgrades.chill.tooltip": "Žiadne ďalšie upgrady, neobmedzené úrovne.",
    "upgrades.chill.verbose_description": "Loptu tiež urýchľuje oveľa pomalšie.",
    "upgrades.clairvoyant.name": "Všeobecný",
    "upgrades.clairvoyant.tooltip": "Pozrite sa na nadchádzajúce úrovne, tehly HP a loptu smer",
    "upgrades.clairvoyant.verbose_description": "Pomáha vám vybrať správne upgrady a pochopiť, čo sa deje s robustnými tehlami. Level 2 a 3 prinášajú ďalšie znalosti pochybného nástroja (rozšíriteľné v režime slučky)",
    "upgrades.coin_magnet.name": "Mince magnet",
    "upgrades.coin_magnet.tooltip": "Paddleboard priťahuje mince",
    "upgrades.coin_magnet.verbose_description": "Priťahuje mince na paddleboard. Účinok je silnejší, ak je mince blízko nej už.",
    "upgrades.compound_interest.name": "Zlúčeniny záujem",
    "upgrades.compound_interest.tooltip": "Viac mincí, ak chytíte všetky mince",
    "upgrades.compound_interest.verbose_description": "Váš hrebeň bude rásť raz zakaždým, keď rozbijete tehál, prerezávate viac a viac mincí s každou tehálou.\nUistite sa však chytiť každý z týchto mincí s lopatou, pretože akákoľvek stratená mince obnoví vaše česanie.\nAkonáhle je váš hrebeň nad minimálnou, dno hracej plochy bude mať červenú líniu, aby vám pripomenul, že mince by nemali ísť tam.",
    "upgrades.concave_puck.name": "S pozdravom paddleboard",
    "upgrades.concave_puck.tooltip": "Zlepšuje vertikálnu presnosť zacielenia",
    "upgrades.concave_puck.verbose_description": "Lopty začínajú úroveň ísť rovno hore, a odrazí s menším uhlom.",
    "upgrades.corner_shot.name": "Rohový záber",
    "upgrades.corner_shot.tooltip": "Nechajte si paddleboard prekrývať sa s hranicami obrazovky",
    "upgrades.corner_shot.verbose_description": "Pomáha s cieľom v rohoch. Ďalšie úrovne nechať ísť ďalej.",
    "upgrades.disco_ball.name": "",
    "upgrades.disco_ball.tooltip": "",
    "upgrades.disco_ball.verbose_description": "",
    "upgrades.double_or_nothing.name": "Dvojité alebo nič",
    "upgrades.double_or_nothing.tooltip": "",
    "upgrades.double_or_nothing.verbose_description": "Horský reset počíta len vtedy, keď váš hrebeň bol nad minimálnou",
    "upgrades.etherealcoins.name": "Mince, v priestore",
    "upgrades.etherealcoins.tooltip": "Mince už nie sú ovplyvnené gravitáciou",
    "upgrades.etherealcoins.verbose_description": "Mince budú udržiavať svoju rýchlosť aj po niekoľkých odrazí, a už nebudú ovplyvnené gravitáciou.",
    "upgrades.extra_levels.name": "5 min viac",
    "upgrades.extra_levels.tooltip": "Hrať {{count}} úrovne namiesto 7",
    "upgrades.extra_levels.verbose_description": "Predvolená hra môže trvať maximálne 7 úrovní, po ktorej je hra skončila.\n\nKaždá úroveň tohto perka umožňuje ísť o jednu úroveň vyššie. Posledné úrovne sú často tie, kde urobíte najviac skóre, takže rozdiel môže byť dramatický.",
    "upgrades.extra_life.name": "Extra život",
    "upgrades.extra_life.tooltip": "Uloží vašu poslednú loptu, ak sa chystá byť stratený",
    "upgrades.extra_life.verbose_description": "Život bude konzumovaný v procese. Extra životy ukazujú, ako pri líniách za pádom.",
    "upgrades.flyswatter.name": "",
    "upgrades.flyswatter.tooltip": "",
    "upgrades.flyswatter.verbose_description": "",
    "upgrades.forgiving.name": "Prevzdania",
    "upgrades.forgiving.tooltip": "Prvýkrát, keď loptička minie všetky tehly v úrovni, sa ignoruje.",
    "upgrades.forgiving.verbose_description": "",
    "upgrades.fountain_toss.name": "Fontány",
    "upgrades.fountain_toss.tooltip": "Gain combo, keď vynecháte mince.",
    "upgrades.fountain_toss.verbose_description": "Keď vynecháte mincu a váš hrebeň bol pod úrovňou * 30, váš hrebeň má pravdepodobnosť úrovne/kombo rásť jeden.",
    "upgrades.fumes.name": "",
    "upgrades.fumes.tooltip": "",
    "upgrades.fumes.verbose_description": "",
    "upgrades.ghost_coins.name": "Ghost mince",
    "upgrades.ghost_coins.tooltip": "Mince pomaly prejsť cez tehly",
    "upgrades.ghost_coins.verbose_description": "Nie je to chyba, je to funkcia! Mince letia cez tehly pomaly. Vyššie úrovne nechať ich pohybovať rýchlejšie.",
    "upgrades.golden_goose.name": "Zlatý hus",
    "upgrades.golden_goose.tooltip": "Mince teleport na loptu po zasiahnutí tehly",
    "upgrades.golden_goose.verbose_description": "Kedykoľvek mince hity tehla, teleport, že mince do najbližšieho lopty. Na úrovni dva, mince teleport po biť stranu tiež.",
    "upgrades.gravity_falls.name": "",
    "upgrades.gravity_falls.tooltip": "",
    "upgrades.gravity_falls.verbose_description": "",
    "upgrades.happy_family.name": "Šťastná rodina",
    "upgrades.happy_family.tooltip": "Viac mincí, ak budete mať všetky guľôčky v hre.",
    "upgrades.happy_family.verbose_description": "+1 combo za extra loptu na pád. Combo resetuje, keď je lopta stratená. Iba loptu nad 1 dať combo.",
    "upgrades.hardhat.name": "",
    "upgrades.hardhat.tooltip": "",
    "upgrades.hardhat.verbose_description": "",
    "upgrades.helium.name": "Hélium",
    "upgrades.helium.tooltip": "Gravity obmedzená vľavo a doprava paddle",
    "upgrades.helium.verbose_description": "Na úrovni 1 sa znižuje gravitácia. Na úrovni 2, mince pomaly plávajú. Na úrovni 3 naozaj lietať.",
    "upgrades.hot_start.name": "Horúci začiatok",
    "upgrades.hot_start.tooltip": "Viac mincí, ak vyčistite úroveň pod 30s",
    "upgrades.hot_start.verbose_description": "Na začiatku každej úrovne začne váš hrebeň na +{{start}} bodov, ale potom každý druhý bude znížený {{loss}}. Účinok zásobníky s inými perks.",
    "upgrades.implosions.name": "Zložky",
    "upgrades.implosions.tooltip": "Explosions sať mince namiesto fúkania",
    "upgrades.implosions.verbose_description": "Expresná sila sa aplikuje iným spôsobom. Ďalšie úrovne pôsobia ako \"bigger výbuch\"",
    "upgrades.instant_explosion.name": "",
    "upgrades.instant_explosion.tooltip": "",
    "upgrades.instant_explosion.verbose_description": "",
    "upgrades.left_is_lava.name": "Vyhnite sa ľavej strane",
    "upgrades.left_is_lava.tooltip": "Viac mincí, ak sa nedotýkate ľavej strane",
    "upgrades.left_is_lava.verbose_description": "Kedykoľvek rozbijete tehál, váš hrebeň sa zvýši jeden, takže dostanete jednu viac mincí zo všetkých ďalších tehálov, ktoré zlomíte.\n\nAvšak, váš hrebeň bude resetovať hneď, ako vaša lopta hity na ľavej strane .\n\nAkonáhle váš hrebeň stúpa, ľavá strana sa stáva červená, aby vám pripomenul, že by ste sa mali vyhnúť biť.\n\nNa úrovni 2 je hranica úplne odstránená a vaše guľôčky a mince by mohli stratiť.",
    "upgrades.limitless.name": "Bez obmedzenia",
    "upgrades.limitless.tooltip": "Zdvihnite maximálnu úroveň upgradu {{lvl}}",
    "upgrades.limitless.verbose_description": "Výber tohto perku tiež zvyšuje svoj vlastný limit jedným, nechať si ho znova vybrať.",
    "upgrades.metamorphosis.name": "Metamorfóza",
    "upgrades.metamorphosis.tooltip": "Každá mince môže škvrnať {{lvl}} tehla (s) s jeho farbou",
    "upgrades.metamorphosis.verbose_description": "S týmto perk, mince budú farba tehly pochádzajú, a bude farebná prvá tehla sa dotýkajú v rovnakej farbe. Mince šité s rýchlosťou lopty, ktorá ich rozbila, čo znamená, že môžete trochu zamerať v smere tehál, ktoré chcete \"paint\". Na úrovni 1, každá mince môže farba 1 tehly pred tým, ako je \"spent\" a zdá sa duté.",
    "upgrades.minefield.name": "Minefield",
    "upgrades.minefield.tooltip": "+{{percent}}% mincí za bombovú tehlu na obrazovke",
    "upgrades.minefield.verbose_description": "Bomby sú počítané, zatiaľ čo sú explodujúce príliš.",
    "upgrades.multiball.name": "Multi loptu",
    "upgrades.multiball.tooltip": "Začnite všetky úrovne s {{count}} guľôčky.",
    "upgrades.multiball.verbose_description": "Akonáhle spustíte loptu v Breakout 71, stratíte.\n\nS týmto atramentom získate dve guľôčky a môžete si dovoliť stratiť jeden.\n\nStratené gule sa vracajú na ďalšej úrovni.\n\nMať viac ako jednu guľôčku robí niektoré ďalšie perks k dispozícii, a samozrejme jasne vyrovnáva úroveň rýchlejšie.",
    "upgrades.nbricks.name": "Prísne veľkosť vzorky",
    "upgrades.nbricks.tooltip": "Viac mincí, ak narazíte na tehly jeden po druhom.",
    "upgrades.nbricks.verbose_description": "",
    "upgrades.one_more_choice.name": "Extra výber",
    "upgrades.one_more_choice.tooltip": "Ďalšie možnosti upgradu",
    "upgrades.one_more_choice.verbose_description": "Každý upgrade menu bude mať ešte jednu možnosť. Nezvyšuje počet upgradov si môžete vybrať.",
    "upgrades.ottawa_treaty.name": "Ottawa zmluva",
    "upgrades.ottawa_treaty.tooltip": "Breaking tehla v blízkosti bomby ho odzbrojuje",
    "upgrades.ottawa_treaty.verbose_description": "Najbližšie bomba bude nahradená farebným blokom. Ak máte večeru, lopta uvoľní svoj šperk účinok až do ďalšieho odrazí. Iba jedna bomba môže byť nahradená naraz.",
    "upgrades.paddle_up_combo.name": "",
