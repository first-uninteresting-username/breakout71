    "upgrades.puck_repulse_ball.name": "Soft pristátie",
    "upgrades.puck_repulse_ball.tooltip": "Paddle repulzné gule",
    "upgrades.puck_repulse_ball.verbose_description": "Keď lopta dostane blízko k pádu, začne spomaliť, a dokonca potenciálne poskakovanie bez dotyku paddleboard.",
    "upgrades.rainbow.name": "Dúha",
    "upgrades.rainbow.tooltip": "Mince šité s dúha farba.",
    "upgrades.rainbow.verbose_description": "Každá úroveň zvyšuje podiel farebných mincí. Farba závisí od času úrovne.",
    "upgrades.reach.name": "Top dole",
    "upgrades.reach.tooltip": "Viac mincí, ak sa vyhnete najnižšiemu rade tehál",
    "upgrades.reach.verbose_description": "Dotykanie N tehál najnižšieho riadku resetuje hrebeň. V opačnom prípade +N combo.\n\nAk existuje len jeden rad tehál, alebo ak najnižšie rade tehál pokrývajú celú šírku hry, potom tento perk nemá nič. V opačnom prípade lámanie tohto najnižšieho riadku resetuje hrebeňo, zatiaľ čo lámanie niečo iného zvyšuje hrebeň podľa počtu tehál prítomných na tomto najnižšiom rade.\n\nNajnižší riadok bude zvýraznený červenou.",
    "upgrades.refill.name": "",
    "upgrades.refill.tooltip": "",
    "upgrades.refill.verbose_description": "",
    "upgrades.respawn.name": "Re-spawn",
    "upgrades.respawn.tooltip": "{{percent}}% tehál re-spawn po {{delay}}s.",
    "upgrades.respawn.verbose_description": "Niektorí účinok častíc vám umožní vedieť, kde sa objavia tehly.",
    "upgrades.right_is_lava.name": "Vyhnite sa pravej strane",
    "upgrades.right_is_lava.tooltip": "Viac mincí, ak sa nedotýkate pravej strane",
    "upgrades.right_is_lava.verbose_description": "Kedykoľvek rozbijete tehál, váš hrebeň sa zvýši jeden, takže dostanete jednu viac mincí zo všetkých ďalších tehálov, ktoré zlomíte.\n\nAvšak, váš hrebeň bude resetovať hneď, ako vaša lopta hity na pravej strane.\n\nAkonáhle bude váš hrebeňo stúpa, správna strana sa červená, aby vám pripomenul, že by ste sa mali vyhnúť biť.\n\nNa úrovni 2 je hranica úplne odstránená a vaše guľôčky a mince by mohli stratiť.",
    "upgrades.round_bricks.name": "",
    "upgrades.round_bricks.tooltip": "",
    "upgrades.round_bricks.verbose_description": "",
    "upgrades.sacrifice.name": "Sacrifice",
    "upgrades.sacrifice.tooltip": "",
    "upgrades.sacrifice.verbose_description": "",
    "upgrades.sapper.name": "Salón",
    "upgrades.sapper.tooltip": "Prvá tehla zlomená sa stáva bombou.",
    "upgrades.sapper.verbose_description": "Namiesto toho, aby len zmiznú, prvá tehla, ktorú zlomíte, bude nahradená bombovou tehálou. Porušenie lopty na paddleboard re-arms účinok. Úroveň-up tento perk vám umožní umiestniť viac bomby.",
    "upgrades.shocks.name": "Shocks",
    "upgrades.shocks.tooltip": "Zrážky výbušných guľôb",
    "upgrades.shocks.verbose_description": "Vždy, keď dve guľôčky kolid, vymenia ich rýchlosť, prerezávajú výbuch, a získať pridané rýchlosť oddeliť ich.",
    "upgrades.shunt.name": "SLOV",
    "upgrades.shunt.tooltip": "Udržujte {{percent}}% vášho hrebeňa medzi úrovňami",
    "upgrades.shunt.verbose_description": "Ak máte tiež horúci začiatok, horúci štart je len pridaný do aktuálneho hrebeňa",
    "upgrades.side_flip.name": "Pravé odovzdané",
    "upgrades.side_flip.tooltip": "",
    "upgrades.side_flip.verbose_description": "",
    "upgrades.side_kick.name": "Ľavá ruka",
    "upgrades.side_kick.tooltip": "",
    "upgrades.side_kick.verbose_description": "",
    "upgrades.skip_last.name": "Jednoduché čistenie",
    "upgrades.skip_last.tooltip": "Posledná tehla sa bude deštruktovať",
    "upgrades.skip_last.verbose_description": "Musíte zlomiť všetky tehly ísť na ďalšiu úroveň. Avšak, to môže byť ťažké získať tie posledné.\nKaždá úroveň tohto perka zvyšuje počet tehál, ktoré sa budú deštruktovať.\nVymazanie úrovne čoskoro prináša ďalšie možnosti pri modernizácii. Nikdy chýba tehál je tiež veľmi prospešný.\n\nTakže ak zistíte, že je ťažké prelomiť posledné tehly, dostať tento perk niekoľko času môže pomôcť.",
    "upgrades.slow_down.name": "Slower loptu",
    "upgrades.slow_down.tooltip": "Lopta sa pohybuje viac pomaly",
    "upgrades.slow_down.verbose_description": "Loptu začína relatívne pomalé, ale každá úroveň vašej hry začne trochu rýchlejšie.\n\nTo bude tiež urýchliť, ak trávite veľa času na jednej úrovni.\n\nTento perk to robí viac zvládnuteľný.\n\nMôžete ho získať na začiatku zakaždým tým, že umožní režim dieťaťa v menu.",
    "upgrades.smaller_puck.name": "Malý paddleboard",
    "upgrades.smaller_puck.tooltip": "{{percent}}% viac mincí",
    "upgrades.smaller_puck.verbose_description": "To robí paddle menšie, čo v teórii robí niektoré rohové zábery jednoduchšie, ale naozaj len zvyšuje obtiažnosť.\n\nTo je dôvod, prečo si tiež získať pekný bonus +50% mince kúpele.",
    "upgrades.soft_brush.name": "",
    "upgrades.soft_brush.tooltip": "",
    "upgrades.soft_brush.verbose_description": "",
    "upgrades.soft_reset.name": "Soft reset",
    "upgrades.soft_reset.tooltip": "Udržujte {{percent}}% vášho hrebeňa, keď sa obnoví",
    "upgrades.soft_reset.verbose_description": "Obmedzte vplyv na obnovenie hrebeňa.",
    "upgrades.soft_touch.name": "",
    "upgrades.soft_touch.tooltip": "",
    "upgrades.soft_touch.verbose_description": "",
    "upgrades.steering.name": "Riadenie",
    "upgrades.steering.tooltip": "Lopty zase pri páde",
    "upgrades.steering.verbose_description": "Zmena paddleboardu priamo ovplyvňuje smer pohybu guľôčok. Na úrovni 2+, dostanete linku, ktorá vám ukazuje smer lopty.",
    "upgrades.sticky_coins.name": "Nálepkové mince",
    "upgrades.sticky_coins.tooltip": "Mince držať tehál rovnakej farby",
    "upgrades.sticky_coins.verbose_description": "Na úrovni 2 sa držať tehál akejkoľvek farby",
    "upgrades.streak_shots.name": "Hit streak",
    "upgrades.streak_shots.tooltip": "Viac mincí, ak rozbijete veľa tehál naraz",
    "upgrades.streak_shots.verbose_description": "Zakaždým, keď rozbijete tehlu, váš hrebeň sa zvyšuje jedným.\n\nAvšak, akonáhle lopta dotýka vaše paddleboard, hrebeňo je resetovať na svoju predvolenú hodnotu.\n\nPo tom, čo váš hrebeň stúpa nad základnou hodnotou, vaše paddleboard bude mať červenú hranicu, aby vám pripomenul, že to bude zničiť váš hrebeň, aby sa ho dotknúť s loptou.",
    "upgrades.sturdy_bricks.name": "Sturdy tehly",
    "upgrades.sturdy_bricks.tooltip": "+{{lvl}} tehly HP, +{{percent}}% mincí",
    "upgrades.sturdy_bricks.verbose_description": "Každá úroveň tohto perka pridáva jeden HP na všetky tehly. Môžete vidieť číslo HP s \"clairvoyant\" perk. Môžete zvýšiť poškodenie lopty tým, že dostanete \"piercing\" perk. Každá úroveň perk pridáva +50% mince kúpele.",
    "upgrades.superhot.name": "SUPER HOT",
    "upgrades.superhot.tooltip": "Čas sa pohybuje, keď sa paddleboard pohybuje.",
    "upgrades.superhot.verbose_description": "SUPER HOT SUPER HOT SUPER HOT SUPER HOT",
    "upgrades.telekinesis.name": "Telekinéza",
    "upgrades.telekinesis.tooltip": "Poschodová poloha ovplyvňuje loptu",
    "upgrades.telekinesis.verbose_description": "Ovládate loptu, zatiaľ čo to bude hore. Účinok je silnejší, keď je lopta v spodnej polovici obrazovky.",
    "upgrades.thomas.name": "",
    "upgrades.thomas.tooltip": "",
    "upgrades.thomas.verbose_description": "",
    "upgrades.three_cushion.name": "Tri vankúš",
    "upgrades.three_cushion.tooltip": "Viac mincí, ak narazíte na tehly iba nepriamo",
    "upgrades.three_cushion.verbose_description": "",
    "upgrades.top_is_lava.name": "Sky je limit",
    "upgrades.top_is_lava.tooltip": "Viac mincí, ak sa vyhnete biť hore",
    "upgrades.top_is_lava.verbose_description": "Kedykoľvek rozbijete tehál, váš hrebeň sa zvýši jeden. Avšak, vaše combo bude resetovať hneď, ako vaša lopta hit vrchol obrazovky.\n\nKeď je váš hrebeň nad minimum, sa objaví červený bar na vrchole, aby vám pripomenul, že by ste sa mali vyhnúť biť.\n\nNa úrovni 2 je hranica úplne odstránená a vaše guľôčky a mince by mohli stratiť.",
    "upgrades.trampoline.name": "Trampoline",
    "upgrades.trampoline.tooltip": "Viac mincí, ak odrazíte na tehly a paddleboard iba",
    "upgrades.trampoline.verbose_description": "+{{lvl}} combo na pád,-{{lvl}} combo na každom okraji. Jeden z vzácnych hrebeňov, ktoré nepridávajú stav obnovenia",
    "upgrades.transparency.name": "Aktuality",
    "upgrades.transparency.tooltip": "+50% mincí. Lopta je neviditeľný v hornej časti obrazovky.",
    "upgrades.transparency.verbose_description": "Lopta sa stáva transparentnou v hornej časti obrazovky.\n+{{percent}} % mincí.\nVyššie úrovne, aby lopta priehľadný skôr a zvýšiť bod bonus.",
    "upgrades.trickledown.name": "Triky dole",
    "upgrades.trickledown.tooltip": "Mince sa objavujú v hornej časti obrazovky.",
    "upgrades.trickledown.verbose_description": "Mince by mohli sedieť na vrchole tehly, ak sú tehly na hornom riadku, v takom prípade sa po rozpade, že tehla.",
    "upgrades.unbounded.name": "Zváranie",
    "upgrades.unbounded.tooltip": "Dodáva priestor vľavo a vpravo od úrovne, ale vaša paddleboard nemôže ísť tak ďaleko.",
    "upgrades.unbounded.verbose_description": "Ďalšou upgradu vám môže pomôcť predĺžiť dosah paddleboardu.",
