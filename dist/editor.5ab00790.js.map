    "upgrades.addiction.name": "Závislost",
    "upgrades.addiction.tooltip": "Více mincí, pokud cihličky rozbíjíte bez přestávky",
    "upgrades.addiction.verbose_description": "+{{lvl}} kombo / rozbitá cihlička, kombo se resetuje {{delay}} s po rozbití cihličky. Odpočet začíná až po rozbití první cihličky v každé úrovni. Zastaví se, jakmile jsou všechny cihličky zničeny.",
    "upgrades.asceticism.name": "Askeze",
    "upgrades.asceticism.tooltip": "+{{combo}} kombo za rozbitou cihličku, −{{loss}} kombo za chycenou minci.",
    "upgrades.asceticism.verbose_description": "Mince si budete muset někam odložit a nechat stoupat své kombo.",
    "upgrades.ball_attract_ball.name": "Skupinový projekt",
    "upgrades.ball_attract_ball.tooltip": "Míčky přitahují míčky",
    "upgrades.ball_attract_ball.verbose_description": "Míčky, které jsou od sebe dále než „3/4 šířky herní plochy“, se začnou přitahovat.\n\nPřitažlivost je tím silnější, čím jsou od sebe dále.\n\nPřitažlivou sílu budou symbolizovat létající duhové částice. Toto vylepšení se nabídne jen ve chvíli, kdy už máte více než jeden míček.",
    "upgrades.ball_attracts_coins.name": "Míčky přitahují mince",
    "upgrades.ball_attracts_coins.tooltip": "Mince následují nejbližší míček",
    "upgrades.ball_attracts_coins.verbose_description": "Tohle se dá použít pro „malování“ okolo míčků pomocí mincí, pokud to zkombinujete s „metamorfózou“ a „nehmotnými mincemi“. Také se dá použít jako náhrada magnetu na mince.",
    "upgrades.ball_repulse_ball.name": "Osobní prostor",
    "upgrades.ball_repulse_ball.tooltip": "Míčky odpuzují míčky",
    "upgrades.ball_repulse_ball.verbose_description": "Míčky, které jsou u sebe blíže než čtvrtina šířka obrazovky, se začnou navzájem odpuzovat. Odpudivá síla je tím silnější, čím jsou blíže k sobě. Působící sílu budou symbolizovat částice, které vytrysknou. Toto vylepšení se nabídne jen ve chvíli, kdy už máte více než jeden míček.",
    "upgrades.base_combo.name": "Silné základy",
    "upgrades.base_combo.tooltip": "O 3 mince více za rozbitou cihličku",
    "upgrades.base_combo.verbose_description": "Vaše kombo normálně na začátku úrovně začíná na 1 a resetuje se na 1, když se míček poodráží, aniž by něco trefil. S tímto vylepšením bude vaše kombo začínat o 3 body výše, takže vždy za každou cihličku dostanete nejméně 4 mince. Kdykoli se vaše kombo resetuje, vrátí se na 4 namísto 1. Váš míček se bude mírně třpytit, aby ukázal, že je kombo vyšší než jedna. Na 2. úrovni přidává 4 mince, potom 5, pak 6, …",
    "upgrades.bigger_balls.name": "Větší míček",
    "upgrades.bigger_balls.tooltip": "Zvětší průměr míčku",
    "upgrades.bigger_balls.verbose_description": "Díky tomu se o trochu snáze zasahují cihličky.",
    "upgrades.bigger_explosions.name": "Bum",
    "upgrades.bigger_explosions.tooltip": "Větší výbuchy",
    "upgrades.bigger_explosions.verbose_description": "Výchozí exploze vyčistí čtverec 3×3, s tímhle se z toho stane čtverec 5×5 a odvátí mincí je výrazně silnější. Obrazovka při každém výbuchu blikne (kromě základního režimu)",
    "upgrades.bigger_puck.name": "Větší pálka",
    "upgrades.bigger_puck.tooltip": "Snadno chytejte více mincí",
    "upgrades.bigger_puck.verbose_description": "Větší pálka usnadňuje nikdy neminout míček a chytat více mincí a také pomáhá k přesnému nasměřování úhlu odrazu (úhel míčku závisí pouze na tom, kde zasáhne pálku).",
    "upgrades.bricks_attract_ball.name": "Cihličky přitahují míčky",
    "upgrades.bricks_attract_ball.tooltip": "Míček směřuje k nejbližším cihličkám",
    "upgrades.bricks_attract_ball.verbose_description": "Míček míří směrem k prvním {{count}} cihličkám, které zasáhne. Účinek je silnější na vyšších úrovních. Počet cihliček, které může zasáhnout, než účinek přestane, je také vyšší. Účinek se vrací, když míček zasáhne pálku.",
    "upgrades.bricks_attract_coins.name": "Cihličky přitahují mince",
    "upgrades.bricks_attract_coins.tooltip": "Pomáhá jim to zůstat nahoře",
    "upgrades.bricks_attract_coins.verbose_description": "Mince budou přitahovány okolními cihličkami. Na vyšších úrovních je přitažlivost silnější.",
    "upgrades.buoy.name": "Bójka",
    "upgrades.buoy.tooltip": "Mince plavou {{duration}} sekundy na spodním okraji.",
    "upgrades.buoy.verbose_description": "Efekt je vidět nejlépe v mobilním režimu",
    "upgrades.chill.name": "Pohoda",
    "upgrades.chill.tooltip": "Žádná další vylepšení, neomezeně úrovní.",
    "upgrades.chill.verbose_description": "Míč se také zrychluje mnohem pomaleji.",
    "upgrades.clairvoyant.name": "Jasnovidnost",
    "upgrades.clairvoyant.tooltip": "Uvidíte nadcházející úrovně, životy cihliček a směr míčku",
    "upgrades.clairvoyant.verbose_description": "Pomáhá vám vybrat správná vylepšení a pochopit, co se děje s robustními cihličkami. Úrovně 2 a 3 přinášejí další informace s diskutabilní užitečností (dosažitelné pomocí Neomezené)",
    "upgrades.coin_magnet.name": "Magnet na mince",
    "upgrades.coin_magnet.tooltip": "Pálka přitahuje mince",
    "upgrades.coin_magnet.verbose_description": "Směřuje mince k pálce. Účinek je silnější, pokud je mince už blízko ní.",
    "upgrades.compound_interest.name": "Složené úročení",
    "upgrades.compound_interest.tooltip": "Více mincí, pokud chytíte všechny mince",
    "upgrades.compound_interest.verbose_description": "Vaše kombo bude růst o jedna, kdykoli rozbijete cihličku, čímž bude vznikat více a více mincí s každou rozbitou cihličkou.\nUjistěte se ale, že každou z těchto mincí chytíte pálkou, protože každá ztracená mince vaše kombo zresetuje.\nJakmile je vaše kombo nad minimem, na spodní části hrací plochy bude červená čára, aby vám připomněla, že by se tam neměly mince dostat.",
    "upgrades.concave_puck.name": "Konkávní pálka",
    "upgrades.concave_puck.tooltip": "Zlepšuje přesnost vertikálního míření",
    "upgrades.concave_puck.verbose_description": "Míček na začátku úrovně poletí přímo svisle a odráží se s menším úhlem.",
    "upgrades.corner_shot.name": "Výstřel za roh",
    "upgrades.corner_shot.tooltip": "Umožní vaší pálce přesahovat přes okraj obrazovky",
    "upgrades.corner_shot.verbose_description": "Pomáhá s mířením v rozích. Vyšší úrovně vám umožní jet ještě dále.",
    "upgrades.disco_ball.name": "Disko koule",
    "upgrades.disco_ball.tooltip": "Každý odraz ode zdi změní barvu míčku",
    "upgrades.disco_ball.verbose_description": "Míček bude cyklicky procházet barvami duhy.",
    "upgrades.double_or_nothing.name": "Dvojnásobek nebo nic",
    "upgrades.double_or_nothing.tooltip": "Kombo stoupá dvakrát rychleji, ale jakýkoli reset komba je konec hry.",
    "upgrades.double_or_nothing.verbose_description": "Reset komba se počítá jen tehdy, když už kombo bylo nad minimem. Zdvojnásobuje se také navýšení získané díky „menší pálka“, „průhlednost“ a „robustní cihličky“.",
    "upgrades.etherealcoins.name": "Mince, ve vesmíru",
    "upgrades.etherealcoins.tooltip": "Mince už neovlivňuje gravitace",
    "upgrades.etherealcoins.verbose_description": "Mince si budou udržovat svou rychlost i po několika odrazech a už je nebude ovlivňovat gravitace.",
    "upgrades.extra_levels.name": "O 5 minut víc",
    "upgrades.extra_levels.tooltip": "Hrát {{count}} úrovní místo 7",
    "upgrades.extra_levels.verbose_description": "Výchozí hra může trvat maximálně 7 úrovní, po kterých hra skončí.\n\nKaždá úroveň tohoto vylepšení vám umožní jít o jednu úroveň výše. Poslední úrovně jsou často ty, kde získáte nejvíce skóre, takže rozdíl může být dramatický.",
    "upgrades.extra_life.name": "Život navíc",
    "upgrades.extra_life.tooltip": "Zachrání váš poslední míček, pokud byste o něj jinak přišli",
    "upgrades.extra_life.verbose_description": "Při tom přijdete o jeden život. Životy navíc se zobrazují jako bílé čáry za pálkou.",
    "upgrades.flyswatter.name": "Plácačka",
    "upgrades.flyswatter.tooltip": "Dotkněte se levé strany a všechny míčky získají gravitaci.",
    "upgrades.flyswatter.verbose_description": "",
    "upgrades.forgiving.name": "Odpuštění",
    "upgrades.forgiving.tooltip": "Poprvé, co míč v úrovni mine všechny cihly, se to ignoruje.",
    "upgrades.forgiving.verbose_description": "Pokud je vaše minutí odpuštěno, budete mít v tomto kritériu pořád nárok na zlatou medaili.",
    "upgrades.fountain_toss.name": "Hod do fontány",
    "upgrades.fountain_toss.tooltip": "Získejte kombo, když upustíte mince.",
    "upgrades.fountain_toss.verbose_description": "Když upustíte minci a vaše kombo bylo nižší než úroveň×30, tak se vaše kombo s pravděpodobností úroveň/kombo zvýší o jedna.",
    "upgrades.fumes.name": "Dým",
    "upgrades.fumes.tooltip": "Při rozbití cihličky získají všechny cihličky nad ní její barvu.",
    "upgrades.fumes.verbose_description": "Obarvení jde i přes mezery.",
    "upgrades.ghost_coins.name": "Nehmotné mince",
    "upgrades.ghost_coins.tooltip": "Mince pomalu procházejí cihličkami",
    "upgrades.ghost_coins.verbose_description": "To není chyba, je to vlastnost! Mince prolétají cihličkami pomalu. Vyšší úrovně jim umožní pohybovat se rychleji.",
    "upgrades.golden_goose.name": "Zlatá husa",
    "upgrades.golden_goose.tooltip": "Mince se při zasažení cihličky teleportují k míčku",
    "upgrades.golden_goose.verbose_description": "Kdykoli mince trefí cihličku, teleportuje se k nejbližšímu míčku. Na druhé úrovni se mince teleportují i po zasažení okraje.",
    "upgrades.gravity_falls.name": "Gravitační peřeje",
    "upgrades.gravity_falls.tooltip": "Míčky, které se dotknou vršku, získají gravitaci",
    "upgrades.gravity_falls.verbose_description": "",
    "upgrades.happy_family.name": "Šťastná rodina",
    "upgrades.happy_family.tooltip": "Více mincí, pokud udržíte všechny míčky ve hře.",
    "upgrades.happy_family.verbose_description": "+1 kombo za míček navíc při každém odrazu od pálky. Kombo se resetuje, když ztratíte míček. Kombo je poskytováno jen s více než jedním míčkem.",
    "upgrades.hardhat.name": "Přilba",
    "upgrades.hardhat.tooltip": "Cihličky je těžší rozbít shora",
    "upgrades.hardhat.verbose_description": "Sníží poškození na polovinu, pokud míček zasáhne vršek cihličky",
    "upgrades.helium.name": "Hélium",
    "upgrades.helium.tooltip": "Gravitace je nalevo a napravo od pálky snížená",
    "upgrades.helium.verbose_description": "Na 1. úrovni je gravitace zmenšená. Na 2. úrovni mince pomalu plují vzhůru. Na 3. úrovni úplně létají.",
    "upgrades.hot_start.name": "Horký start",
    "upgrades.hot_start.tooltip": "Více mincí, pokud úroveň vyčistíte pod 30 s",
    "upgrades.hot_start.verbose_description": "Na začátku každé úrovně začne vaše kombo na +{{start}} bodech, ale poté se každou druhou sekundu zmenší o {{loss}}. Účinek se kombinuje s ostatními vylepšeními.",
    "upgrades.implosions.name": "Imploze",
    "upgrades.implosions.tooltip": "Výbuchy mince vcucnou místo jejich odfouknutí",
    "upgrades.implosions.verbose_description": "Síla výbuchu se aplikuje opačným směrem. Další úrovně působí jako „větší výbuch“",
    "upgrades.instant_explosion.name": "Okamžitý výbuch",
    "upgrades.instant_explosion.tooltip": "Výbuchy rozbíjejí okolní cihličky a bomby okamžitě",
    "upgrades.instant_explosion.verbose_description": "Může to být užitečné, pokud spoléháte na to, že výbuchy rozbijí cihličky před tím, než se zresetuje vaše kombo.",
    "upgrades.left_is_lava.name": "Vyhněte se levé straně",
    "upgrades.left_is_lava.tooltip": "Více mincí, pokud se nedotknete levé strany",
    "upgrades.left_is_lava.verbose_description": "Kdykoli rozbijete cihličku, zvýší se vaše kombo o jedna, takže ze všech dalších cihliček, které rozbijete, získáte o jednu minci víc.\n\nVaše kombo se ale resetuje, jakmile se míček dotkne levého okraje.\n\nJakmile se vaše kombo zvýší, zbarví se levá strana červeně, aby vám připomínala, že ji nemáte trefovat.\n\nNa úrovni 2 okraj úplně zmizí a vaše míčky a mince se mohou ztratit.\n\nToto vylepšení ovlivňuje počáteční směr míčku.",
    "upgrades.limitless.name": "Neomezené",
    "upgrades.limitless.tooltip": "Zvýší maximální úroveň všech vylepšení o {{lvl}}",
    "upgrades.limitless.verbose_description": "Výběrem tohoto vylepšení se o jedna zvýší také jeho vlastní limit, takže si ho můžete vybrat znovu.",
    "upgrades.metamorphosis.name": "Metamorfóza",
    "upgrades.metamorphosis.tooltip": "Každá mince může obarvit {{lvl}} cihlu svou barvou",
    "upgrades.metamorphosis.verbose_description": "S tímto vylepšením budou mít mince barvu cihličky, ze které pocházejí, a na tuto barvu obarví první cihličku, které se dotknou. Mince vznikají s rychlostí míčku, který cihličku rozbil, což znamená, že můžete trochu mířit ve směru cihliček, které chcete „nabarvit“. Na 1. úrovni může každá mince obarvit 1 cihličku, než se „vyplýtvá“ a bude se zobrazovat dutá.",
    "upgrades.minefield.name": "Minové pole",
    "upgrades.minefield.tooltip": "+{{percent}} % mincí za každou bombu na obrazovce",
    "upgrades.minefield.verbose_description": "Bomby se započítávají, i když právě vybuchují.",
    "upgrades.multiball.name": "Více míčků",
    "upgrades.multiball.tooltip": "Začněte každou úroveň s {{count}} míčky.",
    "upgrades.multiball.verbose_description": "Jakmile v Breakout 71 ztratíte míček, prohráváte.\n\nS tímto vylepšením máte dva míčky, takže si můžete dovolit jeden ztratit.\n\nZtracený míček se v další úrovni vrátí.\n\nKdyž máte více než jeden míček, zpřístupní vám to některá další vylepšení a samozřejmě tím vyčistíte úroveň rychleji.",
    "upgrades.nbricks.name": "Dětské krůčky",
    "upgrades.nbricks.tooltip": "Více mincí, pokud úroveň čistíte pomalu.",
    "upgrades.nbricks.verbose_description": "+{{gain}} kombo za rozbitou cihličku. Kombo se zresetuje, pokud míček mezi dvěma odrazy od pálky nebo stěny rozbije více než {{max}} cihličku. Buďte opatrní, výbuchy se počítají.",
    "upgrades.one_more_choice.name": "Volba navíc",
    "upgrades.one_more_choice.tooltip": "Větší výběr vylepšení",
    "upgrades.one_more_choice.verbose_description": "Každá nabídka vylepšení bude mít o jednu možnost více. Nezvyšuje počet vylepšení, která si můžete vybrat.",
    "upgrades.ottawa_treaty.name": "Ottawská úmluva",
    "upgrades.ottawa_treaty.tooltip": "Rozbití cihličky blízko bomby ji zneškodní",
    "upgrades.ottawa_treaty.verbose_description": "Nejbližší bomba bude nahrazena barevnou cihličkou. Pokud máte ženistu, míček ztratí ženijní efekt až do dalšího odrazu. V jednu chvíli bude nahrazena jen jedna bomba.",
    "upgrades.paddle_up_combo.name": "Aura",
    "upgrades.paddle_up_combo.tooltip": "+1 za rozbití cihličky nad pálkou, jinak reset",
    "upgrades.paddle_up_combo.verbose_description": "",
    "upgrades.palette.name": "Paleta",
    "upgrades.palette.tooltip": "+1 kombo za každou další barvu cihliček na obrazovce, kombo se zresetuje, když zůstane jediná barva",
    "upgrades.palette.verbose_description": "Buďte opatrní, některé úrovně mají jen jednu barvu. První a poslední rozbitá cihlička se nepočítají.",
    "upgrades.passive_income.name": "Pasivní příjem",
    "upgrades.passive_income.tooltip": "Více mincí, ale pohybující se pálka mince nezachytí.",
    "upgrades.passive_income.verbose_description": "+{{lvl}} kombo / rozbitá cihlička, pálka je {{time}} s po pohybu nehmotná. Některá vylepšení můžou pomoci, aby míčky dělaly, co chcete, aniž byste museli něco dělat.\n\nNa 1. úrovni skrz nehmotnou pálku procházejí mince, na úrovni 2+ skrz pálku projde i míček.",
    "upgrades.picky_eater.name": "Vybíravý jedlík",
    "upgrades.picky_eater.tooltip": "Více mincí, pokud cihličky rozbíjíte postupně po barvách",
    "upgrades.picky_eater.verbose_description": "Kdykoli rozbijete cihličku stejné barvy jako míček, zvýší se vaše kombo o počet barev na obrazovce mínus jedna.\nPokud je to jiná barva, míček získá tuto novou barvu, ale kombo se zresetuje, leda by žádné cihly v barvě míčku už nezbyly.\nJakmile získáte kombo vyšší než minimum, získají cihličky špatné barvy červený okraj.\nMáte-li více než jeden míček, všechny přepínají barvu, kdykoli jeden z nich zasáhne cihličku.",
    "upgrades.pierce.name": "Prorážení",
    "upgrades.pierce.tooltip": "Míček prorazí {{count}} cihličky po odrazu od pálky",
    "upgrades.pierce.verbose_description": "Normálně se míček odrazí, jakmile se něčeho dotkne. S tímto vylepšením bude pokračovat v letu až do 3 rozbitých cihliček.\n\nPoté se na 4. cihličce odrazí a pro vynulování počítadla se musí dotknout pálky.",
    "upgrades.pierce_above_paddle.name": "Okno příležitosti",
    "upgrades.pierce_above_paddle.tooltip": "Cihličky se rozbíjejí snáze, pokud jsou nad pálkou.",
    "upgrades.pierce_above_paddle.verbose_description": "",
    "upgrades.pierce_color.name": "Prorážení barvy",
    "upgrades.pierce_color.tooltip": "Míček prochází skrz cihličky stejné barvy",
    "upgrades.pierce_color.verbose_description": "Míček nerušeně prochází skrz cihličky stejné barvy, dokud není vyčerpáno jeho „nabití“. Pro dobití poté potřebuje odraz od pálky.",
    "upgrades.pierce_left.name": "Propichování zleva",
    "upgrades.pierce_left.tooltip": "Cihličky se rozbíjejí snadněji, pokud jsou zasaženy zleva",
    "upgrades.pierce_left.verbose_description": "Toto vylepšení ovlivňuje počáteční směr míčku. Když je spuštěn tento efekt, míček zrychlí.",
    "upgrades.pierce_right.name": "Propichování zprava",
    "upgrades.pierce_right.tooltip": "Cihličky se rozbíjejí snadněji, pokud jsou zasaženy zprava",
    "upgrades.pierce_right.verbose_description": "Toto vylepšení ovlivňuje počáteční směr míčku. Když je spuštěn tento efekt, míček zrychlí.",
    "upgrades.pierce_top.name": "Propichování shora",
    "upgrades.pierce_top.tooltip": "Cihličky se rozbíjejí snadněji, pokud jsou zasaženy shora",
    "upgrades.pierce_top.verbose_description": "Když je spuštěn tento efekt, míček zrychlí.",
    "upgrades.puck_repulse_ball.name": "Měkké přistání",
    "upgrades.puck_repulse_ball.tooltip": "Pálka odpuzuje míčky",
    "upgrades.puck_repulse_ball.verbose_description": "Když se míček dostane do blízkosti pálky, začne zpomalovat a případně se i odrazí bez dotyku pálky.",
    "upgrades.rainbow.name": "Duha",
    "upgrades.rainbow.tooltip": "Mince vznikají v barvách duhy.",
    "upgrades.rainbow.verbose_description": "Každá úroveň zvyšuje poměr barevných mincí. Barva závisí na času úrovně.",
    "upgrades.reach.name": "Shora dolů",
    "upgrades.reach.tooltip": "Více mincí, pokud se vyhnete nejnižší řadě cihliček",
    "upgrades.reach.verbose_description": "Dotyk N cihliček nejnižší řady zresetuje kombo. Jinak +N kombo.\n\nPokud existuje pouze jedna řada cihliček nebo pokud nejnižší řada cihliček pokrývá celou šířku hry, tak toto vylepšení nedělá nic. V opačném případě rozbití této nejnižší řady resetuje kombo, zatímco rozbití čehokoli jiného zvýší kombo o počet cihliček v této nejnižší řadě.\n\nNejnižší řada bude červeně zvýrazněná.",
    "upgrades.refill.name": "Doplnění",
    "upgrades.refill.tooltip": "Zasažení jakékoli strany nebo teleportování míčku resetuje počítadlo prorážení míčku",
    "upgrades.refill.verbose_description": "Také poskytuje +1 prorážení.",
    "upgrades.respawn.name": "Znovuzrození",
    "upgrades.respawn.tooltip": "{{percent}} % cihliček se po {{delay}} s znovu objeví.",
    "upgrades.respawn.verbose_description": "Částicový efekt vám dá vědět, kde se cihličky objeví.",
    "upgrades.right_is_lava.name": "Vyhněte se pravé straně",
    "upgrades.right_is_lava.tooltip": "Více mincí, pokud se nedotknete pravé strany",
    "upgrades.right_is_lava.verbose_description": "Kdykoli rozbijete cihličku, zvýší se vaše kombo o jedna, takže ze všech dalších cihliček, které rozbijete, získáte o jednu minci víc.\n\nVaše kombo se ale resetuje, jakmile se míček dotkne pravého okraje.\n\nJakmile se vaše kombo zvýší, zbarví se pravá strana červeně, aby vám připomínala, že ji nemáte trefovat.\n\nNa úrovni 2 okraj úplně zmizí a vaše míčky a mince se mohou ztratit.\n\nToto vylepšení ovlivňuje počáteční směr míčku.",
    "upgrades.round_bricks.name": "Kulaté cihličky",
    "upgrades.round_bricks.tooltip": "Cihličky jsou teď kulaté",
    "upgrades.round_bricks.verbose_description": "",
    "upgrades.sacrifice.name": "Oběť",
    "upgrades.sacrifice.tooltip": "Ztráta života zvýší kombo o {{gain}}.",
    "upgrades.sacrifice.verbose_description": "",
    "upgrades.sapper.name": "Ženista",
    "upgrades.sapper.tooltip": "První rozbitá cihlička se stane bombou.",
    "upgrades.sapper.verbose_description": "Místo toho, aby jen zmizela, bude první cihlička, kterou rozbijete, nahrazena za bombu. Odraz míčku od pálky účinek znovu nabije. Vyšší úrovně tohoto vylepšení vám umožní umístit více bomb.",
    "upgrades.shocks.name": "Otřesy",
    "upgrades.shocks.tooltip": "Výbušné srážky míčků",
    "upgrades.shocks.verbose_description": "Kdykoliv se dva míčky srazí, vymění si rychlost, vyvolají výbuch a získají dodatečnou rychlost, která je oddálí.",
    "upgrades.shunt.name": "Posun",
    "upgrades.shunt.tooltip": "Uchovejte si {{percent}} % vašeho komba mezi úrovněmi",
    "upgrades.shunt.verbose_description": "Pokud máte také horký start, přidá se k aktuálnímu kombu",
    "upgrades.side_flip.name": "Pravoruký",
    "upgrades.side_flip.tooltip": "+1 kombo za rozbitou cihličku. Kombo se zresetuje, pokud jakoukoli cihličku zasáhnete zleva.",
    "upgrades.side_flip.verbose_description": "Výbuchy a odrazy, které cihličku nerozbijí, se pro reset komba nepočítají. Toto vylepšení ovlivňuje počáteční směr míčku.",
    "upgrades.side_kick.name": "Levoruký",
    "upgrades.side_kick.tooltip": "+1 kombo za rozbitou cihličku. Kombo se zresetuje, pokud jakoukoli cihličku zasáhnete zprava.",
    "upgrades.side_kick.verbose_description": "Výbuchy a odrazy, které cihličku nerozbijí, se pro reset komba nepočítají. Toto vylepšení ovlivňuje počáteční směr míčku.",
    "upgrades.skip_last.name": "Jednoduchý úklid",
    "upgrades.skip_last.tooltip": "Poslední cihlička se zničí sama",
    "upgrades.skip_last.verbose_description": "Abyste postoupili do další úrovně, musíte rozbít všechny cihličky. Ale zničit ty poslední může být těžké.\nKaždá úroveň tohoto vylepšení zvyšuje počet cihliček, které se zničí samy.\nRychlé vyčištění úrovně přináší větší nabídku vylepšení. Nikdy neminout je také velmi prospěšné.\n\nTakže pokud je pro vás těžké rozbíjet poslední cihličky, může získání tohoto vylepšení pomoci.",
    "upgrades.slow_down.name": "Pomalejší míček",
    "upgrades.slow_down.tooltip": "Míček se pohybuje pomaleji",
    "upgrades.slow_down.verbose_description": "Míček je na začátku poměrně pomalý, ale na začátku každé další úrovně vaší hry začne o trochu rychleji.\n\nTaké zrychluje, pokud v jedné úrovni strávíte hodně času.\n\nToto vylepšení to učiní zvladatelnějším.\n\nPokud si v menu aktivujete dětský režim, získáte toto vylepšení na začátku každé hry.",
    "upgrades.smaller_puck.name": "Menší pálka",
    "upgrades.smaller_puck.tooltip": "O {{percent}} % rychlejší nárůst komba",
    "upgrades.smaller_puck.verbose_description": "Tohle zmenší pálku, což teoreticky může zjednodušit některé střely z rohu, ale ve skutečnosti spíše obtížnost zvyšuje.\n\nTo je důvod, proč také získáte hezký bonus +50 % mincí.",
    "upgrades.soft_brush.name": "Jemný štětec",
    "upgrades.soft_brush.tooltip": "Při zasažení cihličky jiné barvy míček cihličku namísto rozbití obarví.",
    "upgrades.soft_brush.verbose_description": "Nic to nedělá, pokud je cihlička zničena výbuchem. Efekt se stane jen jednou za každý odraz od pálky a úroveň tohoto vylepšení.",
    "upgrades.soft_reset.name": "Měkký reset",
    "upgrades.soft_reset.tooltip": "Uchovejte si {{percent}} % svého komba, když se zresetuje",
    "upgrades.soft_reset.verbose_description": "Omezí dopad resetování komba.",
    "upgrades.soft_touch.name": "Lehký dotek",
    "upgrades.soft_touch.tooltip": "Míček se od cihliček neškodně odráží, pokud není nad pálkou.",
    "upgrades.soft_touch.verbose_description": "",
    "upgrades.steering.name": "Řízení",
    "upgrades.steering.tooltip": "Míček zatáčí, když se pohybuje pálka",
    "upgrades.steering.verbose_description": "Změna polohy pálky přímo ovlivňuje směr pohybu míčku. Na úrovni 2+ získáte čárku ukazující směr míčku.",
    "upgrades.sticky_coins.name": "Lepivé mince",
    "upgrades.sticky_coins.tooltip": "Mince se lepí na cihličky stejné barvy",
    "upgrades.sticky_coins.verbose_description": "Na úrovni 2 se lepí na cihličky jakékoli barvy",
    "upgrades.streak_shots.name": "Série zásahů",
    "upgrades.streak_shots.tooltip": "Více mincí, pokud rozbijete mnoho cihliček najednou",
    "upgrades.streak_shots.verbose_description": "Kdykoli rozbijete cihličku, zvýší se vaše kombo o jedna.\n\nAle jakmile se míček dotkne vaší pálky, kombo se resetuje na výchozí hodnotu.\n\nJakmile kombo stoupne nad základní hodnotu, získá pálka červený okraj, aby vám připomínal, že se dotykem pálky míčkem zničí vaše kombo.",
    "upgrades.sturdy_bricks.name": "Robustní cihličky",
    "upgrades.sturdy_bricks.tooltip": "+{{lvl}} život cihliček, o {{percent}} % rychlejší nárůst komba",
    "upgrades.sturdy_bricks.verbose_description": "Každá úroveň tohoto vylepšení přidá všem cihličkám jeden život. Tento počet životů můžete vidět s vylepšením „jasnovidnost“. Poškození míčkem můžete zvýšit získáním vylepšení „prorážení“. Každá úroveň tohoto vylepšení o +50 % zrychluje nárůst komba.",
    "upgrades.superhot.name": "SUPER HOT",
    "upgrades.superhot.tooltip": "Čas se pohybuje, jen když se pohybuje pálka.",
    "upgrades.superhot.verbose_description": "SUPER HOT SUPER HOT SUPER HOT SUPER HOT",
    "upgrades.telekinesis.name": "Telekineze",
    "upgrades.telekinesis.tooltip": "Pozice pálky ovlivňuje míček",
    "upgrades.telekinesis.verbose_description": "Ovládáte míček, dokud letí nahoru. Efekt je silnější, když je míček ve spodní polovině obrazovky.",
    "upgrades.thomas.name": "Svatý Tomáš",
    "upgrades.thomas.tooltip": "Polovina cihliček je při ztrátě míčku vzkříšena.",
    "upgrades.thomas.verbose_description": "Název vylepšení je dvojitý odkaz, protože svatý Tomáš je patronem architektů a také údajně pochyboval o Kristově vzkříšení. Což docela pasuje na obětování míčku, které postaví víc cihliček.",
    "upgrades.three_cushion.name": "Trojband",
    "upgrades.three_cushion.tooltip": "Více mincí, pokud cihličky trefujete jen nepřímo",
    "upgrades.three_cushion.verbose_description": "+1 kombo za cihličku za každý odraz od stěny, který míček absolvoval před zasažením té cihličky. Omezeno na +{{max}} kombo za cihličku. Kombo se zresetuje, pokud rozbijete cihličku bez předchozího odrazu od stěny.",
    "upgrades.top_is_lava.name": "Nebe je limit",
    "upgrades.top_is_lava.tooltip": "Více mincí, pokud nezasáhnete vršek",
    "upgrades.top_is_lava.verbose_description": "Kdykoli rozbijete cihličku, zvýší se vaše kombo o jedna. Vaše kombo se ale resetuje, jakmile se míček dotkne horního okraje obrazovky.\n\nJakmile je vaše kombo vyšší než minimum, objeví se navrchu červený pruh, aby vám připomínal, že ho nemáte trefovat.\n\nNa úrovni 2 okraj úplně zmizí a vaše míčky a mince se mohou ztratit.",
    "upgrades.trampoline.name": "Trampolína",
    "upgrades.trampoline.tooltip": "Více mincí, pokud odrážíte míčky jen od cihel a pálky",
    "upgrades.trampoline.verbose_description": "+{{lvl}} kombo za odraz od pálky, -{{lvl}} kombo za odraz na jakékoli straně. Jedno ze vzácných vylepšení komba, které nepřidává podmínku pro reset",
    "upgrades.transparency.name": "Průhlednost",
    "upgrades.transparency.tooltip": "Míček je v horní části obrazovky neviditelný. Kombo roste o {{percent}} % rychleji",
    "upgrades.transparency.verbose_description": "Míček se v horní části obrazovky stává průhledným.\n +{{percent}} % mincí.\nVyšší úrovně učiní míček průhledným dříve a zvyšují bodový bonus.",
    "upgrades.trickledown.name": "Stékání",
    "upgrades.trickledown.tooltip": "Mince se objevují navrchu obrazovky.",
    "upgrades.trickledown.verbose_description": "Mince mohou sedět na vrcholu cihličky, pokud jsou cihličky v horní řadě; v takovém případě spadnou dolů, jakmile tuto cihličku rozbijete.",
    "upgrades.unbounded.name": "Polstrování",
    "upgrades.unbounded.tooltip": "Přidává prostor vlevo a vpravo vedle úrovně, ale vaše pálka se až tam nedostane.",
    "upgrades.unbounded.verbose_description": "Jiné vylepšení vám může pomoci prodloužit dosah vaší pálky.",
    "upgrades.varied_diet.name": "Rozmanitá strava",
    "upgrades.varied_diet.tooltip": "+{{plus}} kombo za rozbitou cihličku, pokud má jinou barvu než míček, jinak −{{minus}}",
    "upgrades.varied_diet.verbose_description": "Toto vylepšení nepřidává podmínku pro reset.",
    "upgrades.vibrant_neighborhood.name": "Živé sousedství",
    "upgrades.vibrant_neighborhood.tooltip": "Více mincí, pokud jsou mince blízko mincí jiné barvy.",
    "upgrades.vibrant_neighborhood.verbose_description": "Při rozbití cihličky se kombo zvýší o počet cihliček jiné barvy ve čtverci 3×3 kolem rozbité cihličky. Pokud jsou okolo všechny cihličky stejné barvy a úroveň má více než jednu barvu, kombo se zresetuje. Cihličky bez sousedů při rozbití kombo nezmění.",
    "upgrades.viscosity.name": "Viskozita",
    "upgrades.viscosity.tooltip": "Pomalejší padání mincí",
    "upgrades.viscosity.verbose_description": "Mince obvykle zrychlují gravitací a výbuchy na poměrně vysokou rychlost.\n\nToto vylepšení je neustále zpomaluje, jako by byly v nějaké viskózní kapalině.\n\nTím je jejich chytání jednodušší a dobře se to kombinuje s vylepšeními, která ovlivňují pohyb mincí.",
    "upgrades.wind.name": "Vítr",
    "upgrades.wind.tooltip": "Pozice pálky vytváří vítr",
    "upgrades.wind.verbose_description": "Vítr závisí na pozici pálky: vlevo fouká doleva, vpravo fouká doprava. Ovlivňuje jak míčky, tak mince.",
    "upgrades.wrap_left.name": "Obtočit vlevo",
    "upgrades.wrap_left.tooltip": "Zasažením levého okraje se míček teleportuje na pravý okraj",
    "upgrades.wrap_left.verbose_description": "Vyšší úroveň teleportuje i mince.",
    "upgrades.wrap_right.name": "Obtočit vpravo",
    "upgrades.wrap_right.tooltip": "Zasažením pravého okraje se míček teleportuje na levý okraj",
    "upgrades.wrap_right.verbose_description": "Vyšší úroveň teleportuje i mince.",
    "upgrades.wrap_up.name": "Obtočit nahoře",
    "upgrades.wrap_up.tooltip": "Dotykem horního okraje obrazovky se míček teleportuje těsně nad pálku.",
    "upgrades.wrap_up.verbose_description": "To se nezapočítává jako dotyk pálky. Na 2. úrovni se teleportují také mince.",
    "upgrades.yoyo.name": "Jojo",
    "upgrades.yoyo.tooltip": "Míček padá směrem k pálce",
    "upgrades.yoyo.verbose_description": "Jde o opak telekineze, ovládáte míček, když padá zpět dolů. Účinek je silnější, když je míček navrchu obrazovky a horizontálně daleko od pálky.",
    "upgrades.zen.name": "Zen",
    "upgrades.zen.tooltip": "Více mincí, pokud nespouštíte bomby",
    "upgrades.zen.verbose_description": "+{{lvl}} kombo každé 3 s, reset, když dojde k výbuchu"
}
