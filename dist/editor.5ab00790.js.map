    "upgrades.forgiving.name": "Про нас",
    "upgrades.forgiving.tooltip": "Перший раз, коли м'яч не досягає жодної цеглинки на рівні, ігнорується.",
    "upgrades.forgiving.verbose_description": "",
    "upgrades.fountain_toss.name": "Фонтани",
    "upgrades.fountain_toss.tooltip": "Знайте комбо, коли ви пропустили монети.",
    "upgrades.fountain_toss.verbose_description": "Коли ви пропустили монету і гребінець під рівнем*30, ваш гребінець має ймовірність рівня / комбо виростити по одному.",
    "upgrades.fumes.name": "",
    "upgrades.fumes.tooltip": "",
    "upgrades.fumes.verbose_description": "",
    "upgrades.ghost_coins.name": "Привидні монети",
    "upgrades.ghost_coins.tooltip": "Монети повільно проходять через цеглу",
    "upgrades.ghost_coins.verbose_description": "Це не помилка, це функція ! Монети пролітають через цеглу повільно. Вищі рівні дозволяють швидше рухатися.",
    "upgrades.golden_goose.name": "Золотий гус",
    "upgrades.golden_goose.tooltip": "Монети телепорту на м'яч після удару цегли",
    "upgrades.golden_goose.verbose_description": "Коли монета потрапляє на цеглу, телепорт, що монета до найближчого м'яча. На рівні два, монети телепорту після удару теж.",
    "upgrades.gravity_falls.name": "",
    "upgrades.gravity_falls.tooltip": "",
    "upgrades.gravity_falls.verbose_description": "",
    "upgrades.happy_family.name": "Сім'я",
    "upgrades.happy_family.tooltip": "Більше монет, якщо ви зберігаєте всі кулі в грі.",
    "upgrades.happy_family.verbose_description": "+1 combo на додатковий м'яч на весло бун. Combo скидає, коли м'яч втратив. Тільки м'яч вище 1 дати combo.",
    "upgrades.hardhat.name": "",
    "upgrades.hardhat.tooltip": "",
