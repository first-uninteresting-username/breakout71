    "upgrades.palette.name": "",
    "upgrades.palette.tooltip": "",
    "upgrades.palette.verbose_description": "",
    "upgrades.passive_income.name": "Pasívny príjem",
    "upgrades.passive_income.tooltip": "Viac mincí, ale pohyblivý paddleboard nezachytí guľôčky alebo mince",
    "upgrades.passive_income.verbose_description": "+{{lvl}} combo / tehla rozbité, paddleboard je nemateriál {{time}}s po pohybe. Niektoré perks môže pomôcť guľôčky robiť to, čo chcete, bez toho, aby nič neurobil.",
    "upgrades.picky_eater.name": "Picky jedér",
    "upgrades.picky_eater.tooltip": "Viac mincí, ak zlomíte tehly farbu podľa farby",
    "upgrades.picky_eater.verbose_description": "Vždy, keď rozbijete tehlu rovnakú farbu ako vaša lopta, vaše česano zvyšuje počet farieb na obrazovke mínus jeden.\nAk je to iná farba, lopta trvá, že nová farba, ale hrebeňo resetuje, pokiaľ neboli žiadne tehly vľavo z farby lopty.\nAkonáhle dostanete hrebeň vyššie ako vaše minimum, tehál nesprávnej farby dostane červenú hranicu.\nAk máte viac ako jednu guľu, všetci prepínajú farbu, keď jeden z nich hity tehlu.",
    "upgrades.pierce.name": "Piercing",
    "upgrades.pierce.tooltip": "Loptové móly {{count}} tehly po páde paddle",
    "upgrades.pierce.verbose_description": "Lopta zvyčajne odrazí hneď, ako sa niečo dotkne. S týmto atramentom bude pokračovať v jeho trajektórii až 3 tehly rozbité.\n\nPotom to bude odraziť na 4. tehál, a budete musieť dotknúť paddleboard resetovať pult.",
    "upgrades.pierce_above_paddle.name": "",
    "upgrades.pierce_above_paddle.tooltip": "",
    "upgrades.pierce_above_paddle.verbose_description": "",
    "upgrades.pierce_color.name": "Farba pierce",
    "upgrades.pierce_color.tooltip": "Lopta prechádza tehálmi rovnakej farby",
    "upgrades.pierce_color.verbose_description": "",
    "upgrades.pierce_left.name": "",
    "upgrades.pierce_left.tooltip": "",
    "upgrades.pierce_left.verbose_description": "",
