    "upgrades.ball_attracts_coins.name": "Bolas atraem moedas",
    "upgrades.ball_attracts_coins.tooltip": "Moedas seguem a bola mais próxima",
    "upgrades.ball_attracts_coins.verbose_description": "Isto poderia ser usado para \"pintar ao redor\" as bolas com moedas, se combinar com \"metamorfose\" e \"moedas fantasmas\". Também funciona como um substituto para o ímã de moeda.",
    "upgrades.ball_repulse_ball.name": "Espaço pessoal",
    "upgrades.ball_repulse_ball.tooltip": "Bolas repelem bolas",
    "upgrades.ball_repulse_ball.verbose_description": "As bolas que estão a menos que um quarto da largura do ercã vão começar a repelir-se. A força de repulsão é mais forte se elas estão perto umas das outras. Partículas serão lançadas para simbolizar a aplicação desta força. Esta vantagem só é oferecida se tem mais do que uma bola.",
    "upgrades.base_combo.name": "Fundações fortes",
    "upgrades.base_combo.tooltip": "Mais 3 moedas por tijolo quebrado",
    "upgrades.base_combo.verbose_description": "A sua combinação começa normalmente em 1 no início do nível e reinicia para 1 se não acertar nada. Com esta vantagem, a combinação começa 3 pontos mais alto, então sempre terá pelo menos 4 moedas por tijolo. Sempre que o seu combo redefinir, ele vai voltar para 4 e não 1. A sua bola vai brilhar um pouco para indicar que a sua combinação é maior que uma. No nível 2, adiciona 4 moedas, então 5, depois 6…",
    "upgrades.bigger_balls.name": "",
    "upgrades.bigger_balls.tooltip": "",
    "upgrades.bigger_balls.verbose_description": "",
    "upgrades.bigger_explosions.name": "Cabum",
    "upgrades.bigger_explosions.tooltip": "Explosões maiores",
    "upgrades.bigger_explosions.verbose_description": "A explosão normal limpa uma área de 3x3, com isto torna-se uma área de 5x5, e a propulsão nas moedas também é significativamente maior. O ecrã piscará após cada explosão (exceto no modo básico)",
    "upgrades.bigger_puck.name": "Reme maior",
    "upgrades.bigger_puck.tooltip": "Apanhe moedas mais facilmente",
    "upgrades.bigger_puck.verbose_description": "Um reme maior facilita nunca perder a bola e apanhar mais moedas, e também para mirar mais precisamente (o ângulo da bola só depende de onde ela atinge o reme).",
    "upgrades.bricks_attract_ball.name": "Blocos atraem bolas",
    "upgrades.bricks_attract_ball.tooltip": "A bola vai para tijolos mais próximos",
    "upgrades.bricks_attract_ball.verbose_description": "A bola vai para o primeiro {{count}} tijolos que vai bater. O efeito é mais forte em níveis mais elevados. O número de tijolos que pode bater antes que o efeito pare também é maior. O efeito diminui quando a bola atinge o reme.",
    "upgrades.bricks_attract_coins.name": "Blocos atraem moedas",
    "upgrades.bricks_attract_coins.tooltip": "Mantêm elas lá em cima",
    "upgrades.bricks_attract_coins.verbose_description": "Moedas serão atraídas para tijolos próximos. Em níveis posteriores, a atração é mais forte.",
    "upgrades.buoy.name": "Boia",
    "upgrades.buoy.tooltip": "Moedas flutuam por {{duration}} segundos na linha inferior.",
    "upgrades.buoy.verbose_description": "O efeito é mais visível no modo para telemóvel",
    "upgrades.chill.name": "Calma",
    "upgrades.chill.tooltip": "Não há mais melhorias, níveis ilimitados.",
    "upgrades.chill.verbose_description": "A bola também acelera muito mais devagar.",
    "upgrades.clairvoyant.name": "Clarividência",
    "upgrades.clairvoyant.tooltip": "Veja os próximos níveis, HP dos tijolos e direção da bola",
    "upgrades.clairvoyant.verbose_description": "Ajuda-o a escolher as melhores melhorias e ver a vida restante de blocos resistentes. Níveis 2 e 3 trazem conhecimentos adicionais de uso duvidoso (acessível usando \"sem limites\")",
    "upgrades.coin_magnet.name": "Imã de moedas",
    "upgrades.coin_magnet.tooltip": "O reme atrai moedas",
    "upgrades.coin_magnet.verbose_description": "Direciona as moedas para o reme. O efeito é mais forte se a moeda já estiver perta.",
    "upgrades.compound_interest.name": "Juros compostos",
    "upgrades.compound_interest.tooltip": "Mais moedas se apanhar todas as moedas",
    "upgrades.compound_interest.verbose_description": "O seu combo vai crescer por um a cada vez que quebrar um tijolo, gerando mais e mais moedas a cada tijolo que quebrar.\nCertifique-se de apanhar cada uma dessas moedas com o seu reme, pois qualquer moeda perdida irá reiniciar o seu combo.\nUma vez que o seu combo estiver acima do mínimo, o fundo da área de jogo terá uma linha vermelha para lembrar que as moedas não devem cair.",
    "upgrades.concave_puck.name": "Reme côncavo",
    "upgrades.concave_puck.tooltip": "Melhora a precisão vertical",
    "upgrades.concave_puck.verbose_description": "As bolas começam o nível indo direto para cima e quicam com menos ângulo.",
    "upgrades.corner_shot.name": "Escanteio",
    "upgrades.corner_shot.tooltip": "Permite que o reme adentre nas bordas do ecrã",
    "upgrades.corner_shot.verbose_description": "Ajuda com a mira nos cantos. Mais níveis permitem que entre mais profundamente.",
    "upgrades.disco_ball.name": "",
    "upgrades.disco_ball.tooltip": "Cada quicada na parede muda a cor da bola",
    "upgrades.disco_ball.verbose_description": "A bola vai alternar entre as cores do arco-íris.",
    "upgrades.double_or_nothing.name": "Tudo ou nada",
    "upgrades.double_or_nothing.tooltip": "O combo cresce duas vezes mais rápido, mas se zerar, a partida termina.",
    "upgrades.double_or_nothing.verbose_description": "O reinício do combo só conta quando a sua combinação estiver acima do mínimo",
    "upgrades.etherealcoins.name": "Moedas, no Espaço",
    "upgrades.etherealcoins.tooltip": "As moedas não são mais afetadas pela gravidade",
    "upgrades.etherealcoins.verbose_description": "As moedas manterão a sua velocidade mesmo após rebater várias vezes e já não serão afetadas pela gravidade.",
    "upgrades.extra_levels.name": "mais 5 minutos",
    "upgrades.extra_levels.tooltip": "Jogue {{count}} níveis ao invés de 7",
    "upgrades.extra_levels.verbose_description": "O jogo padrão pode durar um máximo de 7 níveis, após isto o jogo está termina.\n\nCada nível desta vantagem permite que jogue mais uma fase. Os últimos níveis são muitas vezes aqueles onde faz mais pontuação, então a diferença pode ser dramática.",
    "upgrades.extra_life.name": "Vida extra",
    "upgrades.extra_life.tooltip": "Grava a sua última bola se estiver prestes a cair",
    "upgrades.extra_life.verbose_description": "A vida será consumida no processo. Vidas adicionais aparecem como linhas atrás do reme.",
    "upgrades.flyswatter.name": "Mata-moscas",
    "upgrades.flyswatter.tooltip": "Toque no lado esquerdo para aplicar gravidade para todas as bolas.",
    "upgrades.flyswatter.verbose_description": "",
    "upgrades.forgiving.name": "Errar é humano",
    "upgrades.forgiving.tooltip": "A primeira vez que a bola falha todos os blocos de uma fase é ignorada.",
    "upgrades.forgiving.verbose_description": "Se o seu arremesso perdido for ignorado, ainda estará elegível para a medalha dourada nesse critério.",
    "upgrades.fountain_toss.name": "Fonte dos desejos",
    "upgrades.fountain_toss.tooltip": "Ganhe combo quando perder algumas moedas.",
    "upgrades.fountain_toss.verbose_description": "Quando perder uma moeda e o seu combo estiver abaixo do nível*30, o seu nível/combo pode crescer por um.",
    "upgrades.fumes.name": "",
    "upgrades.fumes.tooltip": "",
    "upgrades.fumes.verbose_description": "",
    "upgrades.ghost_coins.name": "Moedas fantasma",
    "upgrades.ghost_coins.tooltip": "Moedas passam lentamente através de tijolos",
    "upgrades.ghost_coins.verbose_description": "Não é um bug, é uma função! As moedas voam através de tijolos lentamente. Níveis mais elevados permitem que eles se movam mais rápido.",
    "upgrades.golden_goose.name": "Gansa dourada",
    "upgrades.golden_goose.tooltip": "Moedas teletransportam-se para a bola depois de tocar num tijolo",
    "upgrades.golden_goose.verbose_description": "Sempre que uma moeda tocar num tijolo, essa moeda teletransportará-se para a bola mais próxima. No nível dois, as moedas teletransportam-se depois de bater nos lados também.",
    "upgrades.gravity_falls.name": "Bola gravitacional",
    "upgrades.gravity_falls.tooltip": "Bolas que tocarem no topo recebem gravidade",
    "upgrades.gravity_falls.verbose_description": "",
    "upgrades.happy_family.name": "Família feliz",
    "upgrades.happy_family.tooltip": "Mais moedas se vocẽ manter todas as bolas na partida.",
    "upgrades.happy_family.verbose_description": "+1 combo por cada bola quicada mais no reme. Combo reinicia quando uma bola é perdida. Só a bola acima de 1 dá combinação.",
    "upgrades.hardhat.name": "",
    "upgrades.hardhat.tooltip": "",
    "upgrades.hardhat.verbose_description": "",
    "upgrades.helium.name": "Hélio",
    "upgrades.helium.tooltip": "Gravidade limitada nos lados do reme",
    "upgrades.helium.verbose_description": "No nível 1, a gravidade é reduzida. No nível 2, as moedas flutuam lentamente. No nível 3 elas realmente voam.",
    "upgrades.hot_start.name": "Arrancada",
    "upgrades.hot_start.tooltip": "Mais moedas se vencer o nível antes de 30 segundos",
    "upgrades.hot_start.verbose_description": "No início de cada nível, o seu combo vai começar com +{{start}} pontos, mas então cada segundo será diminuído por {{loss}}. O efeito empilha-se com outras vantagens.",
    "upgrades.implosions.name": "Implosões",
    "upgrades.implosions.tooltip": "Explosões sugam moedas ao invés de propulsioná-las",
    "upgrades.implosions.verbose_description": "A força de explosão é aplicada do outro modo. Mais níveis atuam como uma \"explosão maior\"",
    "upgrades.instant_explosion.name": "",
    "upgrades.instant_explosion.tooltip": "",
    "upgrades.instant_explosion.verbose_description": "",
    "upgrades.left_is_lava.name": "Evite o lado esquerdo",
    "upgrades.left_is_lava.tooltip": "Mais moedas se não tocar no lado esquerdo",
    "upgrades.left_is_lava.verbose_description": "Sempre que quebrar um bloco, o seu combo vai aumentar por um, então vai ter mais uma moeda de todos os blocos que quebrar.\n\nNo entanto, o seu combo irá reiniciar assim que a sua bola atingir o lado esquerdo.\n\nQuando o seu combo aumenta, o lado esquerdo fica vermelho para fazer lembrar que deve evitá-lo\n\nNo nível 2, a borda é completamente removida e as suas bolas e moedas podem ser perdidas.\n\nEsta melhoria afeta a direção inicial da bola.",
    "upgrades.limitless.name": "Sem limites",
    "upgrades.limitless.tooltip": "Aumentar o nível máximo de todas as melhorias por {{lvl}}",
    "upgrades.limitless.verbose_description": "Escolher esta vantagem também aumenta o seu próprio limite por um, deixando-a escolher novamente.",
    "upgrades.metamorphosis.name": "Metamorfose",
    "upgrades.metamorphosis.tooltip": "Cada moeda pode manchar {{lvl}} tijolo(s) com a sua cor",
    "upgrades.metamorphosis.verbose_description": "Com este vantagem, as moedas serão da cor do tijolo de que vieram e irão colorir o primeiro tijolo que tocam. Moedas surgem com a mesma velocidade da bola que as invocou, o que significa que pode mirar nos tijolos que quer \"pintar\". No nível 1, cada moeda pode colorir 1 tijolo antes de serem \"gastas\" e aparecerem ocas.",
    "upgrades.minefield.name": "Campo Minado",
    "upgrades.minefield.tooltip": "+{{percent}}% de moedas por bombas no ecrã",
    "upgrades.minefield.verbose_description": "As bombas são contadas enquanto também estão a explodir.",
    "upgrades.multiball.name": "Multi bolas",
    "upgrades.multiball.tooltip": "Comece cada nível com {{count}} bolas.",
    "upgrades.multiball.verbose_description": "Assim que largar a bola no Breakout 71, perde.\n\nCom esta vantagem, tem duas bolas e assim pode dar-se ao luxo de perder uma.\n\nAs bolas perdidas voltam no próximo nível.\n\nTer mais que uma bola torna outras vantagens disponíveis e é claro, limpa o nível mais rápido.",
    "upgrades.nbricks.name": "Passos de bebé",
    "upgrades.nbricks.tooltip": "Mais moedas se terminar a fase lentamente.",
    "upgrades.nbricks.verbose_description": "+{{gain}} combo por bloco quebrado. O combo reinicia se uma bola quebrar mais que {{max}} blocos entre duas quicadas na raquete ou na parede. Tome cuidado, explosões também contam.",
    "upgrades.one_more_choice.name": "Escolha extra",
    "upgrades.one_more_choice.tooltip": "Mais opções de melhorias",
    "upgrades.one_more_choice.verbose_description": "Cada menu de melhorias terá mais uma opção. Não aumenta o número de melhorias que pode escolher.",
    "upgrades.ottawa_treaty.name": "Tratado de Ottawa",
    "upgrades.ottawa_treaty.tooltip": "Quebrar um tijolo perto de uma bomba desarma-a",
    "upgrades.ottawa_treaty.verbose_description": "A bomba próxima será substituída por um bloco colorido. Se tiver sapador, a bola perderá o seu efeito até a próxima rebatida. Só uma bomba pode ser substituída por vez.",
    "upgrades.paddle_up_combo.name": "Olhe direto",
    "upgrades.paddle_up_combo.tooltip": "+1 por bloco quebrado diretamente acima da raquete, caso contrário, reinicia",
    "upgrades.paddle_up_combo.verbose_description": "",
    "upgrades.palette.name": "Paleta",
    "upgrades.palette.tooltip": "+1 de combo para cada cor de bloco diferente no ecrã; o combo é reiniciado se houver apenas uma cor",
    "upgrades.palette.verbose_description": "Tome cuidado! Alguns níveis só possuem uma única cor. O primeiro e o último bloco acertado não contam.",
    "upgrades.passive_income.name": "Renda passiva",
    "upgrades.passive_income.tooltip": "Mais moedas, porém um reme que se move não apanha moedas ou bolas",
    "upgrades.passive_income.verbose_description": "+{{lvl}} de combo por tijolo quebrado, o reme é imaterial por {{time}} segundos após se mover. Algumas vantagens podem fazem as bolas se moverem sem nenhuma interação sua.",
    "upgrades.picky_eater.name": "Chato para comer",
    "upgrades.picky_eater.tooltip": "Mais moedas se quebrar tijolos da cor da bola",
    "upgrades.picky_eater.verbose_description": "Sempre que quebrar um tijolo com a mesma cor que a sua bola, o seu combo aumenta pelo número de cores no ecrã menos uma.\nSe for uma cor diferente, a bola fica com a nova cor, mas o combo reinicia, a menos que não haja tijolos da cor da bola.\nUma vez que obter um combo superior ao seu mínimo, os tijolos de cor diferente obterão uma borda vermelha.\nSe tem mais que uma bola, todos eles mudarão de cor sempre que uma delas atingir um tijolo.",
    "upgrades.pierce.name": "Bola perfurante",
    "upgrades.pierce.tooltip": "Bola perfura {{count}} tijolos após quicar no reme",
    "upgrades.pierce.verbose_description": "A bola normalmente quica assim que bate em algo. Com esta vantagem, ela continuará a sua trajetória até quebrar 3 tijolos.\n\nDepois disso, ela vai quicar no 4º tijolo e precisa de rebater com o reme para redefinir o contador.",
    "upgrades.pierce_above_paddle.name": "Janela de oportunidade",
    "upgrades.pierce_above_paddle.tooltip": "Blocos quebram mais facilmente quando estão diretamente acima da raquete.",
    "upgrades.pierce_above_paddle.verbose_description": "",
    "upgrades.pierce_color.name": "Cor perfurante",
    "upgrades.pierce_color.tooltip": "A bola atravessa tijolos da mesma cor",
    "upgrades.pierce_color.verbose_description": "A bola atravessa os blocos da mesma cor sem obstáculos até que a sua “carga” se esgote. Em seguida, ela precisa ricochetear na raquete para recarregar.",
    "upgrades.pierce_left.name": "Perfurar pela esquerda",
    "upgrades.pierce_left.tooltip": "Blocos são quebrados mais facilmente quando são acertados pela esquerda",
    "upgrades.pierce_left.verbose_description": "Esta melhoria impacta a direção inicial da bola. A bola irá acelerar quando o efeito for ativado.",
    "upgrades.pierce_right.name": "Perfurar pela direita",
    "upgrades.pierce_right.tooltip": "Blocos são quebrados mais facilmente quando são acertados pela direita",
    "upgrades.pierce_right.verbose_description": "Esta melhoria afeta a direção inicial da bola. A bola acelerará quando o efeito for ativado.",
    "upgrades.pierce_top.name": "Perfurar por cima",
    "upgrades.pierce_top.tooltip": "Blocos são quebrados mais facilmente quando são acertados pelo topo",
    "upgrades.pierce_top.verbose_description": "A bola vai acelerar quando o efeito for acionado.",
    "upgrades.puck_repulse_ball.name": "Aterrsagem macia",
    "upgrades.puck_repulse_ball.tooltip": "Reme repele bolas",
    "upgrades.puck_repulse_ball.verbose_description": "Quando uma bola chegar perto do reme, irá começar a desacelerar e até mesmo potencialmente quicar sem encostar no reme.",
    "upgrades.rainbow.name": "Arco-íris",
    "upgrades.rainbow.tooltip": "Moedas surgem com cor arco-íris.",
    "upgrades.rainbow.verbose_description": "Cada nível aumenta a proporção de moedas coloridas. A cor depende do tempo de nível.",
    "upgrades.reach.name": "De cima para baixo",
    "upgrades.reach.tooltip": "Mais moedas se evitar a linha mais baixa de tijolos",
    "upgrades.reach.verbose_description": "Tocar os N tijolos da linha mais baixa reinicia o combo. Caso contrário, combo +N.\n\nSe houver apenas uma linha de tijolos, ou se a linha mais baixa de tijolos cobrir toda a largura do jogo, depois esta melhoria não faz nada. Caso contrário, quebrar a linha mais baixa reinicia o combo, ao quebrar qualquer outra coisa aumenta o combo pelo número de tijolos presentes na linha mais baixa.\n\nA linha mais baixa será destacada em vermelho.",
    "upgrades.refill.name": "Recarga",
    "upgrades.refill.tooltip": "",
    "upgrades.refill.verbose_description": "",
    "upgrades.respawn.name": "Reaparecimento",
    "upgrades.respawn.tooltip": "{{percent}}% dos tijolos reaparecem após {{delay}} segundos.",
    "upgrades.respawn.verbose_description": "Um efeito de partícula irá mostrá-lo onde os tijolos aparecerão.",
    "upgrades.right_is_lava.name": "Evite o lado direito",
    "upgrades.right_is_lava.tooltip": "Mais moedas se não tocar no lado direito",
    "upgrades.right_is_lava.verbose_description": "Sempre que quebrar um bloco, o seu combo vai aumentar por um, então vai ter mais uma moeda para todos os próximos blocos que quebrar.\n\nNo entanto, p seu combo irá reiniciar assim que a sua bola tocar no lado direito.\n\nAssim que o seu combo aumentar, o lado direito vai ficar vermelho para lembrá-lo de que deve evitar tocar nele.\n\nNo nível 2, a borda é completamente removida e as suas bolas e moedas podem perder-se.\n\nEsta melhoria afeta a direção inicial da bola.",
    "upgrades.round_bricks.name": "Blocos redondos",
    "upgrades.round_bricks.tooltip": "Os blocos ficam redondos",
    "upgrades.round_bricks.verbose_description": "",
    "upgrades.sacrifice.name": "Sacrifício",
    "upgrades.sacrifice.tooltip": "",
    "upgrades.sacrifice.verbose_description": "",
    "upgrades.sapper.name": "Sapador",
    "upgrades.sapper.tooltip": "O primeiro tijolo quebrado vira uma bomba.",
    "upgrades.sapper.verbose_description": "Em vez de apenas desaparecer, o primeiro tijolo que quebrar será substituído por um tijolo-bomba. Quicar a bola no reme recarrega o efeito. Aumentar o nível desta vantagem permitirá que ponha mais bombas.",
    "upgrades.shocks.name": "Choques",
    "upgrades.shocks.tooltip": "Colisões explosivas de bolas",
    "upgrades.shocks.verbose_description": "Sempre que duas bolas colidem, trocam de velocidade entre si, geram uma explosão e ganham velocidade adicional para se separarem.",
    "upgrades.shunt.name": "Derivação",
    "upgrades.shunt.tooltip": "Mantenha {{percent}}% do seu combo entre níveis",
    "upgrades.shunt.verbose_description": "Se também tiver arrancada, o início quente é apenas adicionado à combinação atual",
    "upgrades.side_flip.name": "Destro",
    "upgrades.side_flip.tooltip": "+1 combo por bloco quebrado. O combo reinicia se acertar qualquer bloco pelo lado esquerdo.",
    "upgrades.side_flip.verbose_description": "Explosões e acertos que não quebraram o bloco não contam como reinício de combo. Esta melhoria afeta a direção inicial da bola.",
    "upgrades.side_kick.name": "Mão esquerda",
    "upgrades.side_kick.tooltip": "+1 combo por bloco quebrado. O combo reinicia se quebrar um bloco pelo lado direito.",
    "upgrades.side_kick.verbose_description": "Explosões e acertos que não quebraram o bloco não contam como reinício de combo. Esta melhoria afeta a direção inicial da bola.",
    "upgrades.skip_last.name": "Limpeza fácil",
    "upgrades.skip_last.tooltip": "O último tijolo autodestruirá-se",
    "upgrades.skip_last.verbose_description": "Precisa quebrar todos os tijolos para ir para o próximo nível. No entanto, pode ser difícil acertar os últimos.\nCada nível desta vantagem aumenta o número de tijolos que se destroem sozinhos.\nLimpar um nível rapidamente traz mais opções de melhorias. Nunca errar os tijolos também é muito benéfico.\n\nEntão, se achar difícil quebrar os últimos tijolos, obter esta vantagem pode ajudar.",
    "upgrades.slow_down.name": "Bola mais lenta",
    "upgrades.slow_down.tooltip": "A bola move-se mais lentamente",
    "upgrades.slow_down.verbose_description": "A bola começa relativamente lenta, mas a cada nível ela fica um pouco mais rápida.\n\nTambém vai acelerar se passar muito tempo num nível.\n\nEsta vantagem a faz mais fácil de conduzir.\n\nPode obtê-la no início de todas as partidas ativando o modo infantil nas configurações.",
    "upgrades.smaller_puck.name": "Reme menor",
    "upgrades.smaller_puck.tooltip": "{{percent}}% mais moedas",
    "upgrades.smaller_puck.verbose_description": "Diminui o reme, o que, em teoria, faz rebater nos cantos mais fácil, mas, na verdade, só aumenta a dificuldade.\n\nÉ por isso que também obtém um bom bónus que gera +50% moedas.",
    "upgrades.soft_brush.name": "",
    "upgrades.soft_brush.tooltip": "",
    "upgrades.soft_brush.verbose_description": "",
    "upgrades.soft_reset.name": "Reinício progressivo",
    "upgrades.soft_reset.tooltip": "Mantenha {{percent}}% do seu combo quando ele reiniciar",
    "upgrades.soft_reset.verbose_description": "Reduz o impacto de um reinício de combo.",
    "upgrades.soft_touch.name": "Toque suave",
    "upgrades.soft_touch.tooltip": "",
    "upgrades.soft_touch.verbose_description": "",
    "upgrades.steering.name": "Direção",
    "upgrades.steering.tooltip": "As bolas viram quando o reme se move",
    "upgrades.steering.verbose_description": "A posição do reme influencia diretamente a direção do movimento das bolas. No nível 2 para cima, verá uma linha mostrando a direção da sua bola.",
    "upgrades.sticky_coins.name": "Moedas pegajosas",
    "upgrades.sticky_coins.tooltip": "Moedas grudam em tijolos da mesma cor",
    "upgrades.sticky_coins.verbose_description": "No nível 2, elas grudam em tijolos de qualquer cor",
    "upgrades.streak_shots.name": "Sequência de rebatidas",
    "upgrades.streak_shots.tooltip": "Mais moedas se quebrar muitos tijolos ao mesmo tempo",
    "upgrades.streak_shots.verbose_description": "Cada vez que quebrar um tijolo, a sua combinação aumenta por um.\n\nNo entanto, assim que a bola tocar no seu reme, o combo reinicia.\n\nUma vez que o seu combo subir acima do valor base, o seu reme terá uma borda vermelha para lembrá-lo de que tocar na bola destruirá o seu combo.",
    "upgrades.sturdy_bricks.name": "Blocos resistentes",
    "upgrades.sturdy_bricks.tooltip": "+{{lvl}} tijolos Moedas HP, +{{percent}}%",
    "upgrades.sturdy_bricks.verbose_description": "Cada nível desta vantagem adiciona HP para todos os tijolos. Pode ver o número de HP com a vantagem \"clarividente\". Também pode aumentar o dano da bola, obtendo a vantagem \"penetrar\". Cada nível desta vantagem gera +50% moedas.",
    "upgrades.superhot.name": "SUPER HOT",
    "upgrades.superhot.tooltip": "O tempo move-se apenas quando o reme se move.",
    "upgrades.superhot.verbose_description": "SUPER HOT SUPER HOT SUPER HOT SUPER HOT",
    "upgrades.telekinesis.name": "Telecinese",
    "upgrades.telekinesis.tooltip": "A posição do reme influencia a bola",
    "upgrades.telekinesis.verbose_description": "Controla a bola enquanto está a subir. O efeito é mais forte quando a bola está na metade inferior do ecrã.",
    "upgrades.thomas.name": "São Tomé",
    "upgrades.thomas.tooltip": "Metade dos blocos ressuscitam quando uma bola for perdida.",
    "upgrades.thomas.verbose_description": "O nome da vantagem é uma dupla referência, já que o apóstolo Tomé é o santo padroeiro dos arquitetos e, como dizem, duvidou da ressurreição de Cristo. Muito apropriado para um sacrifício de bola que permite posicionar mais tijolos.",
    "upgrades.three_cushion.name": "Três almofadas",
    "upgrades.three_cushion.tooltip": "Mais moedas se bater tijolos apenas indiretamente",
    "upgrades.three_cushion.verbose_description": "+1 de combo por bloco por cada quicada lateral que a bola deu antes de atingir esse bloco. Limitado a +{{max}} de combo por bloco. O combo é reiniciado se quebrar um bloco sem que a bola tenha primeiro quicado numa das laterais.",
    "upgrades.top_is_lava.name": "O céu é o limite",
    "upgrades.top_is_lava.tooltip": "Mais moedas se evitar acertar o topo",
    "upgrades.top_is_lava.verbose_description": "Sempre que quebrar um tijolo, o seu combo vai aumentar por um. No entanto, o seu combo irá reiniciar assim que a sua bola atingir o topo do ecrã.\n\nQuando o seu combo está acima do mínimo, uma barra vermelha aparecerá no topo para lembrá-lo de que deve evitar acertá-lo.\n\nNo nível 2, a borda é removida completamente e as suas bolas e moedas podem ser perdidas.",
    "upgrades.trampoline.name": "Trampolim",
    "upgrades.trampoline.tooltip": "+{{lvl}} combo cada vez que a bolar quicar do reme, -{{lvl}} combo cada vez que a bola quicar das bordas",
    "upgrades.trampoline.verbose_description": "+{{lvl}} combo por quicada no reme, -{{lvl}} combo por quicada em qualquer borda. Uma das raras melhorias de combo que não adicionam uma condição de reinício",
    "upgrades.transparency.name": "Transparência",
    "upgrades.transparency.tooltip": "A bola fica transparente no topo do ecrã. +{{percent}} % moedas quando todas as bolas estiverem totalmente transparentes.",
    "upgrades.transparency.verbose_description": "A bola fica transparente na parte superior da tela.\n+{{percent}} % moedas.\nNíveis mais elevados tornam a bola transparente mais cedo e aumentam o bônus de ponto.",
    "upgrades.trickledown.name": "Gotejamento",
    "upgrades.trickledown.tooltip": "Moedas aparecem no topo do ecrã.",
    "upgrades.trickledown.verbose_description": "As moedas podem ficar em cima de um tijolo se tiver tijolos na linha superior, nesse caso elas só irão cair depois que quebrar esse tijolo.",
    "upgrades.unbounded.name": "Agorafobia",
    "upgrades.unbounded.tooltip": "Adiciona espaço à esquerda e à direita do nível, mas o seu reme não pode ir tão longe.",
    "upgrades.unbounded.verbose_description": "Outra melhoria pode ajudá-lo a estender o alcance do seu reme.",
    "upgrades.varied_diet.name": "Dieta variada",
    "upgrades.varied_diet.tooltip": "+ {{plus}} pontos por bloco quebrado, se o bloco for de cor diferente da bola; caso contrário, - {{minus}} pontos",
    "upgrades.varied_diet.verbose_description": "Esta vantagem não adiciona uma condição de reinício.",
    "upgrades.vibrant_neighborhood.name": "Vizinhança vibrante",
    "upgrades.vibrant_neighborhood.tooltip": "Mais moedas quando blocos ficam próximos a blocos de uma cor diferente.",
    "upgrades.vibrant_neighborhood.verbose_description": "",
    "upgrades.viscosity.name": "Viscosidade",
    "upgrades.viscosity.tooltip": "Queda de moeda mais lenta",
    "upgrades.viscosity.verbose_description": "As moedas normalmente aceleram com a gravidade e as explosões até atingirem velocidades bastante elevadas.\n\nEsta vantagem faz com que elas desacelerem constantemente, como se estivessem dentro de algum tipo de líquido viscoso.\n\nIsto torna mais fácil coletá-las e combina bem com vantagens que influenciam o movimento da moeda.",
    "upgrades.wind.name": "Vento",
    "upgrades.wind.tooltip": "A posição do reme cria vento",
    "upgrades.wind.verbose_description": "O vento depende da posição do reme: esquerda assopra para esquerda, direita assopra para direita. Afeta bolas e moedas.",
    "upgrades.wrap_left.name": "Envolver à esquerda",
    "upgrades.wrap_left.tooltip": "Bater no lado esquerdo teletransporta a bola para o lado direito",
    "upgrades.wrap_left.verbose_description": "Níveis mais avançados também incluem teletransporte de moedas.",
    "upgrades.wrap_right.name": "Envolver à direita",
    "upgrades.wrap_right.tooltip": "Bater no lado direito teletransporta a bola para o lado esquerdo",
    "upgrades.wrap_right.verbose_description": "Níveis mais avançados também incluem teletransporte de moedas.",
    "upgrades.wrap_up.name": "Envolver",
    "upgrades.wrap_up.tooltip": "Tocar no topo do ecrã vai teletransportar a bola logo acima do reme.",
    "upgrades.wrap_up.verbose_description": "Isto não conta como um arremesso da raquete. No nível 2, as moedas também se teletransportam.",
    "upgrades.yoyo.name": "Ioiô",
    "upgrades.yoyo.tooltip": "A bola cai em direção o reme",
    "upgrades.yoyo.verbose_description": "É o oposto da telequinese, controlo a bola enquanto ela cai. O efeito é mais forte quando a bola está no topo do ecrã e longe do alcance horizontal da raquete.",
    "upgrades.zen.name": "Zen",
    "upgrades.zen.tooltip": "Mais moedas se não disparar bombas",
    "upgrades.zen.verbose_description": "+{{lvl}} combo a cada 3s, reinicia quando acontece uma explosão"
