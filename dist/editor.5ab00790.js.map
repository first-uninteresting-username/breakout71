    "upgrades.addiction.name": "Vício",
    "upgrades.addiction.tooltip": "Mais moedas se você quebrar blocos sem pausas",
    "upgrades.addiction.verbose_description": "+{{lvl}} combo por bloco quebrado, combo reinicia {{delay}} segundos após quebrar um bloco. A contagem regressiva só começa depois de quebrar o primeiro bloco de cada nível. Irá parar assim que todos os blocos forem destruídos.",
    "upgrades.asceticism.name": "Ascetismo",
    "upgrades.asceticism.tooltip": "+{{combo}} de combo por bloco quebrado, -{{loss}} por moedas coletadas.",
    "upgrades.asceticism.verbose_description": "Você vai precisar guardar as moedas em algum lugar enquanto o combo sobe.",
    "upgrades.ball_attract_ball.name": "Projeto em equipe",
    "upgrades.ball_attract_ball.tooltip": "Bolas atraem bolas",
    "upgrades.ball_attract_ball.verbose_description": "As bolas que estão a mais de \"3/4 da largura da área do jogo\" de distância começarão a atrair uma à outra.\n\nA força da atração é mais forte quando estão longe uma da outra.\n\nPartículas de arco-íris voarão para simbolizar a força da atração. Esta vantagem só é oferecida se você tem mais de uma bola.",
    "upgrades.ball_attracts_coins.name": "Bolas atraem moedas",
    "upgrades.ball_attracts_coins.tooltip": "Moedas seguem a bola mais próxima",
    "upgrades.ball_attracts_coins.verbose_description": "Isso poderia ser usado para \"pintar ao redor\" as bolas com moedas, se você combinar com \"metamorfose\" e \"moedas fantasmas\". Também funciona como um substituto para o ímã de moeda.",
    "upgrades.ball_repulse_ball.name": "Espaço pessoal",
    "upgrades.ball_repulse_ball.tooltip": "Bolas repelem bolas",
    "upgrades.ball_repulse_ball.verbose_description": "As bolas que estão a menos de um quarto da largura da tela vão começar a se repelir. A força de repulsão é mais forte se elas estão perto umas das outras. Partículas serão lançadas para simbolizar a aplicação desta força. Esta vantagem só é oferecida se você tem mais de uma bola.",
    "upgrades.base_combo.name": "Fundações fortes",
    "upgrades.base_combo.tooltip": "Mais 3 moedas por bloco quebrado",
    "upgrades.base_combo.verbose_description": "Seu combo começa normalmente em 1 no início do nível, e reinicia para 1 se você não acertar nada. Com esta vantagem, o combo começa com 3 pontos a mais, então você sempre terá pelo menos 4 moedas por bloco. Sempre que seu combo reiniciar, ele vai voltar para 4 e não 1. Sua bola vai brilhar um pouco para indicar que seu combo é maior que 1. No nível 2, adiciona mais 4 moedas, então 5, depois 6…",
    "upgrades.bigger_balls.name": "Bola maior",
    "upgrades.bigger_balls.tooltip": "Aumenta o diâmetro da bola",
    "upgrades.bigger_balls.verbose_description": "Isso facilita um pouco acertar os blocos.",
    "upgrades.bigger_explosions.name": "Cabum",
    "upgrades.bigger_explosions.tooltip": "Explosões maiores",
    "upgrades.bigger_explosions.verbose_description": "A explosão normal limpa uma área de 3x3, com isto se torna um área de 5x5, e a propulsão nas moedas também é significativamente maior. A tela piscará após cada explosão (exceto no modo básico)",
    "upgrades.bigger_puck.name": "Raquete maior",
    "upgrades.bigger_puck.tooltip": "Pegue moedas mais facilmente",
    "upgrades.bigger_puck.verbose_description": "Uma raquete maior torna mais fácil nunca perder a bola e pegar mais moedas, e também para mirar mais precisamente (o ângulo da bola só depende de onde ela atinge a raquete).",
    "upgrades.bricks_attract_ball.name": "Blocos atraem bolas",
    "upgrades.bricks_attract_ball.tooltip": "A bola se dirige para os {{count}} blocos mais próximos",
    "upgrades.bricks_attract_ball.verbose_description": "A bola vai em direção aos primeiros {{count}} blocos que atingir. O efeito é mais forte em níveis mais avançados. O número de blocos que podem ser atingidos antes que o efeito pare também é maior. O efeito é reativado quando a bola atinge a raquete.",
    "upgrades.bricks_attract_coins.name": "Blocos atraem moedas",
    "upgrades.bricks_attract_coins.tooltip": "Mantêm elas lá em cima",
    "upgrades.bricks_attract_coins.verbose_description": "Moedas serão atraídas para blocos próximos. Em níveis posteriores, a atração é mais forte.",
    "upgrades.buoy.name": "Boia",
    "upgrades.buoy.tooltip": "Moedas flutuam por {{duration}} segundos na linha inferior.",
    "upgrades.buoy.verbose_description": "O efeito é mais visível no modo para celular",
    "upgrades.chill.name": "Calma",
    "upgrades.chill.tooltip": "Não há mais melhorias, níveis ilimitados.",
    "upgrades.chill.verbose_description": "A bola também acelera muito mais devagar.",
    "upgrades.clairvoyant.name": "Clarividência",
    "upgrades.clairvoyant.tooltip": "Veja os próximos níveis, HP dos blocos e direção da bola",
    "upgrades.clairvoyant.verbose_description": "Te ajuda a escolher as melhores melhorias e ver a vida restante de blocos resistentes. Níveis 2 e 3 trazem conhecimentos adicionais de uso duvidoso (acessível usando \"sem limites\")",
    "upgrades.coin_magnet.name": "Imã de moedas",
    "upgrades.coin_magnet.tooltip": "A raquete atrai moedas",
    "upgrades.coin_magnet.verbose_description": "Direciona as moedas para a raquete. O efeito é mais forte se a moeda já estiver perto.",
    "upgrades.compound_interest.name": "Juros compostos",
    "upgrades.compound_interest.tooltip": "Mais moedas se você pegar todas as moedas",
    "upgrades.compound_interest.verbose_description": "Seu combo vai crescer por um a cada vez que você quebrar um bloco, gerando mais e mais moedas a cada bloco que você quebrar.\nCertifique-se de pegar cada uma dessas moedas com sua raquete, pois qualquer moeda perdida irá reiniciar seu combo.\nUma vez que seu combo estiver acima do mínimo, o fundo da área de jogo terá uma linha vermelha para lembrar que as moedas não devem cair lá.",
    "upgrades.concave_puck.name": "Raquete côncava",
    "upgrades.concave_puck.tooltip": "Melhora a precisão vertical",
    "upgrades.concave_puck.verbose_description": "As bolas começam o nível indo direto para cima, e quicam com menos ângulo.",
    "upgrades.corner_shot.name": "Escanteio",
    "upgrades.corner_shot.tooltip": "Permite que a raquete adentre nas bordas da tela",
    "upgrades.corner_shot.verbose_description": "Ajuda com a mira nos cantos. Mais níveis permitem que você entre mais profundamente.",
    "upgrades.disco_ball.name": "Bola de discoteca",
    "upgrades.disco_ball.tooltip": "Cada quicada na parede muda a cor da bola",
    "upgrades.disco_ball.verbose_description": "A bola vai alternar entre as cores do arco-íris.",
    "upgrades.double_or_nothing.name": "Tudo ou nada",
    "upgrades.double_or_nothing.tooltip": "O combo cresce duas vezes mais rápido, mas se zerar, a partida termina.",
    "upgrades.double_or_nothing.verbose_description": "O reinício do combo só conta quando sua combinação estiver acima do mínimo. Isso também aumenta o impulso oferecido por \"raquete menor\", \"transparência\" e \"blocos resistentes\".",
    "upgrades.etherealcoins.name": "Moedas, no Espaço",
    "upgrades.etherealcoins.tooltip": "As moedas não são mais afetadas pela gravidade",
    "upgrades.etherealcoins.verbose_description": "As moedas manterão sua velocidade mesmo após rebater várias vezes, e não serão mais afetadas pela gravidade.",
    "upgrades.extra_levels.name": "Só mais 5 minutinhos",
    "upgrades.extra_levels.tooltip": "Jogue {{count}} níveis ao invés de 7",
    "upgrades.extra_levels.verbose_description": "O jogo padrão pode durar um máximo de 7 níveis, após isso o jogo está termina.\n\nCada nível desta vantagem permite que você jogue mais uma fase. Os últimos níveis são muitas vezes aqueles onde você faz mais pontuação, então a diferença pode ser dramática.",
    "upgrades.extra_life.name": "Vida extra",
    "upgrades.extra_life.tooltip": "Salva sua última bola se estiver prestes a cair",
    "upgrades.extra_life.verbose_description": "A vida será consumida no processo. Vidas extras aparecem como linhas atrás da raquete.",
    "upgrades.flyswatter.name": "Mata-moscas",
    "upgrades.flyswatter.tooltip": "Toque no lado esquerdo para aplicar gravidade para todas as bolas.",
    "upgrades.flyswatter.verbose_description": "",
    "upgrades.forgiving.name": "Errar é humano",
    "upgrades.forgiving.tooltip": "A primeira vez que a bola erra todos os blocos em um nível é ignorada.",
    "upgrades.forgiving.verbose_description": "Se o seu arremesso perdido for ignorado, você ainda estará eligível para a medalha dourada nesse critério.",
    "upgrades.fountain_toss.name": "Fonte dos desejos",
    "upgrades.fountain_toss.tooltip": "Ganhe combo quando perder algumas moedas.",
    "upgrades.fountain_toss.verbose_description": "Quando você perder uma moeda e seu combo estiver abaixo do nível*30, seu nível/combo pode crescer por um.",
    "upgrades.fumes.name": "Borrifador",
    "upgrades.fumes.tooltip": "Quando um bloco quebra, todos os blocos acima recebem a sua cor.",
    "upgrades.fumes.verbose_description": "A cor também se estende para além dos espaços vazios.",
    "upgrades.ghost_coins.name": "Moedas fantasma",
    "upgrades.ghost_coins.tooltip": "Moedas passam lentamente através de blocos",
    "upgrades.ghost_coins.verbose_description": "Não é um bug, é uma função! As moedas atravessam os blocos lentamente. Níveis mais avançados permitem que elas afundem mais rápido.",
    "upgrades.golden_goose.name": "Gansa dourada",
    "upgrades.golden_goose.tooltip": "Moedas se teletransportam para a bola depois de tocar em um bloco",
    "upgrades.golden_goose.verbose_description": "Sempre que uma moeda tocar em um bloco, essa moeda se teletransportará para a bola mais próxima. No nível dois, as moedas teletransportam-se depois de bater nos lados também.",
    "upgrades.gravity_falls.name": "Bola gravitacional",
    "upgrades.gravity_falls.tooltip": "Bolas que tocarem no topo recebem gravidade",
    "upgrades.gravity_falls.verbose_description": "",
    "upgrades.happy_family.name": "Família feliz",
    "upgrades.happy_family.tooltip": "Mais moedas se você manter todas as bolas na partida.",
    "upgrades.happy_family.verbose_description": "+1 combo por bola extra quicada na raquete. Combo reinicia quando uma bola é perdida. Só a bola acima de 1 dá combinação.",
    "upgrades.hardhat.name": "Cabeça-dura",
    "upgrades.hardhat.tooltip": "Torna mais difícil quebrar blocos pelo topo",
    "upgrades.hardhat.verbose_description": "Reduz o dano pela metade quando uma bola atinge o topo de um bloco",
    "upgrades.helium.name": "Hélio",
    "upgrades.helium.tooltip": "Gravidade limitada nos lados da raquete",
    "upgrades.helium.verbose_description": "No nível 1, a gravidade é reduzida. No nível 2, as moedas flutuam lentamente. No nível 3 elas realmente voam.",
    "upgrades.hot_start.name": "Arrancada",
    "upgrades.hot_start.tooltip": "Mais moedas se você vencer o nível antes de 30 segundos",
    "upgrades.hot_start.verbose_description": "No início de cada nível, seu combo vai começar com +{{start}} pontos, mas então cada segundo será diminuído por {{loss}}. O efeito se empilha com outras vantagens.",
    "upgrades.implosions.name": "Implosões",
    "upgrades.implosions.tooltip": "Explosões sugam moedas ao invés de propulsioná-las",
    "upgrades.implosions.verbose_description": "A força de explosão é aplicada do outro modo. Mais níveis atuam como uma \"explosão maior\"",
    "upgrades.instant_explosion.name": "Explosão instantânea",
    "upgrades.instant_explosion.tooltip": "Explosões destroem instantaneamente blocos e bombas próximas",
    "upgrades.instant_explosion.verbose_description": "Isso pode ser útil se você contar com as explosões para quebrar os blocos antes que else reiniciem seu combo.",
    "upgrades.left_is_lava.name": "Evite o lado esquerdo",
    "upgrades.left_is_lava.tooltip": "Mais moedas se você não tocar no lado esquerdo",
    "upgrades.left_is_lava.verbose_description": "Sempre que você quebrar um bloco, seu combo vai aumentar por um, então você vai ter mais uma moeda de todos os blocos que você quebrar.\n\nNo entanto, seu combo irá reiniciar assim que sua bola atingir o lado esquerdo.\n\nQuando seu combo aumenta, o lado esquerdo fica vermelho para lembrar que você deve o evitar\n\nNo nível 2, a borda é completamente removida e suas bolas e moedas podem ser perdidas.\n\nEsta melhoria afeta a direção inicial da bola.",
    "upgrades.limitless.name": "Sem limites",
    "upgrades.limitless.tooltip": "Aumentar o nível máximo de todas as melhorias por {{lvl}}",
    "upgrades.limitless.verbose_description": "Escolher esta vantagem também aumenta seu próprio limite por um, deixando-a escolher novamente.",
    "upgrades.metamorphosis.name": "Metamorfose",
    "upgrades.metamorphosis.tooltip": "Cada moeda pode manchar {{lvl}} bloco(s) com sua cor",
    "upgrades.metamorphosis.verbose_description": "Com este vantagem, as moedas serão da cor do bloco de origem, e irão colorir o primeiro bloco que tocarem. Moedas surgem com a mesma velocidade da bola que as invocou, o que significa que você pode mirar nos blocos que você quer \"pintar\". No nível 1, cada moeda pode colorir 1 bloco antes de serem \"gastas\" e aparecerem ocas.",
    "upgrades.minefield.name": "Campo Minado",
    "upgrades.minefield.tooltip": "+{{percent}}% de moedas por bombas na tela",
    "upgrades.minefield.verbose_description": "As bombas são contadas enquanto estão explodindo também.",
    "upgrades.multiball.name": "Multi bolas",
    "upgrades.multiball.tooltip": "Comece cada nível com {{count}} bolas.",
    "upgrades.multiball.verbose_description": "Assim que você largar a bola no Breakout 71, você perde.\n\nCom esta vantagem, você tem duas bolas, e assim você pode se dar ao luxo de perder uma.\n\nAs bolas perdidas voltam no próximo nível.\n\nTer mais de uma bola torna outras vantagens disponíveis, e é claro, limpa o nível mais rápido.",
    "upgrades.nbricks.name": "Passos de bebê",
    "upgrades.nbricks.tooltip": "Mais moedas se você terminar a fase lentamente.",
    "upgrades.nbricks.verbose_description": "+{{gain}} combo por bloco quebrado. O combo reinicia se uma bola quebrar mais de {{max}} blocos entre duas quicadas na raquete ou na parede. Tome cuidado, explosões também contam.",
    "upgrades.one_more_choice.name": "Escolha extra",
    "upgrades.one_more_choice.tooltip": "Mais opções de melhorias",
    "upgrades.one_more_choice.verbose_description": "Cada menu de melhorias terá mais uma opção. Não aumenta o número de melhorias que você pode escolher.",
    "upgrades.ottawa_treaty.name": "Tratado de Ottawa",
    "upgrades.ottawa_treaty.tooltip": "Quebrar um bloco perto de uma bomba a desarma",
    "upgrades.ottawa_treaty.verbose_description": "A bomba próxima será substituída por um bloco colorido. Se você tiver sapador, a bola perderá seu efeito até a próxima rebatida. Só uma bomba pode ser substituída por vez.",
    "upgrades.paddle_up_combo.name": "Olhe direto",
    "upgrades.paddle_up_combo.tooltip": "+1 por bloco quebrado diretamente acima da raquete, caso contrário, reinicia",
    "upgrades.paddle_up_combo.verbose_description": "",
    "upgrades.palette.name": "Paleta",
    "upgrades.palette.tooltip": "+1 de combo para cada cor de bloco diferente na tela; o combo é reiniciado se houver apenas uma cor",
    "upgrades.palette.verbose_description": "Tome cuidado! Alguns níveis só possuem uma única cor. O primeiro e o último bloco acertado não contam.",
    "upgrades.passive_income.name": "Renda passiva",
    "upgrades.passive_income.tooltip": "Mais moedas, mas uma raquete em movimento não consegue pegá-las.",
    "upgrades.passive_income.verbose_description": "+{{lvl}} de combo por blocos quebrados, a raquete fica imaterial {{time}}s depois de se mover. Algumas vantagens podem ajudar as bolas a fazerem o que você quer sem que você precise fazer nada.\n\nAs moedas passarão pela raquete no nível 1, e a bola também passará pela raquete imaterial a partir do nível 2.",
    "upgrades.picky_eater.name": "Chato para comer",
    "upgrades.picky_eater.tooltip": "Mais moedas se você quebrar blocos da cor da bola",
    "upgrades.picky_eater.verbose_description": "Sempre que você quebrar um bloco com a mesma cor que sua bola, seu combo aumenta pelo número de cores na tela menos uma.\nSe for uma cor diferente, a bola fica com a nova cor, mas o combo reinicia, a menos que não haja blocos da cor da bola.\nUma vez que você obter um combo superior ao seu mínimo, os blocos de cor diferente obterão uma borda vermelha.\nSe você tem mais de uma bola, todos eles mudarão de cor sempre que uma delas atingir um bloco.",
    "upgrades.pierce.name": "Bola perfurante",
    "upgrades.pierce.tooltip": "Bola perfura {{count}} blocos depois de quicar na raquete",
    "upgrades.pierce.verbose_description": "A bola normalmente quica assim que bate em algo. Com esta vantagem, ela continuará sua trajetória até quebrar 3 blocos.\n\nDepois disso, ela vai quicar no 4º bloco, e você precisa rebater com a raquete para redefinir o contador.",
    "upgrades.pierce_above_paddle.name": "Janela de oportunidade",
    "upgrades.pierce_above_paddle.tooltip": "Blocos quebram mais facilmente quando estão diretamente acima da raquete.",
    "upgrades.pierce_above_paddle.verbose_description": "",
    "upgrades.pierce_color.name": "Cor perfurante",
    "upgrades.pierce_color.tooltip": "A bola atravessa blocos da mesma cor",
    "upgrades.pierce_color.verbose_description": "A bola atravessa os blocos da mesma cor sem obstáculos até que sua “carga” se esgote. Em seguida, ela precisa ricochetear na raquete para recarregar.",
    "upgrades.pierce_left.name": "Perfurar pela esquerda",
    "upgrades.pierce_left.tooltip": "Blocos são quebrados mais facilmente quando são acertados pela esquerda",
    "upgrades.pierce_left.verbose_description": "Esta melhoria impacta a direção inicial da bola. A bola irá acelerar quando o efeito for ativado.",
    "upgrades.pierce_right.name": "Perfurar pela direita",
    "upgrades.pierce_right.tooltip": "Blocos são quebrados mais facilmente quando são acertados pela direita",
    "upgrades.pierce_right.verbose_description": "Esta melhoria afeta a direção inicial da bola. A bola acelerará quando o efeito for ativado.",
    "upgrades.pierce_top.name": "Perfurar por cima",
    "upgrades.pierce_top.tooltip": "Blocos são quebrados mais facilmente quando são acertados pelo topo",
    "upgrades.pierce_top.verbose_description": "A bola vai acelerar quando o efeito for acionado.",
    "upgrades.puck_repulse_ball.name": "Aterrissagem macia",
    "upgrades.puck_repulse_ball.tooltip": "Raquete repele bolas",
    "upgrades.puck_repulse_ball.verbose_description": "Quando uma bola chegar perto da raquete, ela irá começar a desacelerar, e até mesmo potencialmente quicar sem encostar na raquete.",
    "upgrades.rainbow.name": "Arco-íris",
    "upgrades.rainbow.tooltip": "Moedas surgem com cor arco-íris.",
    "upgrades.rainbow.verbose_description": "Cada nível aumenta a proporção de moedas coloridas. A cor depende do tempo de nível.",
    "upgrades.reach.name": "De cima para baixo",
    "upgrades.reach.tooltip": "Mais moedas se você evitar a linha mais baixa de blocos",
    "upgrades.reach.verbose_description": "Tocar os N blocos da linha mais baixa reinicia o combo. Caso contrário, combo +N.\n\nSe houver apenas uma linha de blocos, ou se a linha mais baixa de blocos cobrir toda a largura do jogo, então esta melhoria não faz nada. Caso contrário, quebrar a linha mais baixa reinicia o combo, ao quebrar qualquer outra coisa aumenta o combo pelo número de blocos presentes na linha mais baixa.\n\nA linha mais baixa será destacada em vermelho.",
    "upgrades.refill.name": "Recarga",
    "upgrades.refill.tooltip": "Acertar qualquer lado ou teletransportar a bola reinicia o contador de perfuragem da bola",
    "upgrades.refill.verbose_description": "Também concede +1 perfuragem.",
    "upgrades.respawn.name": "Reaparecimento",
    "upgrades.respawn.tooltip": "{{percent}}% dos blocos reaparecem após {{delay}} segundos.",
    "upgrades.respawn.verbose_description": "Um efeito de partícula irá mostrá-lo onde os blocos aparecerão.",
    "upgrades.right_is_lava.name": "Evite o lado direito",
    "upgrades.right_is_lava.tooltip": "Mais moedas se você não tocar no lado direito",
    "upgrades.right_is_lava.verbose_description": "Sempre que você quebrar um bloco, seu combo vai aumentar por um, então você vai ter mais uma moeda para todos os próximos blocos que você quebrar.\n\nNo entanto, seu combo irá reiniciar assim que sua bola tocar no lado direito.\n\nAssim que seu combo aumentar, o lado direito vai ficar vermelho para lembrá-lo de que você deve evitar tocar nele.\n\nNo nível 2, a borda é completamente removida e suas bolas e moedas podem se perder.\n\nEsta melhoria afeta a direção inicial da bola.",
    "upgrades.round_bricks.name": "Blocos redondos",
    "upgrades.round_bricks.tooltip": "Os blocos ficam redondos",
    "upgrades.round_bricks.verbose_description": "",
    "upgrades.sacrifice.name": "Sacrifício",
    "upgrades.sacrifice.tooltip": "Perder uma vida aumenta o combo por {{gain}}.",
    "upgrades.sacrifice.verbose_description": "",
    "upgrades.sapper.name": "Sapador",
    "upgrades.sapper.tooltip": "O primeiro bloco quebrado vira uma bomba.",
    "upgrades.sapper.verbose_description": "Em vez de apenas desaparecer, o primeiro bloco que você quebrar será substituído por um bloco-bomba. Quicar a bola na raquete recarrega o efeito. Aumentar o nível desta vantagem permitirá que você coloque mais bombas.",
    "upgrades.shocks.name": "Choques",
    "upgrades.shocks.tooltip": "Colisões explosivas de bolas",
    "upgrades.shocks.verbose_description": "Sempre que duas bolas colidem, trocam de velocidade entre si, geram uma explosão, e ganham velocidade adicional para se separarem.",
    "upgrades.shunt.name": "Derivação",
    "upgrades.shunt.tooltip": "Mantenha {{percent}}% do seu combo entre níveis",
    "upgrades.shunt.verbose_description": "Se você também tiver arrancada, o início quente é apenas adicionado à combinação atual",
    "upgrades.side_flip.name": "Destro",
    "upgrades.side_flip.tooltip": "+1 combo por bloco quebrado. O combo reinicia se você acertar qualquer bloco pelo lado esquerdo.",
    "upgrades.side_flip.verbose_description": "Explosões e acertos que não quebraram o bloco não contam como reinício de combo. Esta melhoria afeta a direção inicial da bola.",
    "upgrades.side_kick.name": "Canhoto",
    "upgrades.side_kick.tooltip": "+1 combo por bloco quebrado. O combo reinicia se você quebrar um bloco pelo lado direito.",
    "upgrades.side_kick.verbose_description": "Explosões e acertos que não quebraram o bloco não contam como reinício de combo. Esta melhoria afeta a direção inicial da bola.",
    "upgrades.skip_last.name": "Limpeza fácil",
    "upgrades.skip_last.tooltip": "O último bloco se autodestruirá",
    "upgrades.skip_last.verbose_description": "Você precisa quebrar todos os blocos para ir para o próximo nível. No entanto, pode ser difícil acertar os últimos.\nCada nível desta vantagem aumenta o número de blocos que se destroem sozinhos.\nLimpar um nível rapidamente traz mais opções de melhorias. Nunca errar os blocos também é muito benéfico.\n\nEntão, se você achar difícil quebrar os últimos blocos, obter esta vantagem pode ajudar.",
    "upgrades.slow_down.name": "Bola mais lenta",
    "upgrades.slow_down.tooltip": "A bola se move mais lentamente",
    "upgrades.slow_down.verbose_description": "A bola começa relativamente lenta, mas a cada nível ela fica um pouco mais rápida.\n\nTambém vai acelerar se você passar muito tempo em um nível.\n\nEsta vantagem a torna mais fácil de conduzi-la.\n\nVocê pode obtê-la no início de todas as partidas ativando o modo infantil nas configurações.",
    "upgrades.smaller_puck.name": "Raquete menor",
    "upgrades.smaller_puck.tooltip": "{{percent}}% mais moedas",
    "upgrades.smaller_puck.verbose_description": "Diminui a raquete, o que em teoria, faz rebater nos cantos mais fácil, mas na verdade só aumenta a dificuldade.\n\nÉ por isso que você também obtém um bom bônus que gera +50% moedas.",
    "upgrades.soft_brush.name": "Pincel suave",
    "upgrades.soft_brush.tooltip": "Quando acertar um bloco de uma cor diferente, a bola pinta o bloco ao invés de quebrá-lo.",
    "upgrades.soft_brush.verbose_description": "Isso não tem efeito algum se o bloco for destruído por uma explosão. O efeito ocorre apenas uma vez por quicada da raquete por nível da vantagem.",
    "upgrades.soft_reset.name": "Reinício progressivo",
    "upgrades.soft_reset.tooltip": "Mantenha {{percent}}% do seu combo quando ele reiniciar",
    "upgrades.soft_reset.verbose_description": "Reduz o impacto de um reinício de combo.",
    "upgrades.soft_touch.name": "Toque suave",
    "upgrades.soft_touch.tooltip": "A bola quica nos blocos sem quebrá-los quando não está acima da raquete.",
    "upgrades.soft_touch.verbose_description": "",
    "upgrades.steering.name": "Direção",
    "upgrades.steering.tooltip": "As bolas viram quando a raquete se move",
    "upgrades.steering.verbose_description": "A posição da raquete influencia diretamente a direção do movimento das bolas. No nível 2 para cima, você verá uma linha mostrando a direção da sua bola.",
    "upgrades.sticky_coins.name": "Moedas pegajosas",
    "upgrades.sticky_coins.tooltip": "Moedas grudam em blocos da mesma cor",
    "upgrades.sticky_coins.verbose_description": "No nível 2, elas grudam em blocos de qualquer cor",
    "upgrades.streak_shots.name": "Sequência de rebatidas",
    "upgrades.streak_shots.tooltip": "Mais moedas se você quebrar muitos blocos ao mesmo tempo",
    "upgrades.streak_shots.verbose_description": "Cada vez que você quebrar um bloco, sua combinação aumenta por um.\n\nNo entanto, assim que a bola tocar na sua raquete, o combo reinicia.\n\nUma vez que seu combo subir acima do valor base, sua raquete terá uma borda vermelha para lembrá-lo de que tocar na bola destruirá seu combo.",
    "upgrades.sturdy_bricks.name": "Blocos resistentes",
    "upgrades.sturdy_bricks.tooltip": "+{{lvl}} HP nos blocos, +{{percent}}% moedas",
    "upgrades.sturdy_bricks.verbose_description": "Cada nível desta vantagem adiciona HP para todos os blocos. Você pode ver o número de HP com a vantagem \"clarividente\". Também pode aumentar o dano da bola, obtendo a vantagem \"penetrar\". Cada nível desta vantagem gera +50% moedas.",
    "upgrades.superhot.name": "SUPER HOT",
    "upgrades.superhot.tooltip": "O tempo se move apenas quando a raquete se move.",
    "upgrades.superhot.verbose_description": "SUPER HOT SUPER HOT SUPER HOT SUPER HOT",
    "upgrades.telekinesis.name": "Telecinese",
    "upgrades.telekinesis.tooltip": "A posição da raquete influencia a bola",
    "upgrades.telekinesis.verbose_description": "Controla a bola enquanto está subindo. O efeito é mais forte quando a bola está na metade inferior da tela.",
    "upgrades.thomas.name": "São Tomé",
    "upgrades.thomas.tooltip": "Metade dos blocos ressuscitam quando uma bola for perdida.",
    "upgrades.thomas.verbose_description": "O nome da vantagem é uma dupla referência, já que o apóstolo Tomé é o santo padroeiro dos arquitetos e, como dizem, duvidou da ressurreição de Cristo. Muito apropriado para um sacrifício de bola que permite colocar mais tijolos.",
    "upgrades.three_cushion.name": "Três almofadas",
    "upgrades.three_cushion.tooltip": "Mais moedas se você bater blocos apenas indiretamente",
    "upgrades.three_cushion.verbose_description": "+1 de combo por bloco por cada quicada lateral que a bola deu antes de atingir esse bloco. Limitado a +{{max}} de combo por bloco. O combo é reiniciado se você quebrar um bloco sem que a bola tenha primeiro quicado em uma das laterais.",
    "upgrades.top_is_lava.name": "O céu é o limite",
    "upgrades.top_is_lava.tooltip": "Mais moedas se você evitar acertar o topo",
    "upgrades.top_is_lava.verbose_description": "Sempre que você quebrar um bloco, seu combo vai aumentar por um. No entanto, seu combo irá reiniciar assim que sua bola atingir o topo da tela.\n\nQuando seu combo está acima do mínimo, uma barra vermelha aparecerá no topo para lembrá-lo de que você deve evitar acertá-lo.\n\nNo nível 2, a borda é removida completamente e suas bolas e moedas podem ser perdidas.",
    "upgrades.trampoline.name": "Trampolim",
    "upgrades.trampoline.tooltip": "+{{lvl}} combo cada vez que a bolar quicar da raquete, -{{lvl}} combo cada vez que a bola quicar das bordas",
    "upgrades.trampoline.verbose_description": "+{{lvl}} combo por quicada na raquete, -{{lvl}} combo por quicada em qualquer borda. Uma das raras melhorias de combo que não adicionam uma condição de reinício",
    "upgrades.transparency.name": "Transparência",
    "upgrades.transparency.tooltip": "A bola fica invisível no topo da tela. Aumento de combo {{percent}}% mais rápido",
    "upgrades.transparency.verbose_description": "A bola fica transparente na parte superior da tela.\n+{{percent}} % moedas.\nNíveis mais elevados tornam a bola transparente mais cedo e aumentam o bônus de ponto.",
    "upgrades.trickledown.name": "Gotejamento",
    "upgrades.trickledown.tooltip": "Moedas aparecem no topo da tela.",
    "upgrades.trickledown.verbose_description": "As moedas podem ficar em cima de um bloco se tiver blocos na linha superior, nesse caso elas só irão cair depois que você quebrar esse bloco.",
    "upgrades.unbounded.name": "Agorafobia",
    "upgrades.unbounded.tooltip": "Adiciona espaço à esquerda e à direita do nível, mas a sua raquete não pode ir tão longe.",
    "upgrades.unbounded.verbose_description": "Outra melhoria pode te ajudar a estender o alcance da sua raquete.",
    "upgrades.varied_diet.name": "Dieta variada",
    "upgrades.varied_diet.tooltip": "+ {{plus}} pontos por bloco quebrado, se o bloco for de cor diferente da bola; caso contrário, - {{minus}} pontos",
    "upgrades.varied_diet.verbose_description": "Esta vantagem não adiciona uma condição de reinício.",
    "upgrades.vibrant_neighborhood.name": "Vizinhança vibrante",
    "upgrades.vibrant_neighborhood.tooltip": "Mais moedas quando blocos ficam próximos a blocos de uma cor diferente.",
    "upgrades.vibrant_neighborhood.verbose_description": "Quando um bloco é destruído, o combo aumenta pelo número de blocos de uma cor diferente que estiverem no quadrado de 3x3 ao redor do bloco destruído. Se houver apenas blocos da mesma cor nas proximidades, o combo é reiniciado. Blocos sem vizinhos não afetam o combo quando são destruídos.",
    "upgrades.viscosity.name": "Viscosidade",
    "upgrades.viscosity.tooltip": "Queda de moeda mais lenta",
    "upgrades.viscosity.verbose_description": "As moedas normalmente aceleram com a gravidade e as explosões até atingirem velocidades bastante elevadas.\n\nEsta vantagem faz com que elas desacelerem constantemente, como se estivessem dentro de algum tipo de líquido viscoso.\n\nIsto torna mais fácil coletá-las e combina bem com vantagens que influenciam o movimento da moeda.",
    "upgrades.wind.name": "Vento",
    "upgrades.wind.tooltip": "A posição da raquete cria vento",
    "upgrades.wind.verbose_description": "O vento depende da posição da raquete: esquerda assopra pra esquerda, direita assopra pra direita. Afeta bolas e moedas.",
    "upgrades.wrap_left.name": "Envolver à esquerda",
    "upgrades.wrap_left.tooltip": "Bater no lado esquerdo teletransporta a bola para o lado direito",
    "upgrades.wrap_left.verbose_description": "Níveis mais avançados também incluem teletransporte de moedas.",
    "upgrades.wrap_right.name": "Envolver à direita",
    "upgrades.wrap_right.tooltip": "Bater no lado direito teletransporta a bola para o lado esquerdo",
    "upgrades.wrap_right.verbose_description": "Níveis mais avançados também incluem teletransporte de moedas.",
    "upgrades.wrap_up.name": "Envolver",
    "upgrades.wrap_up.tooltip": "Tocar no topo da tela vai teletransportar a bola logo acima da raquete.",
    "upgrades.wrap_up.verbose_description": "Isto não conta como um arremesso da raquete. No nível 2, as moedas também se teletransportam.",
    "upgrades.yoyo.name": "Ioiô",
    "upgrades.yoyo.tooltip": "A bola cai em direção a raquete",
    "upgrades.yoyo.verbose_description": "É o oposto da telecinese, controle a bola enquanto ela está caindo. O efeito é mais forte quando a bola está no topo da tela, e longe do alcance horizontal da raquete.",
    "upgrades.zen.name": "Zen",
    "upgrades.zen.tooltip": "Mais moedas se não disparar bombas",
    "upgrades.zen.verbose_description": "+{{lvl}} combo a cada 3s, reinicia quando acontece uma explosão"
}
