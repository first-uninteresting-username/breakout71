    "unlocks.category.advanced": "## Zaawansowane ulepszenia\n\nSame w sobie nie są zazwyczaj zbyt przydatne, ale w połączeniu z odpowiednim ulepszeniem kombinacyjnym mogą stać się niezwykle skuteczne.",
    "unlocks.category.beginner": "## Ulepszenia przyjazne dla początkujących\n\nTe ulepszenia są bardzo pomocne dla początkujących – pozwalają grać dłużej i rzadziej stracić piłkę.",
    "unlocks.category.combo": "## Ulepszenia kombinacji\n\nUlepszenia te pozwalają stopniowo zwiększać długość kombinacji, ale wiążą się również z warunkiem jej zresetowania. Na początku każdej rozgrywki otrzymujesz jedno takie ulepszenie. Możesz zdobyć ich więcej, aby zwiększyć ryzyko i potencjalną nagrodę.",
    "unlocks.category.combo_boost": "## Ulepszenia wzmacniające kombinacje\n\nUlepszenia te zwiększają liczbę kombinacji lub mnożnik kombinacji bez wprowadzania warunku resetowania.",
    "unlocks.category.pierce": "## Ulepszenia przebicia\n\nTe ulepszenia pozwalają zniszczyć więcej cegieł, zanim piłka odbije się z powrotem. Poziom przebicia odnawia się po uderzeniu w łopatkę, ale niektóre ulepszenia pozwalają go odnowić również w innych sytuacjach.",
    "unlocks.category.simple": "## Ulepszenia pomocników\n\nTe ulepszenia przydają się w niemal każdej konfiguracji.",
    "unlocks.extra_perks_for_preview": "Dodatkowe ulepszenia zastosowano wyłącznie w celach ilustracyjnych.",
    "unlocks.greyed_out_help": "Wyszarzone ulepszenia można odblokować, zwiększając swój łączny wynik. Łączny wynik rośnie za każdym razem, gdy zdobędziesz punkty w grze.",
    "unlocks.include_in_level_pool": "Poziom do uwzględnienia",
    "unlocks.include_in_level_pool_help": "Czasami rysuj ten poziom w trakcie rozgrywki",
    "unlocks.include_in_level_pool_locked": "Musisz zachować co najmniej 15 poziomów.",
    "unlocks.include_in_unlock_hints_help": "Pomóż mi odblokować ten poziom",
    "unlocks.include_in_unlock_not_during_gameplay": "Nie można zmienić tego ustawienia po rozpoczęciu gry.",
    "unlocks.intro": "Twój łączny wynik to {{ts}}. Kliknij poniżej na dowolne ulepszenie, aby rozpocząć grę z jego wykorzystaniem.",
    "unlocks.just_unlocked": "Poziom odblokowany",
    "unlocks.just_unlocked_plural": "Odblokowano {{count}} poziomów",
    "unlocks.level": "Oto wszystkie poziomy gry. Kliknij na poziom, aby dowiedzieć się o nim więcej. Odblokowano {{unlocked}} poziomów z {{out_of}}. Prześlij nam swoje najlepsze poziomy na Discordzie, abyśmy mogli je dodać do listy.",
    "unlocks.level_description": "Poziom o wymiarach {{size}} x {{size}}, zawierający {{bricks}} cegieł, {{colors}} kolorów i {{bombs}} bomb.",
    "unlocks.level_locked": "Nadal zablokowany",
    "unlocks.level_unlocked": "Już odblokowane",
    "unlocks.levels": "Poziomy",
