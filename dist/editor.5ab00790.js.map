    "upgrades.forgiving.name": "寬容",
    "upgrades.forgiving.tooltip": "球第一次沒有擊中關卡中的所有磚塊的情況將被忽略。",
    "upgrades.forgiving.verbose_description": "",
    "upgrades.fountain_toss.name": "噴泉拋擲",
    "upgrades.fountain_toss.tooltip": "當你錯過接住硬幣時獲得連擊。",
    "upgrades.fountain_toss.verbose_description": "當你錯過一枚硬幣並且你的連擊低於等級*30 時，你的連擊有機率增加一等級／連擊。",
    "upgrades.fumes.name": "",
    "upgrades.fumes.tooltip": "",
    "upgrades.fumes.verbose_description": "",
    "upgrades.ghost_coins.name": "幽靈硬幣",
    "upgrades.ghost_coins.tooltip": "硬幣緩慢地穿過磚塊",
    "upgrades.ghost_coins.verbose_description": "這不是一個漏洞，而是一個功能！硬幣穿過磚塊時速度很慢。等級越高，硬幣的移動速度越快。",
    "upgrades.golden_goose.name": "金鵝",
    "upgrades.golden_goose.tooltip": "擊中磚塊後，硬幣傳送至球的位置",
    "upgrades.golden_goose.verbose_description": "每當硬幣擊中磚塊時，硬幣都會傳送至最接近的球上。在第二級，硬幣擊中磚塊側面後也會傳送。",
    "upgrades.gravity_falls.name": "重力球",
    "upgrades.gravity_falls.tooltip": "",
    "upgrades.gravity_falls.verbose_description": "",
    "upgrades.happy_family.name": "幸福家庭",
    "upgrades.happy_family.tooltip": "如果你將所有球留在遊戲中，將獲得更多硬幣。",
    "upgrades.happy_family.verbose_description": "每次槳板反彈球時，每個額外球的連擊數 +1。掉球後連擊數會重置。只有多於一個球時才能獲得連擊數。",
    "upgrades.hardhat.name": "",
    "upgrades.hardhat.tooltip": "",
    "upgrades.hardhat.verbose_description": "",
    "upgrades.helium.name": "氦氣",
    "upgrades.helium.tooltip": "槳板的左右兩側有重力限制",
    "upgrades.helium.verbose_description": "在第 1 級，重力減少。在第 2 級，硬幣緩慢浮起。在第 3 級，硬幣真的會飛起來。",
    "upgrades.hot_start.name": "熱啟動",
    "upgrades.hot_start.tooltip": "如果你在 30 秒內完成關卡，將獲得更多硬幣",
    "upgrades.hot_start.verbose_description": "在每個關卡開始時，你的連擊都會 +{{start}} 點，但是之後每秒鐘都會減少 {{loss}} 點。此效果可以與其他技能疊加。",
    "upgrades.implosions.name": "內爆",
    "upgrades.implosions.tooltip": "爆炸會將硬幣吸入而不是吹出",
    "upgrades.implosions.verbose_description": "爆炸力以另一種方式施加。更高等級的爆炸相當於「更大的爆炸」",
    "upgrades.instant_explosion.name": "",
    "upgrades.instant_explosion.tooltip": "",
    "upgrades.instant_explosion.verbose_description": "",
    "upgrades.left_is_lava.name": "避免左側",
    "upgrades.left_is_lava.tooltip": "如果你不觸碰左側，將獲得更多硬幣",
    "upgrades.left_is_lava.verbose_description": "每當你擊破一塊磚塊時，你的連擊就會增加一點，所以你接下來擊破的所有磚塊都會多獲得一枚硬幣。\n\n但是，當你的球擊中左側時，你的連擊數就會重置。\n\n當你的連擊數增加時，左側會變成紅色，提醒你避免擊中它們。\n\n在第 2 級，邊界會被完全移除，你的球和硬幣可能會遺失。",
    "upgrades.limitless.name": "無限",
    "upgrades.limitless.tooltip": "將所有升級的最高等級提高 {{lvl}} 級",
    "upgrades.limitless.verbose_description": "選擇這個技能也會使它自身的限制提高，讓你再次選擇它。",
    "upgrades.metamorphosis.name": "變形",
    "upgrades.metamorphosis.tooltip": "每枚硬幣都可以將 {{lvl}} 塊磚塊染成其顏色",
    "upgrades.metamorphosis.verbose_description": "使用此技能時，硬幣的顏色將與它們來自的磚塊顏色相同，並且將接觸到的第一塊磚塊染成相同的顏色。硬幣產生時的速度和方向與擊破它們磚塊的球的速度相同，這意味著你可以稍微瞄準你想要「塗色」的磚塊的方向。在第 1 級，每枚硬幣可以為 1 塊磚塊上色，之後就會「耗盡」並呈現空心狀態。",
    "upgrades.minefield.name": "地雷區",
    "upgrades.minefield.tooltip": "螢幕上每個炸彈磚塊 +{{percent}}% 的硬幣",
    "upgrades.minefield.verbose_description": "炸彈爆炸時也會被計數。",
    "upgrades.multiball.name": "多個球",
    "upgrades.multiball.tooltip": "每個關卡開始時都有 {{count}} 個球。",
    "upgrades.multiball.verbose_description": "在 Breakout 71 中，只要你丟了球，你就輸了。\n\n有了此技能，你會得到兩個球，所以你丟了一個也沒有問題。\n\n丟了的球會在下一關重新出現。\n\n擁有多個球可以獲得更多技能，當然也能更快通關。",
    "upgrades.nbricks.name": "步步高升",
    "upgrades.nbricks.tooltip": "慢慢擊破磚磈時，獲得更多硬幣。",
    "upgrades.nbricks.verbose_description": "擊破磚磈時 +{{gain}} 連擊。球彈開漿板、牆壁後，如果擊中多於 {{max}} 個磚磈，連擊重設。小心炸彈。",
    "upgrades.one_more_choice.name": "額外選擇",
    "upgrades.one_more_choice.tooltip": "更多升級選擇",
    "upgrades.one_more_choice.verbose_description": "每個升級選單都會多一個選項。這並不會增加你可以選擇的升級數量。",
    "upgrades.ottawa_treaty.name": "渥太華條約",
    "upgrades.ottawa_treaty.tooltip": "擊破炸彈附近的磚塊可以拆除炸彈",
    "upgrades.ottawa_treaty.verbose_description": "附近的炸彈將會被替換為一個彩色磚塊。如果你有工兵，球將失去工兵效果，直至下次彈跳。一次只能替換一個炸彈。",
    "upgrades.paddle_up_combo.name": "",
    "upgrades.paddle_up_combo.tooltip": "",
    "upgrades.paddle_up_combo.verbose_description": "",
    "upgrades.palette.name": "多彩多姿",
    "upgrades.palette.tooltip": "連擊設為磚磈顏色數的一半。只剩一種顏色時，重設連擊。",
    "upgrades.palette.verbose_description": "要注意到，某些關卡僅有單色。",
    "upgrades.passive_income.name": "被動收入",
    "upgrades.passive_income.tooltip": "更多硬幣，但是移動的槳板接不住球或硬幣",
    "upgrades.passive_income.verbose_description": "+{{lvl}} 連擊 / 磚塊破碎，移動 {{time}}秒後，槳不再重要。某些技能可以幫助球按照你的意願行動，而無需你做任何事情。",
    "upgrades.picky_eater.name": "挑食者",
    "upgrades.picky_eater.tooltip": "如果你逐色擊破磚塊，將獲得更多硬幣",
    "upgrades.picky_eater.verbose_description": "每當你的球擊破一塊與其顏色相同的磚塊時，你的連擊數會增加螢幕上顏色的總數減一。\n如果擊破的是不同顏色的磚塊時，球會變成新的顏色，但連擊數會重置，除非之前所有與球的顏色相同的磚塊都已擊破。\n一旦你的連擊數超過最低值，顏色錯誤的磚塊就會出現紅色邊框。\n如果你有多個球，當其中一個球擊中磚塊時，所有球的顏色都會變更。",
    "upgrades.pierce.name": "穿刺",
    "upgrades.pierce.tooltip": "球在槳板彈起後最多穿刺 {{count}} 塊磚塊",
    "upgrades.pierce.verbose_description": "通常情況下，球一碰到東西就會彈起。有了此技能，它可以穿刺最多 3 塊磚塊而且保持原來的軌跡。\n\n之後，它會在碰到第四塊磚塊時彈起，你需要使它碰到槳板以重置計數器。",
    "upgrades.pierce_above_paddle.name": "",
    "upgrades.pierce_above_paddle.tooltip": "",
    "upgrades.pierce_above_paddle.verbose_description": "",
    "upgrades.pierce_color.name": "顏色穿刺",
    "upgrades.pierce_color.tooltip": "球穿過相同顏色的磚塊",
    "upgrades.pierce_color.verbose_description": "",
    "upgrades.pierce_left.name": "",
    "upgrades.pierce_left.tooltip": "",
    "upgrades.pierce_left.verbose_description": "",
