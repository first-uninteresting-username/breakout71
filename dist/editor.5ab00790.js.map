    "upgrades.helium.name": "Хелій",
    "upgrades.helium.tooltip": "Гравітність обмежена лівою і правою веслами",
    "upgrades.helium.verbose_description": "На рівні 1 зниження ваги. На рівні 2 монети повільно плавають. На рівні 3 вони дійсно літати.",
    "upgrades.hot_start.name": "Гарячий старт",
    "upgrades.hot_start.tooltip": "Більше монет, якщо ви зрозуміли рівень до 30-х років",
    "upgrades.hot_start.verbose_description": "На старті кожного рівня, ваш гребінець почнеться на +{{start}} пунктах, але потім кожен другий буде знизився {{loss}}. Ефект стеки з іншими перками.",
    "upgrades.implosions.name": "Запобігання",
    "upgrades.implosions.tooltip": "Вибухи смоктати монети замість удару їх",
    "upgrades.implosions.verbose_description": "Вибухова сила наноситься іншим чином. Подальші рівні діють як \"вибуховий вибух\"",
    "upgrades.instant_explosion.name": "",
    "upgrades.instant_explosion.tooltip": "",
    "upgrades.instant_explosion.verbose_description": "",
    "upgrades.left_is_lava.name": "Уникнути лівої сторони",
    "upgrades.left_is_lava.tooltip": "Більше монет, якщо ви не доторкаєтеся до лівої сторони",
    "upgrades.left_is_lava.verbose_description": "Коли ви розбиваєте цеглу, ваш гребінець збільшить один, тому ви отримаєте ще одну монету з усіх наступних цегли, які ви перервуєте.\n\nТим не менш, ваш комбо буде скидати, як тільки ваш м'яч потрапив у ліву сторону .\n\nЯк тільки ваш гребінець піднімається, ліва сторона стає червоним, щоб нагадати вам, що ви повинні уникати удару їх.\n\nНа рівні 2, кордон повністю вилучений і ваші яйця і монети можуть втратити.",
    "upgrades.limitless.name": "Без обмежень",
    "upgrades.limitless.tooltip": "Отримайте максимальний рівень оновлення за допомогою {{lvl}}",
    "upgrades.limitless.verbose_description": "Вибираючи цей норк також підняв свій ліміт одним, даючи вам підібрати його знову.",
    "upgrades.metamorphosis.name": "Метаморфоз",
    "upgrades.metamorphosis.tooltip": "Кожна монета може забарвити {{lvl}} цегла (s) з кольором",
    "upgrades.metamorphosis.verbose_description": "З цим перком монета буде кольору цегли вони надходять, і буде колір першої цегли вони торкнуться в той же колір. Монети спавна зі швидкістю кульки, яка зламала їх, що означає, що ви можете прицілитися трохи в напрямку цегли ви хочете \"фарбувати\". На рівні 1, кожна монета може забарвити 1 цегли перед тим, як вона «прозора» і з'являється порожня.",
    "upgrades.minefield.name": "Мінуси",
    "upgrades.minefield.tooltip": "+{{percent}}% монети на бомбу цегли на екрані",
    "upgrades.minefield.verbose_description": "Бомби підраховують, поки вони вибухнуть.",
    "upgrades.multiball.name": "М'яч",
    "upgrades.multiball.tooltip": "Почати кожен рівень з кульками {{count}}.",
    "upgrades.multiball.verbose_description": "Як тільки ви падаєте м'яч в Breakout 71, ви втратите.\n\nЗ цим перком ви отримуєте два кульки, і так ви можете дозволити собі втратити один.\n\nЗагублені кулі повертаються на наступний рівень.\n\nМаючи більше одного м'яча, що робить деякі додаткові прокси доступні, і, звичайно, очищає рівень швидше.",
    "upgrades.nbricks.name": "Розмір шлунку",
    "upgrades.nbricks.tooltip": "Більше монет, якщо ви потрапили цегли один за одним.",
    "upgrades.nbricks.verbose_description": "",
    "upgrades.one_more_choice.name": "Додатковий вибір",
    "upgrades.one_more_choice.tooltip": "Більше варіантів оновлення",
    "upgrades.one_more_choice.verbose_description": "Кожне меню оновлення буде мати ще один варіант. Не збільшує кількість оновлень, які можна підібрати.",
    "upgrades.ottawa_treaty.name": "Ottawa ласощі",
    "upgrades.ottawa_treaty.tooltip": "Прорив цегли біля бомби розбиває його",
    "upgrades.ottawa_treaty.verbose_description": "Півдня бомба буде замінена кольоровим блоком. Якщо у вас є саппер, м'яч буде руйнувати його саппер ефект до наступного бунтування. Тільки один бомб можна замінити на час.",
    "upgrades.paddle_up_combo.name": "",
    "upgrades.paddle_up_combo.tooltip": "",
    "upgrades.paddle_up_combo.verbose_description": "",
    "upgrades.palette.name": "",
    "upgrades.palette.tooltip": "",
    "upgrades.palette.verbose_description": "",
    "upgrades.passive_income.name": "Пасивний дохід",
    "upgrades.passive_income.tooltip": "Більше монет, але рухома веслка не ловить кулі або монети",
    "upgrades.passive_income.verbose_description": "+{{lvl}} combo / цегла зламаний, веслування is immaterial {{time}} після переміщення. Деякі перки можуть допомогти кулі зробити те, що ви хочете, не потрібно нічого робити.",
    "upgrades.picky_eater.name": "Пікі eater",
    "upgrades.picky_eater.tooltip": "Більше монет, якщо ви розбиваєте колір цегли за кольором",
    "upgrades.picky_eater.verbose_description": "Коли ви переламуєте цеглу таким же кольором, як ваш м'яч, ваш гребінець збільшує кількість кольорів на екрані мінус.\nЯкщо це інший колір, м'яч бере, що новий колір, але скидання комбо, якщо це не залишилося, залишених з м'якого кольору.\nПісля того, як ви отримуєте комбо вище, ніж ваш мінімум, цегла неправильного кольору отримає червоний кордон.\nЯкщо у вас є більше одного м'яча, всі вони переключають колір, коли один з них потрапив до цегли.",
    "upgrades.pierce.name": "Пірсинг",
    "upgrades.pierce.tooltip": "Кулькові пальці {{count}} цегли після свічок",
    "upgrades.pierce.verbose_description": "Кулька зазвичай відмовляється, як тільки вона доторкається щось. За допомогою цього перка вона продовжить її траєкторію до 3 цегли розірвав.\n\nПісля цього він відмовляється від 4-ї цегли, і вам буде потрібно доторкнутися до підкладки, щоб скинути лічильник.",
    "upgrades.pierce_above_paddle.name": "",
    "upgrades.pierce_above_paddle.tooltip": "",
    "upgrades.pierce_above_paddle.verbose_description": "",
    "upgrades.pierce_color.name": "Колір пірсінг",
    "upgrades.pierce_color.tooltip": "Кулька проходить через цеглу одного кольору",
    "upgrades.pierce_color.verbose_description": "",
    "upgrades.pierce_left.name": "",
    "upgrades.pierce_left.tooltip": "",
    "upgrades.pierce_left.verbose_description": "",
    "upgrades.pierce_right.name": "",
    "upgrades.pierce_right.tooltip": "",
    "upgrades.pierce_right.verbose_description": "",
    "upgrades.pierce_top.name": "",
    "upgrades.pierce_top.tooltip": "",
    "upgrades.pierce_top.verbose_description": "",
    "upgrades.puck_repulse_ball.name": "М'яка посадка",
    "upgrades.puck_repulse_ball.tooltip": "Свічка репутації кульок",
    "upgrades.puck_repulse_ball.verbose_description": "Коли м'яч закривається на весло, він почне сповільнювати, і навіть потенційно розкручується без дотику весл.",
    "upgrades.rainbow.name": "Жилети",
    "upgrades.rainbow.tooltip": "Монети спавна з тоновим кольором.",
    "upgrades.rainbow.verbose_description": "Кожен рівень збільшує частку кольорових монет. Колір залежить від часу рівня.",
    "upgrades.reach.name": "Згорнути",
    "upgrades.reach.tooltip": "Більше монет, якщо ви не зможете уникнути найнижчого ряду цегли",
    "upgrades.reach.verbose_description": "Сенсоруючи цегли Н найнижчого ряду скидає гребінець. Інакше, +N комбо.\n\nЯкщо є тільки один ряд цегли, або якщо найнижчий ряд цегли прикривають всю ширину гри, то цей вик нічого не робить. В іншому випадку, розбиття цього найнижчого ряду скидає гребінець, в той час як розбиття нічого іншого збільшує гребінець за кількістю цегли, присутніх на цьому найнижчому ряду.\n\nНайнижчий ряд буде виділятися в червоний колір.",
    "upgrades.refill.name": "",
    "upgrades.refill.tooltip": "",
    "upgrades.refill.verbose_description": "",
    "upgrades.respawn.name": "Ре-спагін",
    "upgrades.respawn.tooltip": "{{percent}}% з цегли ре-спагін після {{delay}}.",
    "upgrades.respawn.verbose_description": "Деякі ефект частинок дозволить вам дізнатися, де з'явиться цегла.",
    "upgrades.right_is_lava.name": "Уникнути правої сторони",
    "upgrades.right_is_lava.tooltip": "Більше монет, якщо ви не торкаєтеся правої сторони",
    "upgrades.right_is_lava.verbose_description": "Коли ви розбиваєте цеглу, ваш гребінець збільшить один, тому ви отримаєте ще одну монету з усіх наступних цегли, які ви перервуєте.\n\nТим не менш, ваш комбо буде скидати, як тільки ваш м'яч потрапив на праву сторону.\n\nЯк тільки ваш гребінець піднімається, права сторона стає червоним, щоб нагадати вам, що ви повинні уникати удару їх.\n\nНа рівні 2, кордон повністю вилучений і ваші яйця і монети можуть втратити.",
    "upgrades.round_bricks.name": "",
    "upgrades.round_bricks.tooltip": "",
    "upgrades.round_bricks.verbose_description": "",
    "upgrades.sacrifice.name": "Сакрий",
    "upgrades.sacrifice.tooltip": "",
    "upgrades.sacrifice.verbose_description": "",
    "upgrades.sapper.name": "Саппер",
    "upgrades.sapper.tooltip": "Перша цегла зламана стає бомбою.",
    "upgrades.sapper.verbose_description": "Замість того, як тільки зникне, перша цегла замінить бомбою цегли. Бінг м'яч на весло повторює ефект. Вирівнювання цього чорнила дозволить вам розмістити більше бомб.",
    "upgrades.shocks.name": "Штани",
    "upgrades.shocks.tooltip": "Вибухові кулі зіткнення",
    "upgrades.shocks.verbose_description": "У той час як два кульки колоїда, вони обмінюють свою швидкість, припускають вибух, і набирають додаткову швидкість, щоб відокремити їх.",
    "upgrades.shunt.name": "Штан",
    "upgrades.shunt.tooltip": "Зберігати {{percent}}% від ваших combo між рівнями",
    "upgrades.shunt.verbose_description": "Якщо у вас також є гарячий старт, гарячий старт просто додається до поточного гребінець",
    "upgrades.side_flip.name": "Праворуч",
    "upgrades.side_flip.tooltip": "",
    "upgrades.side_flip.verbose_description": "",
    "upgrades.side_kick.name": "Ліворуч",
    "upgrades.side_kick.tooltip": "",
    "upgrades.side_kick.verbose_description": "",
    "upgrades.skip_last.name": "Легкий очищувач",
    "upgrades.skip_last.tooltip": "Остання цегла самовідношення",
    "upgrades.skip_last.verbose_description": "Вам необхідно розбити всі цегли, щоб перейти на наступний рівень. Тим не менш, важко отримати останні.\nКожен рівень даної фарби збільшує кількість цегли, які будуть самовідношення.\nОчистити рівень рано приносить додаткові вибір при модернізації. Не пропустіть цегли і дуже вигідно.\n\nТак, якщо ви виявите, що важко розбити останню цеглу, отримувати цегли на кілька разів.",
    "upgrades.slow_down.name": "Повільний м'яч",
    "upgrades.slow_down.tooltip": "Бал рухається повільніше",
    "upgrades.slow_down.verbose_description": "М'яч починає порівняно повільніше, але кожен рівень вашої гри він почне трохи швидше.\n\nТакож прискорить, якщо ви витрачаєте багато часу на одному рівні.\n\nЦей перк робить його більш керованим.\n\nВи можете отримати його на початку кожного разу, щоб забезпечити режим дитини в меню.",
    "upgrades.smaller_puck.name": "Маленька весло",
    "upgrades.smaller_puck.tooltip": "{{percent}} більше монет",
    "upgrades.smaller_puck.verbose_description": "Це робить свічку меншим, що в теорії робить деякі кутові постріли простіше, але дійсно просто підвищує труднощі.\n\nОсь чому ви також отримаєте хороший бонус +50% монет спавна.",
    "upgrades.soft_brush.name": "",
    "upgrades.soft_brush.tooltip": "",
    "upgrades.soft_brush.verbose_description": "",
    "upgrades.soft_reset.name": "М'який скидання",
    "upgrades.soft_reset.tooltip": "Зберігати {{percent}}% від вашого combo, коли він скидає",
    "upgrades.soft_reset.verbose_description": "Обмеження впливу гребеневого скидання.",
    "upgrades.soft_touch.name": "",
    "upgrades.soft_touch.tooltip": "",
    "upgrades.soft_touch.verbose_description": "",
    "upgrades.steering.name": "Ремкомплект",
    "upgrades.steering.tooltip": "Яйця перетворюються, коли весло рухається",
    "upgrades.steering.verbose_description": "Зміна розташування підкладки безпосередньо впливає на напрямок руху кульок. На рівні 2+ ви отримуєте рядок, що показує вам напрямки кульок.",
    "upgrades.sticky_coins.name": "Стікі монети",
    "upgrades.sticky_coins.tooltip": "Монети приклеюють до цегли одного кольору",
    "upgrades.sticky_coins.verbose_description": "На рівні 2 вони приклеюють до цегли будь-якого кольору",
    "upgrades.streak_shots.name": "Хіт стейк",
    "upgrades.streak_shots.tooltip": "Більше монет, якщо ви поламали багато цегли одночасно",
    "upgrades.streak_shots.verbose_description": "Кожного разу ви розбиваєте цеглу, ваш гребінець збільшується на одному.\n\nОднак, як тільки м'яч доторкнеться до вашої підкладки, комбо скидається до його значення за замовчуванням.\n\nПісля того, як ваш гребінець піднімається над базовим значенням, ваш весл буде мати червоний кордон, щоб нагадати вам, що він знищить ваш гребінець, щоб доторкнути його м'ячем.",
    "upgrades.sturdy_bricks.name": "Студії цегли",
    "upgrades.sturdy_bricks.tooltip": "+{{lvl}} цегли HP, +{{percent}}% монети",
    "upgrades.sturdy_bricks.verbose_description": "Кожен рівень цього чорнила додає один HP на всі цегли. Ви можете побачити номер HP з перекидом «кларовою». Ви можете збільшити пошкодження м'яча шляхом отримання \"пронизу\" перка. Кожен рівень перка додає +50% монети спавн.",
    "upgrades.superhot.name": "СУПЕР ХОТ",
    "upgrades.superhot.tooltip": "Час пересувається при подушці рухається.",
    "upgrades.superhot.verbose_description": "SUPER HOT SUPER HOT SUPER HOT СУПЕР HOT",
    "upgrades.telekinesis.name": "Телекінез",
    "upgrades.telekinesis.tooltip": "Позиція весла впливає на м'яч",
    "upgrades.telekinesis.verbose_description": "Ви контролюєте м'яч, поки він буде. Ефект сильніше, коли м'яч знаходиться в нижній половині екрана.",
    "upgrades.thomas.name": "",
    "upgrades.thomas.tooltip": "",
    "upgrades.thomas.verbose_description": "",
    "upgrades.three_cushion.name": "Три подушки",
    "upgrades.three_cushion.tooltip": "Більше монет, якщо ви потрапили цегли тільки непрямо",
    "upgrades.three_cushion.verbose_description": "",
    "upgrades.top_is_lava.name": "Sky є лімітом",
    "upgrades.top_is_lava.tooltip": "Більше монет, якщо ви не вдарили вершину",
    "upgrades.top_is_lava.verbose_description": "Коли ви розбиваєте цеглу, ваш гребінець збільшиться на одному. Тим не менш, ваш комбо буде скидати, як тільки ваш м'яч потрапив до вершини екрана.\n\nЯкщо ваш комбо над мінімальним, то вгорі з'явиться червоний бар, щоб нагадувати вам, що ви повинні уникати удару.\n\nНа рівні 2, кордон повністю вилучений і ваші яйця і монети можуть втратити.",
    "upgrades.trampoline.name": "Трамполін",
    "upgrades.trampoline.tooltip": "Більше монет, якщо ви відмовтеся від цегли і весло тільки",
    "upgrades.trampoline.verbose_description": "+{{lvl}} combo за веслами bounce,-{{lvl}} combo на відмову від будь-якого кордону. Один з рідкісних комбо оновлень, які не додають умову скидання",
    "upgrades.transparency.name": "Прозорість",
    "upgrades.transparency.tooltip": "+50% монети. М'яч невидимий у верхній частині екрана.",
    "upgrades.transparency.verbose_description": "Бал стає прозорим у верхній частині екрана.\n+{{percent}} % монети.\nВищі рівні роблять м'яч прозорим рано і підвищують рівень бонусу.",
    "upgrades.trickledown.name": "Нарізка вниз",
    "upgrades.trickledown.tooltip": "Монети з'являються у верхній частині екрана.",
    "upgrades.trickledown.verbose_description": "Монети можуть сидіти на верхній частині цегли, якщо є цегли на верхньому ряду, в цьому випадку вони знизяться після того, як ви розбиваєте цеглу.",
    "upgrades.unbounded.name": "Панчохи",
    "upgrades.unbounded.tooltip": "Додає простір зліва і праворуч від рівня, але ви не можете йти до цього.",
    "upgrades.unbounded.verbose_description": "Ще одне оновлення може допомогти вам розширити доступ до вашого свічника.",
    "upgrades.varied_diet.name": "",
    "upgrades.varied_diet.tooltip": "",
    "upgrades.varied_diet.verbose_description": "",
    "upgrades.vibrant_neighborhood.name": "",
    "upgrades.vibrant_neighborhood.tooltip": "",
    "upgrades.vibrant_neighborhood.verbose_description": "",
    "upgrades.viscosity.name": "Віскости",
    "upgrades.viscosity.tooltip": "Повільна монета падіння",
    "upgrades.viscosity.verbose_description": "Монети зазвичай прискорюються з тяжінням і вибухами для досить високих швидкостей.\n\nЦей перк постійно уповільнює їх, якби вони були в деяких сортах в'язкої рідини.\n\nЦе робить ловити їх простіше, і поєднує в собі приємні удари, які впливають на рух монети.",
    "upgrades.wind.name": "Вітер",
    "upgrades.wind.tooltip": "Позиція сідла створює вітр",
    "upgrades.wind.verbose_description": "Вітер залежить від положення весла: зліва удари, праві удари прямо. Вражає як кулі, так і монети.",
    "upgrades.wrap_left.name": "Обгортання зліва",
    "upgrades.wrap_left.tooltip": "Вдаривши ліву сторону телепорти м'яч на праву сторону",
    "upgrades.wrap_left.verbose_description": "Довгий рівень телепортних монет теж.",
    "upgrades.wrap_right.name": "Обгортання правою",
    "upgrades.wrap_right.tooltip": "Вдаривши праву сторону телепортів м'яч на ліву сторону",
    "upgrades.wrap_right.verbose_description": "Довгий рівень телепортних монет теж.",
    "upgrades.wrap_up.name": "Загорнути",
    "upgrades.wrap_up.tooltip": "Сенсорний верхній частині екрана буде транслювати м'яч просто над веслом.",
    "upgrades.wrap_up.verbose_description": "Це не буде розраховувати як вісь. На рівні 2, монетний телепорт теж.",
    "upgrades.yoyo.name": "Йо-йо",
    "upgrades.yoyo.tooltip": "М'яч падає на весло",
    "upgrades.yoyo.verbose_description": "Це протилежність телекінезу, контроль м'яча, в той час як вона падає вниз.",
    "upgrades.zen.name": "З",
    "upgrades.zen.tooltip": "Більше монет, якщо ви не запускати бомби",
    "upgrades.zen.verbose_description": "+{{lvl}} combo кожен 3s, скидання коли є вибух"
}
